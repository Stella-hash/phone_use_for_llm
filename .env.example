# No keys, serials or private paths belong in Git. Copy to .env locally.
PHONE_DEVICE=REPLACE_WITH_DEDICATED_USB_SERIAL
PHONE_PORT=17761
PHONE_SECURITY_FILE=REPLACE_WITH_ABSOLUTE_PATH_TO_SECURITY_JSON
# No PHONE_AUTO_WAKE setting: automatic wake and keyguard dismissal are disabled.
# Optional summaries additionally require allowModelSummary=true in security.json.
# PHONE_SUMMARY_KEY_FILE=REPLACE_WITH_PRIVATE_KEY_FILE
# PHONE_SUMMARY_MODEL=REPLACE_WITH_SUPPORTED_MODEL
# Short clips are disabled by default; configure shortClips in security.json.
# Linux capture needs owner-installed scrcpy, python3, ffmpeg and ffprobe.
# Optional host decoder paths (not tool arguments):
# PHONE_FFMPEG=REPLACE_WITH_ABSOLUTE_FFMPEG_PATH
# PHONE_FFPROBE=REPLACE_WITH_ABSOLUTE_FFPROBE_PATH
