--- /dev/null
+++ b/Tests/iPhoneUseTests/Bluetooth/HIDHostSelectionTests.swift
@@ -0,0 +1,51 @@
+import XCTest
+
+@testable import iPhoneUse
+
+final class HIDHostSelectionTests: XCTestCase {
+    func testUnsetAllowsAllButEmptyOrMalformedConfigurationDeniesAll() {
+        let host = UUID()
+        XCTAssertTrue(HIDHostSelection(environmentValue: nil).allows(host))
+        XCTAssertFalse(HIDHostSelection(environmentValue: "").allows(host))
+        XCTAssertFalse(HIDHostSelection(environmentValue: "not-a-uuid").allows(host))
+        XCTAssertTrue(HIDHostSelection(environmentValue: host.uuidString.lowercased()).allows(host))
+    }
+
+    func testSelectedHostRejectsOtherHostInputEvenNeutralRelease() throws {
+        let selected = UUID()
+        let other = UUID()
+        var state = HIDConnectionState(hostSelection: .only(selected))
+        for host in [selected, other] {
+            state.subscribe(.report(.absolutePointer), host: host)
+            state.subscribe(.report(.relativeMouse), host: host)
+            state.enqueue(
+                .report(.absolutePointer), data: Data([0, 1, 0, 1, 0]),
+                host: host, session: state.sessions[host])
+            state.enqueue(
+                .report(.relativeMouse), data: Data([0, 0, 0, 0]),
+                host: host, session: state.sessions[host], isAllowed: { false })
+        }
+        XCTAssertTrue(state.isReady(report: .absolutePointer, host: selected, session: state.sessions[selected]))
+        XCTAssertFalse(state.isReady(report: .absolutePointer, host: other, session: state.sessions[other]))
+        XCTAssertEqual(state.pending.count, 2)
+        XCTAssertTrue(state.pending.allSatisfy { $0.host == selected })
+    }
+
+    func testNotificationBoundaryDropsQueuedReportsForExcludedHost() throws {
+        let selected = UUID()
+        let other = UUID()
+        var state = HIDConnectionState()
+        for host in [other, selected] {
+            state.subscribe(.report(.relativeMouse), host: host)
+            state.enqueue(
+                .report(.relativeMouse), data: Data([0, 0, 0, 0]),
+                host: host, session: state.sessions[host])
+        }
+        state.hostSelection = .only(selected)
+        XCTAssertEqual(state.nextPendingReport()?.host, selected)
+        XCTAssertEqual(state.pending.map(\.host), [selected])
+        state.hostSelection = .invalid
+        XCTAssertNil(state.nextPendingReport())
+        XCTAssertTrue(state.pending.isEmpty)
+    }
+}
