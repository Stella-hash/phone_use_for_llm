+import XCTest
+
+@testable import iPhoneUse
+
+/// Models the observed device behavior: relative movement changes the pointer,
+/// but repeating its last absolute report does not reassert that position.
+/// Reports pass through the production pending queue so a reset cannot rely on
+/// two absolute notifications surviving backpressure merely because both were sent.
+private final class AbsoluteResetHost {
+    struct Point: Equatable {
+        var x: Int
+        var y: Int
+    }
+
+    let host = UUID()
+    var connection = HIDConnectionState()
+    var congested = false
+    var allowed = true
+    var offered: [(ReportID, [UInt8])] = []
+    var delivered: [(ReportID, [UInt8])] = []
+    var point = Point(x: 0, y: 0)
+    var presses: [Point] = []
+    private var lastAbsolute: Point?
+    private var buttons: UInt8 = 0
+
+    init() {
+        connection.subscribe(.report(.absolutePointer), host: host)
+        connection.subscribe(.report(.relativeMouse), host: host)
+    }
+
+    var session: UUID { connection.sessions[host]! }
+
+    func send(_ id: ReportID, _ bytes: [UInt8]) {
+        offered.append((id, bytes))
+        connection.enqueue(
+            .report(id), data: Data(bytes), host: host, session: session,
+            isAllowed: { [unowned self] in allowed })
+        if !congested { drain() }
+    }
+
+    func drain() {
+        while let (index, report) = connection.nextPendingReportIndex() {
+            connection.removePending(at: index)
+            guard case .report(let id) = report.channel else { continue }
+            let bytes = [UInt8](report.data)
+            delivered.append((id, bytes))
+            switch id {
+            case .absolutePointer:
+                let target = Self.decode(bytes)
+                if target != lastAbsolute { point = target }
+                lastAbsolute = target
+            case .relativeMouse:
+                // The exact gain is irrelevant to the duplicate-report predicate.
+                point.x = min(32767, max(0, point.x + Int(Int8(bitPattern: bytes[1])) * 16))
+                point.y = min(32767, max(0, point.y + Int(Int8(bitPattern: bytes[2])) * 16))
+                if buttons == 0, bytes[0] != 0 { presses.append(point) }
+                buttons = bytes[0]
+            default:
+                break
+            }
+        }
+    }
+
+    static func decode(_ bytes: [UInt8]) -> Point {
+        Point(x: Int(bytes[1]) | Int(bytes[2]) << 8, y: Int(bytes[3]) | Int(bytes[4]) << 8)
+    }
+
+    static func target(_ x: Double, _ y: Double) -> Point {
+        Point(x: Int((x * 32767).rounded()), y: Int((y * 32767).rounded()))
+    }
+
+    func input(sleep: @escaping (TimeInterval) -> Void = { _ in }) -> DeviceInput {
+        DeviceInput(
+            host: host, session: session, screenSize: { CGSize(width: 1179, height: 2556) },
+            inputIsAllowed: { [unowned self] in allowed }, sleep: sleep,
+            reportSender: { [unowned self] in send($0, $1) })
+    }
+}
+
+final class DeviceInputAbsoluteResetTests: XCTestCase {
+    func testRepeatedAbsoluteTargetAfterNudgeRestoresObservedPosition() throws {
+        let phone = AbsoluteResetHost()
+        let input = phone.input()
+        let target = AbsoluteResetHost.target(0.4, 0.3)
+        try input.move(x: 0.4, y: 0.3)
+        try input.nudge(dx: 0, dy: 16, click: false)
+        XCTAssertNotEqual(phone.point, target)
+
+        try input.move(x: 0.4, y: 0.3)
+
+        XCTAssertEqual(phone.point, target)
+        XCTAssertTrue(phone.presses.isEmpty)
+        XCTAssertEqual(phone.delivered.last?.0, .absolutePointer)
+        XCTAssertEqual(phone.delivered.last.map { AbsoluteResetHost.decode($0.1) }, target)
+    }
+
+    func testResetSurvivesTransportBackpressureBeforeCoordinateTap() throws {
+        let phone = AbsoluteResetHost()
+        let input = phone.input()
+        let target = AbsoluteResetHost.target(0.4, 0.3)
+        try input.move(x: 0.4, y: 0.3)
+        try input.nudge(dx: 12, dy: 16, click: false)
+        phone.congested = true
+
+        try input.tap(x: 0.4, y: 0.3)
+        phone.drain()
+
+        XCTAssertEqual(phone.point, target)
+        XCTAssertEqual(phone.presses, [target])
+        let absolute = phone.delivered.filter { $0.0 == .absolutePointer }
+        XCTAssertEqual(absolute.count, 3, "the reset neighbor must survive the production queue's coalescing")
+        XCTAssertTrue(absolute.allSatisfy { $0.1[0] == 0 })
+    }
+
+    func testRepeatedSwipeOriginReanchorsBeforeSecondPress() throws {
+        let phone = AbsoluteResetHost()
+        let input = phone.input()
+        let origin = AbsoluteResetHost.target(0.3, 0.3)
+
+        try input.swipe(points: [(0.3, 0.3), (0.7, 0.6)], duration: 0.06)
+        XCTAssertNotEqual(phone.point, origin)
+        try input.swipe(points: [(0.3, 0.3), (0.7, 0.6)], duration: 0.06)
+
+        XCTAssertEqual(phone.presses, [origin, origin])
+    }
+
+    func testWindowDragThenTapOriginalPositionUsesLastAbsoluteReportNotDragEstimate() throws {
+        let phone = AbsoluteResetHost()
+        let input = phone.input()
+        let origin = AbsoluteResetHost.target(0.3, 0.3)
+
+        input.press(x: 0.3, y: 0.3)
+        input.release(x: 0.7, y: 0.6)
+        try input.nudge(dx: 0, dy: 0, click: false)
+        XCTAssertNotEqual(phone.point, origin)
+        try input.tap(x: 0.3, y: 0.3)
+
+        XCTAssertEqual(phone.presses, [origin, origin])
+    }
+
+    func testResetNeighborsStayInBoundsAndChangeBothAxesAtScreenEdges() throws {
+        for (x, y, dx, dy) in [(0.0, 0.0, 16, 16), (1.0, 1.0, -16, -16)] {
+            let phone = AbsoluteResetHost()
+            let input = phone.input()
+            let target = AbsoluteResetHost.target(x, y)
+            try input.move(x: x, y: y)
+            try input.nudge(dx: dx, dy: dy, click: false)
+            try input.move(x: x, y: y)
+
+            let absolute = phone.delivered.filter { $0.0 == .absolutePointer }
+            XCTAssertEqual(absolute.count, 3)
+            guard absolute.count == 3 else { continue }
+            let neighbor = AbsoluteResetHost.decode(absolute[1].1)
+            XCTAssertNotEqual(neighbor.x, target.x)
+            XCTAssertNotEqual(neighbor.y, target.y)
+            XCTAssertTrue((0...32767).contains(neighbor.x) && (0...32767).contains(neighbor.y))
+            XCTAssertGreaterThanOrEqual(Double(abs(neighbor.x - target.x)) / 32767 * 1179, 1)
+            XCTAssertGreaterThanOrEqual(Double(abs(neighbor.y - target.y)) / 32767 * 2556, 1)
+            XCTAssertLessThanOrEqual(Double(abs(neighbor.x - target.x)) / 32767 * 1179, 3)
+            XCTAssertLessThanOrEqual(Double(abs(neighbor.y - target.y)) / 32767 * 2556, 3)
+            XCTAssertEqual(phone.point, target)
+            XCTAssertTrue(phone.presses.isEmpty)
+        }
+    }
+
+    func testOrdinaryDuplicateAndChangedAbsoluteTargetsDoNotAddResetReports() throws {
+        let phone = AbsoluteResetHost()
+        let input = phone.input()
+        try input.move(x: 0.4, y: 0.3)
+        try input.move(x: 0.4, y: 0.3)
+        try input.nudge(dx: 0, dy: 16, click: false)
+        try input.move(x: 0.6, y: 0.7)
+
+        XCTAssertEqual(phone.delivered.filter { $0.0 == .absolutePointer }.count, 3)
+        XCTAssertEqual(phone.point, AbsoluteResetHost.target(0.6, 0.7))
+    }
+
+    func testCaptureInvalidationDuringResetSuppressesFinalTargetAndPress() throws {
+        let phone = AbsoluteResetHost()
+        var invalidateOnReset = false
+        let input = phone.input { _ in
+            if invalidateOnReset,
+                phone.offered.filter({ $0.0 == .absolutePointer }).count == 2
+            {
+                phone.allowed = false
+            }
+        }
+        try input.move(x: 0.4, y: 0.3)
+        try input.nudge(dx: 0, dy: 16, click: false)
+        invalidateOnReset = true
+
+        try input.tap(x: 0.4, y: 0.3)
+
+        XCTAssertEqual(phone.offered.filter { $0.0 == .absolutePointer }.count, 2)
+        XCTAssertTrue(phone.presses.isEmpty)
+        XCTAssertTrue(phone.offered.suffix(2).allSatisfy { $0.0 == .relativeMouse && $0.1 == [0, 0, 0, 0] })
+        invalidateOnReset = false
+        phone.allowed = true
+        try input.move(x: 0.4, y: 0.3)
+        XCTAssertEqual(phone.point, AbsoluteResetHost.target(0.4, 0.3))
+    }
+
+    func testHoverCancellationDuringResetDoesNotSendStaleFinalTarget() throws {
+        let phone = AbsoluteResetHost()
+        var cancelOnReset = false
+        var input: DeviceInput!
+        input = phone.input { _ in
+            if cancelOnReset,
+                phone.offered.filter({ $0.0 == .absolutePointer }).count == 2
+            {
+                cancelOnReset = false
+                input.cancelPointer()
+            }
+        }
+        try input.move(x: 0.4, y: 0.3)
+        try input.nudge(dx: 0, dy: 16, click: false)
+        cancelOnReset = true
+
+        input.positionPointer(x: 0.4, y: 0.3)
+        // The first barrier waits for the hover; the second also waits for the
+        // cancellation it scheduled while the hover was in progress.
+        try input.type("")
+        try input.type("")
+
+        XCTAssertEqual(phone.offered.filter { $0.0 == .absolutePointer }.count, 2)
+        XCTAssertNotEqual(phone.point, AbsoluteResetHost.target(0.4, 0.3))
+        XCTAssertTrue(phone.presses.isEmpty)
+        try input.move(x: 0.6, y: 0.7)
+        XCTAssertEqual(phone.point, AbsoluteResetHost.target(0.6, 0.7))
+    }
+
+    func testResetNeverReleasesAnActiveWindowPress() throws {
+        let phone = AbsoluteResetHost()
+        let input = phone.input()
+        input.press(x: 0.3, y: 0.3)
+        try input.type("")
+        input.drag(x: 0.6, y: 0.7)
+        try input.type("")
+        let before = phone.delivered.count
+
+        input.positionPointer(x: 0.3, y: 0.3)
+        try input.type("")
+
+        let additional = phone.delivered.dropFirst(before)
+        XCTAssertEqual(additional.count, 1)
+        XCTAssertTrue(additional.allSatisfy { $0.0 == .absolutePointer && $0.1[0] == 1 })
+        XCTAssertEqual(phone.presses.count, 1)
+        input.cancelPointer()
+        try input.type("")
+    }
+}
