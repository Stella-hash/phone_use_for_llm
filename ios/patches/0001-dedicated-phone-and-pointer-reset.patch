+import XCTest
+
+@testable import iPhoneUse
+
+final class MCPDeviceSelectionTests: XCTestCase {
+    private let devices = Data(
+        #"{"devices":[{"id":"spare-15","name":"Spare"},{"id":"daily-air","name":"Daily"}]}"#.utf8)
+
+    func testConfiguredDeviceIsExactAndOverridesAutomaticSingleDeviceChoice() throws {
+        XCTAssertEqual(try MCPServer.resolveDevice(nil, data: devices, configuredDevice: "spare-15"), "spare-15")
+        XCTAssertEqual(
+            try MCPServer.resolveDevice("SPARE-15", data: devices, configuredDevice: "spare-15"), "spare-15")
+        XCTAssertThrowsError(try MCPServer.resolveDevice("daily-air", data: devices, configuredDevice: "spare-15"))
+        XCTAssertThrowsError(try MCPServer.resolveDevice("spare", data: devices, configuredDevice: "spare-15"))
+        XCTAssertThrowsError(try MCPServer.resolveDevice(nil, data: devices, configuredDevice: ""))
+        let onlyDaily = Data(#"{"devices":[{"id":"daily-air","name":"Daily"}]}"#.utf8)
+        XCTAssertThrowsError(try MCPServer.resolveDevice(nil, data: onlyDaily, configuredDevice: "spare-15"))
+    }
+
+    func testUnconfiguredUpstreamResolutionStillAllowsNamesAndPrefixes() throws {
+        XCTAssertEqual(try MCPServer.resolveDevice("Spare", data: devices, configuredDevice: nil), "spare-15")
+        XCTAssertEqual(try MCPServer.resolveDevice("daily-", data: devices, configuredDevice: nil), "daily-air")
+        XCTAssertThrowsError(try MCPServer.resolveDevice(nil, data: devices, configuredDevice: nil))
+    }
+}
