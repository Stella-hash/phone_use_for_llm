diff --git a/Sources/iPhoneUse/Bluetooth/HIDHostSelection.swift b/Sources/iPhoneUse/Bluetooth/HIDHostSelection.swift
new file mode 100644
index 0000000..e7c100e
--- /dev/null
+++ b/Sources/iPhoneUse/Bluetooth/HIDHostSelection.swift
@@ -0,0 +1,37 @@
+import Foundation
+
+/// Optional process-wide routing for a dedicated phone. A malformed configured
+/// value denies input instead of silently reverting to all connected hosts.
+enum HIDHostSelection: Equatable {
+    case all
+    case only(UUID)
+    case invalid
+
+    init(environmentValue: String?) {
+        guard let environmentValue else {
+            self = .all
+            return
+        }
+        if let host = UUID(uuidString: environmentValue) {
+            self = .only(host)
+        } else {
+            self = .invalid
+        }
+    }
+
+    func allows(_ host: UUID) -> Bool {
+        switch self {
+        case .all: return true
+        case .only(let selected): return host == selected
+        case .invalid: return false
+        }
+    }
+
+    var description: String {
+        switch self {
+        case .all: return "all hosts"
+        case .only(let host): return host.uuidString
+        case .invalid: return "invalid IPHONE_USE_BLUETOOTH_HOST; input disabled"
+        }
+    }
+}
diff --git a/Tests/iPhoneUseTests/Bluetooth/HIDHostSelectionTests.swift b/Tests/iPhoneUseTests/Bluetooth/HIDHostSelectionTests.swift
