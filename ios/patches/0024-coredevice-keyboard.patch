diff --git a/Sources/iPhoneUse/Input/CoreDeviceKeyboard.swift b/Sources/iPhoneUse/Input/CoreDeviceKeyboard.swift
new file mode 100644
index 0000000..3cb9577
--- /dev/null
+++ b/Sources/iPhoneUse/Input/CoreDeviceKeyboard.swift
@@ -0,0 +1,262 @@
+import Darwin
+import Foundation
+
+/// US-layout strokes share KeyboardMap with BLE. This is one finite program,
+/// not a persistent keyboard session or a second public input language.
+struct CoreDeviceKeyboardProgram {
+    private(set) var samples: [[String: Any]] = []
+    private var nextMS = 0
+
+    private mutating func append(_ usages: [Int]) throws {
+        guard samples.count < 128, nextMS <= 6000 else {
+            throw InputRequestError("USB keyboard program exceeds 128 reports or 6 seconds; use clipboard for longer text")
+        }
+        samples.append(["at_ms": nextMS, "usages": usages])
+    }
+
+    private mutating func stroke(_ stroke: KeyboardMap.Stroke) throws {
+        let modifiers = (0..<8).filter { stroke.modifiers & (1 << $0) != 0 }.map { 224 + $0 }
+        if !modifiers.isEmpty { try append(modifiers); nextMS += 100 }
+        try append(modifiers + [Int(stroke.code)]); nextMS += 120
+        try append(modifiers)
+        if !modifiers.isEmpty { nextMS += 100; try append([]) }
+        nextMS += 80
+    }
+
+    private mutating func key(_ name: String, _ modifiers: [String]) throws {
+        guard let code = KeyboardMap.code(for: name), let mask = KeyboardMap.modifierMask(for: modifiers) else {
+            throw InputRequestError("Unknown or invalid keyboard stroke")
+        }
+        try stroke(KeyboardMap.Stroke(code: code, modifiers: mask))
+    }
+
+    static func key(_ request: KeyRequest) throws -> Self {
+        var program = Self()
+        try program.key(request.key, request.modifiers)
+        return program
+    }
+
+    static func text(_ request: TypeTextRequest, switchIME: Bool) throws -> Self {
+        var program = Self()
+        if switchIME {
+            try program.key("space", ["control"])
+            program.nextMS += 250
+        }
+        for action in request.actions {
+            switch action {
+            case .key(let key, let modifiers): try program.key(key, modifiers)
+            case .clipboard: try program.key("v", ["command"])
+            case .text(let text, _):
+                guard let converted = KeyboardMap.keyboardText(for: text) else {
+                    throw InputRequestError("Text cannot be represented by the configured keyboard layout")
+                }
+                for character in converted {
+                    guard let stroke = KeyboardMap.stroke(for: character) else {
+                        throw InputRequestError("Text cannot be represented by the configured keyboard layout")
+                    }
+                    try program.stroke(stroke)
+                }
+            }
+        }
+        return program
+    }
+}
+
+/// One owned child, exact configured USB target, and a one-use host commit.
+/// The caller holds DeviceCommandLocks. No media, BLE fallback or action replay.
+enum CoreDeviceKeyboard {
+    static let helperKey = "IPHONE_USE_KEYBOARD_HELPER"
+    static var isConfigured: Bool { ProcessInfo.processInfo.environment[helperKey] != nil }
+
+    static func perform(
+        _ program: CoreDeviceKeyboardProgram, device: String,
+        environment: [String: String] = ProcessInfo.processInfo.environment,
+        beforeCommit: () throws -> Void = {},
+        clipboard: (() throws -> Void)? = nil
+    ) throws -> [String: Any] {
+        guard environment["IPHONE_USE_DEVICE_ID"] == device,
+            let helper = environment[helperKey], helper.hasPrefix("/"), !helper.contains("\0"),
+            FileManager.default.isReadableFile(atPath: helper) else {
+            throw InputRequestError("USB keyboard requires its configured helper and exact capture device")
+        }
+        let configuration = try DeviceClipboard.Configuration(environment: environment)
+        guard FileManager.default.isExecutableFile(atPath: configuration.python.path) else {
+            throw InputRequestError("USB keyboard Python is unavailable")
+        }
+        var committed = false
+        var clipboardStatus = clipboard == nil ? "not_requested" : "not_written"
+        func receipt(_ status: String, reason: String? = nil) -> [String: Any] {
+            var result: [String: Any] = [
+                "schema_version": 1, "backend": "coredevice-keyboard", "input_status": status,
+                "device_bound": true, "frame_bound": false, "device_delivery": "unverified",
+                "application_effect": "unverified", "clipboard_status": clipboardStatus,
+            ]
+            if let reason { result["reason"] = reason }
+            return result
+        }
+        if program.samples.isEmpty {
+            var result = receipt("not_sent")
+            result["no_op"] = true
+            return result
+        }
+        let data = try JSONSerialization.data(withJSONObject: ["samples": program.samples])
+        guard data.count <= 16384 else { throw InputRequestError("USB keyboard plan exceeds 16 KiB") }
+        let directory = FileManager.default.temporaryDirectory.appendingPathComponent("iphone-use-keyboard-\(UUID().uuidString)")
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: false, attributes: [.posixPermissions: 0o700])
+        defer { try? FileManager.default.removeItem(at: directory) }
+        let inputURL = directory.appendingPathComponent("plan.json")
+        let outputURL = directory.appendingPathComponent("receipt.jsonl")
+        let commitURL = directory.appendingPathComponent("commit.json")
+        guard FileManager.default.createFile(atPath: inputURL.path, contents: data, attributes: [.posixPermissions: 0o600]),
+            FileManager.default.createFile(atPath: outputURL.path, contents: nil, attributes: [.posixPermissions: 0o600]) else {
+            throw InputRequestError("Cannot prepare USB keyboard helper files")
+        }
+        let input = try FileHandle(forReadingFrom: inputURL), output = try FileHandle(forWritingTo: outputURL)
+        defer { try? input.close(); try? output.close() }
+        let process = Process(), finished = DispatchSemaphore(value: 0)
+        process.executableURL = configuration.python
+        process.arguments = ["-B", helper, "--commit-file", commitURL.path]
+        process.environment = configuration.childEnvironment(environment)
+        process.standardInput = input; process.standardOutput = output; process.standardError = FileHandle.nullDevice
+        process.terminationHandler = { _ in finished.signal() }
+        defer {
+            if process.isRunning {
+                process.terminate()
+                if finished.wait(timeout: .now() + 7) == .timedOut, process.isRunning {
+                    kill(process.processIdentifier, SIGKILL)
+                    _ = finished.wait(timeout: .now() + 1)
+                }
+            }
+        }
+        func failure(_ reason: String) -> [String: Any] {
+            receipt(committed ? "unconfirmed" : "not_sent", reason: reason)
+        }
+        func messages() throws -> [[String: Any]] {
+            let file = try FileHandle(forReadingFrom: outputURL)
+            defer { try? file.close() }
+            let bytes = try file.read(upToCount: 32769) ?? Data()
+            guard bytes.count <= 32768 else { throw InputRequestError("USB keyboard receipt exceeds byte limit") }
+            guard let newline = bytes.lastIndex(of: 10) else { return [] }
+            return try bytes[..<newline].split(separator: 10, omittingEmptySubsequences: false).map {
+                guard let value = try JSONSerialization.jsonObject(with: Data($0)) as? [String: Any] else {
+                    throw InputRequestError("Invalid USB keyboard protocol record")
+                }
+                return value
+            }
+        }
+        func exchange() throws -> [String: Any] {
+            do { try process.run() } catch { return failure("USB keyboard helper did not start") }
+            let deadline = ProcessInfo.processInfo.systemUptime + 8
+            var ready = false
+            while ProcessInfo.processInfo.systemUptime < deadline {
+                if try messages().contains(where: {
+                    $0["phase"] as? String == "ready" && TextEntry.isBoolean($0["keyboard_surface_registered"])
+                        && $0["keyboard_surface_registered"] as? Bool == true
+                }) { ready = true; break }
+                if !process.isRunning { break }
+                Thread.sleep(forTimeInterval: 0.01)
+            }
+            if ready {
+                do {
+                    try beforeCommit()
+                    if let clipboard {
+                        clipboardStatus = "unconfirmed"
+                        try clipboard()
+                        clipboardStatus = "written_unverified"
+                    }
+                    // Clipboard setup may take time; do not use a replaced capture selector.
+                    try beforeCommit()
+                } catch {
+                    // Child/clipboard diagnostic text may contain user input. Keep it private.
+                    return failure("USB keyboard preparation failed; no keyboard reports were committed")
+                }
+                committed = true
+                let pending = directory.appendingPathComponent("commit.pending")
+                guard FileManager.default.createFile(atPath: pending.path, contents: Data("{\"commit\":true}".utf8),
+                    attributes: [.posixPermissions: 0o600]), rename(pending.path, commitURL.path) == 0 else {
+                    return failure("USB keyboard commit failed; do not replay")
+                }
+                if finished.wait(timeout: .now() + 15) == .timedOut {
+                    return failure("USB keyboard helper timed out after commit; do not replay")
+                }
+            } else if process.isRunning {
+                return failure("USB keyboard preflight did not become ready")
+            }
+            guard let raw = try messages().last(where: { $0["schema_version"] as? Int == 1 }),
+                raw["backend"] as? String == "coredevice-keyboard",
+                let status = raw["input_status"] as? String, ["not_sent", "sent_unverified", "unconfirmed"].contains(status),
+                let attempted = exactCount(raw["reports_attempted"]),
+                let sent = exactCount(raw["reports_locally_sent"]), sent <= attempted else {
+                return failure("USB keyboard helper ended without a valid receipt")
+            }
+            if !committed && (status != "not_sent" || attempted != 0 || sent != 0) {
+                return receipt("unconfirmed", reason: "Helper reported keyboard input without a host commit")
+            }
+            let release = raw["cleanup_release"] as? [String: Any] ?? [:]
+            let cleanup = raw["cleanup"] as? [String: Any] ?? [:]
+            let errors = cleanup["errors"] as? [[String: Any]]
+            let validSuccess = committed && TextEntry.isBoolean(raw["host_commit_received"])
+                && raw["host_commit_received"] as? Bool == true
+                && TextEntry.isBoolean(raw["virtual_service_registered"]) && raw["virtual_service_registered"] as? Bool == true
+                && TextEntry.isBoolean(raw["media_started"]) && raw["media_started"] as? Bool == false
+                && attempted == program.samples.count && sent == attempted
+                && release["status"] as? String == "sent_unverified" && errors?.isEmpty == true
+                && ["connection_closed", "tunnel_closed", "pairing_scratch_removed"].allSatisfy {
+                    TextEntry.isBoolean(cleanup[$0]) && cleanup[$0] as? Bool == true
+                }
+                && raw["error_type"] == nil
+                && process.terminationReason == .exit && process.terminationStatus == 0
+            let finalStatus = status == "not_sent" && (attempted > 0 || sent > 0) ? "unconfirmed"
+                : status == "sent_unverified" && !validSuccess ? "unconfirmed"
+                : (process.terminationReason != .exit || process.terminationStatus != 0) && committed ? "unconfirmed" : status
+            var result = receipt(finalStatus)
+            result["reports_attempted"] = attempted
+            result["reports_locally_sent"] = sent
+            result["host_commit_received"] = raw["host_commit_received"] as? Bool == true
+            result["cleanup_release"] = ["status": ["not_needed", "sent_unverified", "unconfirmed"].contains(release["status"] as? String ?? "")
+                ? release["status"] as! String : "unconfirmed"]
+            result["cleanup"] = sanitizedCleanup(cleanup)
+            result["surface_deregistration"] = "not_independently_observed"
+            if raw["error_type"] != nil { result["error_type"] = safeError(raw["error_type"]) }
+            if finalStatus != "sent_unverified" { result["reason"] = "USB keyboard did not complete cleanly; do not replay automatically" }
+            return result
+        }
+        do { return try exchange() }
+        catch { return failure(committed ? "USB keyboard receipt failed after commit; do not replay" : "USB keyboard preflight receipt was invalid") }
+    }
+
+    private static func exactCount(_ value: Any?) -> Int? {
+        guard let number = value as? NSNumber, !TextEntry.isBoolean(number), number.doubleValue.isFinite,
+            (0...128).contains(number.doubleValue), number.doubleValue.rounded() == number.doubleValue else { return nil }
+        return number.intValue
+    }
+
+    private static func safeError(_ value: Any?) -> String {
+        let known = ["ValueError", "RuntimeError", "TimeoutError", "CancelledError", "OSError", "ConnectionTerminatedError"]
+        return known.contains(value as? String ?? "") ? value as! String : "OtherError"
+    }
+
+    private static func sanitizedCleanup(_ raw: [String: Any]) -> [String: Any] {
+        var clean: [String: Any] = [:]
+        for key in ["connection_closed", "tunnel_closed", "pairing_scratch_removed", "not_started"] {
+            if TextEntry.isBoolean(raw[key]) { clean[key] = raw[key] }
+        }
+        if let errors = raw["errors"] as? [[String: Any]], errors.count <= 16 {
+            let stages = ["hid_close", "runtime_close", "cleanup_budget", "cleanup_task", "socket-close", "tunnel-close", "pairing-scratch-remove"]
+            clean["errors"] = errors.map { ["stage": stages.contains($0["stage"] as? String ?? "") ? $0["stage"] as! String : "other",
+                "error_type": safeError($0["error_type"] ?? $0["type"])] }
+        } else { clean["errors"] = [["stage": "receipt", "error_type": "InvalidCleanup"]] }
+        return clean
+    }
+
+    static func response(_ receipt: [String: Any], device: String) -> HTTPResponse {
+        let ok = receipt["input_status"] as? String == "sent_unverified" || receipt["no_op"] as? Bool == true
+        var body: [String: Any] = ["ok": ok, "device": device, "keyboard_receipt": receipt]
+        if !ok {
+            body["error"] = receipt["reason"] ?? "USB keyboard input was not confirmed; inspect before retrying"
+            body["input_sent"] = receipt["input_status"] as? String == "not_sent" ? false : nil
+        }
+        // Non-200 stops both HTTP act and MCP keyboard_sequence immediately.
+        return .json(body, status: ok ? 200 : 409)
+    }
+}
