+    func testActivityCallbacksCanStopAndRestartWithoutLeakingOrDoubleEnding() {
+        let activity = ActivityRecorder()
+        var stopFromBegin = true
+        var restartFromEnd = false
+        var controller: QuietModeActivityController!
+        defer {
+            controller?.stop()
+            controller = nil
+        }
+        controller = QuietModeActivityController(
+            environment: [:], mode: { .residentQuiet },
+            suspendCapture: {
+                XCTFail("No idle transition expected")
+                return ScreenCaptureStopResult(initiated: true, captureDrained: true, usbRestored: true)
+            }, resumeCapture: {},
+            beginActivity: { options, reason in
+                let token = activity.begin(options, reason)
+                if stopFromBegin {
+                    stopFromBegin = false
+                    controller.stop()
+                }
+                return token
+            },
+            endActivity: { token in
+                activity.end(token)
+                if restartFromEnd {
+                    restartFromEnd = false
+                    controller.start()
+                }
+            })
+        controller.start()
+        XCTAssertTrue(activity.active.isEmpty)
+        XCTAssertEqual(activity.ended, 1)
+        controller.start()
+        restartFromEnd = true
+        controller.stop()
+        XCTAssertEqual(activity.active.count, 1)
+        XCTAssertEqual(activity.options.count, 3)
+        controller.stop()
+        XCTAssertEqual(activity.ended, 3)
+    }
