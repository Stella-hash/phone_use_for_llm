+    private func updateCaptureActivity() {
+        // Capture and lifecycle callbacks can reenter on the main thread. Clear
+        // the stored token before ending it and reconcile again after callbacks.
+        guard !updatingActivity else { return }
+        updatingActivity = true
+        defer { updatingActivity = false }
+        while true {
+            let needed = (timer != nil && !suspended) || captureTransitions > 0
+            if needed, captureActivity == nil {
+                // Declare active capture work without preventing idle system or
+                // display sleep. Quiet idle and stop both relinquish this token.
+                captureActivity = beginActivity(
+                    .userInitiatedAllowingIdleSystemSleep, "iPhone USB capture and input")
+            } else if !needed, let activity = captureActivity {
+                captureActivity = nil
+                endActivity(activity)
+            } else {
+                return
+            }
+        }
+    }
