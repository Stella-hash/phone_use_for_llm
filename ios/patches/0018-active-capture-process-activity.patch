+    private final class ActivityRecorder {
+        var events: [String] = []
+        var options: [ProcessInfo.ActivityOptions] = []
+        var active: Set<ObjectIdentifier> = []
+        var ended = 0
+
+        func begin(_ options: ProcessInfo.ActivityOptions, _ reason: String) -> NSObjectProtocol {
+            XCTAssertFalse(reason.isEmpty)
+            let token = NSObject()
+            self.options.append(options)
+            XCTAssertTrue(active.insert(ObjectIdentifier(token)).inserted)
+            events.append("begin")
+            return token
+        }
+
+        func end(_ token: NSObjectProtocol) {
+            XCTAssertNotNil(active.remove(ObjectIdentifier(token)), "Each token must end exactly once")
+            ended += 1
+            events.append("end")
+        }
+    }
+
+    func testCaptureActivityCoversRequestsGraceAndCleanupWhileAllowingSleep() {
+        var clock = 0.0
+        var suspends = 0
+        let activity = ActivityRecorder()
+        let controller = QuietModeActivityController(
+            environment: ["IPHONE_USE_IDLE_TIMEOUT": "2"], mode: { .residentQuiet }, now: { clock },
+            suspendCapture: {
+                XCTAssertEqual(activity.active.count, 1, "Cleanup must remain inside the activity")
+                activity.events.append("suspend")
+                suspends += 1
+                return ScreenCaptureStopResult(initiated: true, captureDrained: true, usbRestored: true)
+            }, resumeCapture: { XCTFail("Initial capture is already active") },
+            beginActivity: activity.begin, endActivity: activity.end)
+        controller.start()
+        controller.start()
+        defer { controller.stop() }
+        XCTAssertEqual(activity.options, [.userInitiatedAllowingIdleSystemSleep])
+        XCTAssertFalse(activity.options[0].contains(.idleSystemSleepDisabled))
+        XCTAssertFalse(activity.options[0].contains(.idleDisplaySleepDisabled))
+        XCTAssertFalse(controller.requestStarted())
+        XCTAssertFalse(controller.requestStarted())
+        clock = 100
+        controller.checkIdle()
+        controller.requestFinished()
+        controller.checkIdle()
+        XCTAssertEqual(suspends, 0, "One unfinished request must still prevent idle")
+        controller.requestFinished()
+        clock = 101.99
+        controller.checkIdle()
+        XCTAssertEqual(activity.active.count, 1, "The existing idle grace retains the activity")
+        clock = 102
+        controller.checkIdle()
+        XCTAssertTrue(controller.isSuspended)
+        XCTAssertEqual(activity.events, ["begin", "suspend", "end"])
+        controller.checkIdle()
+        controller.stop()
+        controller.stop()
+        XCTAssertEqual(activity.ended, 1)
+        XCTAssertTrue(activity.active.isEmpty)
+    }
+
+    func testWindowAndDesktopWakeAcquireBeforeCaptureAndStoppedCallbacksStayInactive() {
+        var clock = 0.0
+        var mode = AppRunMode.residentQuiet
+        var resumes = 0
+        let activity = ActivityRecorder()
+        let controller = QuietModeActivityController(
+            environment: ["IPHONE_USE_IDLE_TIMEOUT": "1"], mode: { mode }, now: { clock },
+            suspendCapture: {
+                ScreenCaptureStopResult(initiated: true, captureDrained: true, usbRestored: true)
+            },
+            resumeCapture: {
+                XCTAssertEqual(activity.active.count, 1)
+                resumes += 1
+            }, beginActivity: activity.begin, endActivity: activity.end)
+        controller.start()
+        defer { controller.stop() }
+        clock = 1
+        controller.checkIdle()
+        controller.setOpenWindows(true)
+        XCTAssertEqual(resumes, 1)
+        clock = 10
+        controller.checkIdle()
+        XCTAssertEqual(activity.active.count, 1)
+        controller.setOpenWindows(false)
+        controller.checkIdle()
+        XCTAssertTrue(activity.active.isEmpty)
+        mode = .desktop
+        controller.modeChanged()
+        XCTAssertEqual(resumes, 2)
+        clock = 100
+        controller.checkIdle()
+        XCTAssertEqual(activity.active.count, 1, "Desktop mode must keep its existing capture policy")
+        controller.stop()
+        controller.setOpenWindows(true)
+        controller.modeChanged()
+        controller.checkIdle()
+        XCTAssertFalse(controller.requestStarted())
+        controller.requestFinished()
+        XCTAssertEqual(resumes, 2)
+        XCTAssertEqual(activity.options.count, 3)
+        XCTAssertEqual(activity.ended, 3)
+    }
+
+    func testIncompleteIdleCleanupEndsActivityAndNextRequestAcquiresAgain() {
+        var clock = 0.0
+        let activity = ActivityRecorder()
+        let controller = QuietModeActivityController(
+            environment: ["IPHONE_USE_IDLE_TIMEOUT": "1"], mode: { .residentQuiet }, now: { clock },
+            suspendCapture: {
+                XCTAssertEqual(activity.active.count, 1)
+                return ScreenCaptureStopResult(initiated: true, captureDrained: false, usbRestored: false)
+            }, resumeCapture: { XCTAssertEqual(activity.active.count, 1) },
+            beginActivity: activity.begin, endActivity: activity.end)
+        controller.start()
+        defer { controller.stop() }
+        clock = 1
+        controller.checkIdle()
+        XCTAssertTrue(controller.isSuspended)
+        XCTAssertTrue(activity.active.isEmpty, "An incomplete stop must not retain a permanent activity")
+        XCTAssertTrue(controller.requestStarted())
+        controller.requestFinished()
+        XCTAssertEqual(activity.options.count, 2)
+        clock = 2
+        controller.checkIdle()
+        XCTAssertEqual(activity.ended, 2)
+    }
+
+    func testStopAndRestartResetIdleRequestAndWakeState() {
+        var clock = 0.0
+        let activity = ActivityRecorder()
+        let controller = QuietModeActivityController(
+            environment: ["IPHONE_USE_IDLE_TIMEOUT": "1"], mode: { .residentQuiet }, now: { clock },
+            suspendCapture: {
+                ScreenCaptureStopResult(initiated: true, captureDrained: true, usbRestored: true)
+            }, resumeCapture: {}, beginActivity: activity.begin, endActivity: activity.end)
+        controller.start()
+        defer { controller.stop() }
+        clock = 1
+        controller.checkIdle()
+        XCTAssertTrue(controller.requestStarted())
+        XCTAssertTrue(controller.isWithinWakeGraceWindow)
+        controller.stop()
+        controller.start()
+        XCTAssertFalse(controller.isSuspended)
+        XCTAssertFalse(controller.isWithinWakeGraceWindow)
+        clock = 2
+        controller.checkIdle()
+        XCTAssertTrue(controller.isSuspended, "The previous lifecycle's request count must not prevent idle")
+        controller.stop()
+        controller.start()
+        XCTAssertFalse(controller.isSuspended, "A fresh lifecycle starts with capture active")
+        XCTAssertEqual(activity.active.count, 1)
+        controller.stop()
+        XCTAssertEqual(activity.options.count, activity.ended)
+    }
+
+    func testWakeDuringIdleCleanupKeepsActivityThroughReturningOldCallback() {
+        var clock = 0.0
+        var suspends = 0
+        let activity = ActivityRecorder()
+        var controller: QuietModeActivityController!
+        defer {
+            controller?.stop()
+            controller = nil
+        }
+        controller = QuietModeActivityController(
+            environment: ["IPHONE_USE_IDLE_TIMEOUT": "1"], mode: { .residentQuiet }, now: { clock },
+            suspendCapture: {
+                suspends += 1
+                if suspends == 1 {
+                    XCTAssertTrue(controller.requestStarted())
+                    XCTAssertEqual(activity.active.count, 1)
+                }
+                return ScreenCaptureStopResult(initiated: true, captureDrained: true, usbRestored: true)
+            }, resumeCapture: { XCTAssertEqual(activity.active.count, 1) },
+            beginActivity: activity.begin, endActivity: activity.end)
+        controller.start()
+        clock = 1
+        controller.checkIdle()
+        XCTAssertFalse(controller.isSuspended)
+        XCTAssertEqual(activity.options.count, 1, "Reentrant wake must reuse the still-active token")
+        XCTAssertEqual(activity.ended, 0)
+        clock = 2
+        controller.checkIdle()
+        XCTAssertEqual(suspends, 1)
+        controller.requestFinished()
+        clock = 3
+        controller.checkIdle()
+        XCTAssertEqual(activity.ended, 1)
+    }
+
