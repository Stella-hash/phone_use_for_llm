diff --git a/Sources/iPhoneUse/API/LeafInputRequests.swift b/Sources/iPhoneUse/API/LeafInputRequests.swift
new file mode 100644
index 0000000..862d9b5
--- /dev/null
+++ b/Sources/iPhoneUse/API/LeafInputRequests.swift
@@ -0,0 +1,161 @@
+import CoreFoundation
+import Foundation
+
+/// Pure leaf validation shared by HTTP authority and MCP/batch preflight.
+/// A parser does not select a device, check channel readiness or send input.
+struct InputRequestError: Error, CustomStringConvertible {
+    let description: String
+    init(_ description: String) { self.description = description }
+}
+
+enum InputRequestValue {
+    static func number(_ raw: Any?, field: String) throws -> Double {
+        guard let number = raw as? NSNumber,
+            CFGetTypeID(number) != CFBooleanGetTypeID(), number.doubleValue.isFinite
+        else { throw InputRequestError("\(field) must be a finite number") }
+        return number.doubleValue
+    }
+
+    static func boolean(_ raw: Any?, field: String, default fallback: Bool) throws -> Bool {
+        guard let raw else { return fallback }
+        guard let number = raw as? NSNumber, CFGetTypeID(number) == CFBooleanGetTypeID()
+        else { throw InputRequestError("\(field) must be a boolean") }
+        return number.boolValue
+    }
+}
+
+struct KeyRequest {
+    let key: String
+    let modifiers: [String]
+
+    init(_ body: [String: Any]) throws {
+        guard let key = body["key"] as? String,
+            KeyboardMap.named[key.lowercased()] != nil || key.count == 1,
+            KeyboardMap.code(for: key) != nil
+        else { throw InputRequestError("Unknown or invalid key") }
+        let modifiers: [String]
+        if let raw = body["modifiers"] {
+            guard let strings = raw as? [String] else {
+                throw InputRequestError("modifiers must be an array of strings")
+            }
+            modifiers = strings
+        } else {
+            modifiers = []
+        }
+        guard KeyboardMap.modifierMask(for: modifiers) != nil else {
+            throw InputRequestError("Unknown modifier")
+        }
+        self.key = key
+        self.modifiers = modifiers
+    }
+
+    var body: [String: Any] { ["key": key, "modifiers": modifiers] }
+}
+
+struct HoldRequest {
+    let seconds: TimeInterval
+
+    init(_ body: [String: Any], key: String = "hold", default fallback: TimeInterval = 0.08) throws {
+        let seconds = try InputRequestValue.number(body[key] ?? fallback, field: key)
+        guard (0...60).contains(seconds) else {
+            throw InputRequestError("\(key) must be in 0...60 seconds")
+        }
+        self.seconds = seconds
+    }
+}
+
+struct NudgeRequest {
+    let dx: Int
+    let dy: Int
+    let click: Bool
+
+    /// HTTP may omit either delta; MCP adjust_pointer requires both.
+    /// The bounded range is the existing MCP adjustment contract.
+    init(_ body: [String: Any], requireDeltas: Bool = false) throws {
+        func delta(_ key: String) throws -> Int {
+            if requireDeltas, body[key] == nil { throw InputRequestError("\(key) is required") }
+            let value = try InputRequestValue.number(body[key] ?? 0, field: key)
+            guard (-32...32).contains(value), value.rounded() == value else {
+                throw InputRequestError("\(key) must be an integer in -32...32")
+            }
+            return Int(value)
+        }
+        dx = try delta("dx")
+        dy = try delta("dy")
+        click = try InputRequestValue.boolean(body["click"], field: "click", default: false)
+    }
+
+    var body: [String: Any] { ["dx": dx, "dy": dy, "click": click] }
+}
+
+/// Parses numeric shape first; resolving pixel bounds requires the real capture
+/// size. MCP can do shape preflight early, but the HTTP authority must resolve
+/// every point against actual or frame-bound dimensions before sending input.
+struct CoordinateRequest {
+    let x: Double
+    let y: Double
+    let fraction: Bool
+    let width: Double?
+    let height: Double?
+    let maxEdge: Int?
+
+    init(_ body: [String: Any], xKey: String = "x", yKey: String = "y") throws {
+        let x = try InputRequestValue.number(body[xKey], field: xKey)
+        let y = try InputRequestValue.number(body[yKey], field: yKey)
+        let fraction = try InputRequestValue.boolean(body["fraction"], field: "fraction", default: false)
+        guard x >= 0, y >= 0 else { throw InputRequestError("Coordinates must be nonnegative") }
+        func dimension(_ key: String) throws -> Double? {
+            guard let raw = body[key] else { return nil }
+            let value = try InputRequestValue.number(raw, field: key)
+            guard value > 0 else { throw InputRequestError("\(key) must be positive") }
+            return value
+        }
+        let width = try dimension("width")
+        let height = try dimension("height")
+        let maxEdge: Int?
+        if let raw = body["maxEdge"] {
+            let value = try InputRequestValue.number(raw, field: "maxEdge")
+            guard value >= 1, value < Double(Int.max) else {
+                throw InputRequestError("maxEdge must be a positive size smaller than Int.max")
+            }
+            // Preserve the legacy coordinate endpoint's positive-size truncation.
+            // OCR maxEdge has a separate integer-only contract.
+            maxEdge = Int(value)
+        } else {
+            maxEdge = nil
+        }
+        if fraction {
+            guard x <= 1, y <= 1 else { throw InputRequestError("Fractions must be in 0...1") }
+        } else {
+            // Explicit dimensions already allow an early, definitive rejection.
+            if let width, x >= width { throw InputRequestError("x must be inside the image width") }
+            if let height, y >= height { throw InputRequestError("y must be inside the image height") }
+        }
+        self.x = x
+        self.y = y
+        self.fraction = fraction
+        self.width = width
+        self.height = height
+        self.maxEdge = maxEdge
+    }
+
+    func point(screenSize: @autoclosure () -> CGSize?) throws -> (Double, Double) {
+        if fraction { return (x, y) }
+        guard let size = screenSize(), size.width.isFinite, size.height.isFinite,
+            size.width > 0, size.height > 0,
+            size.width < Double(Int.max), size.height < Double(Int.max)
+        else { throw InputRequestError("A finite positive capture size is required for image pixels") }
+        var imageWidth = Double(size.width), imageHeight = Double(size.height)
+        if let maxEdge {
+            let scale = min(1, Double(maxEdge) / max(imageWidth, imageHeight))
+            imageWidth = (imageWidth * scale).rounded()
+            imageHeight = (imageHeight * scale).rounded()
+        }
+        imageWidth = width ?? imageWidth
+        imageHeight = height ?? imageHeight
+        guard imageWidth > 0, imageHeight > 0, x < imageWidth, y < imageHeight else {
+            throw InputRequestError("Coordinates must be inside the current image")
+        }
+        return (x / imageWidth, y / imageHeight)
+    }
+}
