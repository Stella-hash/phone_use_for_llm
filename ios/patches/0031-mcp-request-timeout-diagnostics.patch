+    static func requestError(_ error: Error, timeout: TimeInterval, language: AppLanguage) -> MCPServer.MCPError {
+        let native = error as NSError
+        // A request deadline or cancellation says nothing about whether the host is running.
+        if native.domain == NSURLErrorDomain {
+            switch native.code {
+            case URLError.timedOut.rawValue:
+                return MCPServer.MCPError("HTTP response timed out after \(timeout) seconds")
+            case URLError.cancelled.rawValue:
+                return MCPServer.MCPError("HTTP request was cancelled")
+            default:
+                break
+            }
+        }
+        return MCPServer.MCPError(StringsMCP(language: language).appNotRunning(error.localizedDescription))
+    }
+
