+    func testStationaryMeasuredSwipeKeepsHoldAndDoesNotCatchUpAfterSlowTopUps() throws {
+        for oversleep in [TimeInterval(0), 0.02] {
+            let recorder = HeldDragRecorder()
+            var now: TimeInterval = 0
+            var pauses: [TimeInterval] = []
+            var pressedAt: TimeInterval?
+            var releasedAt: TimeInterval?
+            recorder.onReport = {
+                guard let (id, bytes) = recorder.reports.last, id == .relativeMouse else { return }
+                if bytes == [1, 0, 0, 0] { pressedAt = now }
+                if bytes == [0, 0, 0, 0], pressedAt != nil { releasedAt = now }
+            }
+            let input = recorder.input(
+                sleep: { seconds in
+                    pauses.append(seconds)
+                    now += seconds
+                    if abs(seconds - 0.03125) < 1e-12 { now += oversleep }
