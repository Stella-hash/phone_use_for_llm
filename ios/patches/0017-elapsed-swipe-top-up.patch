+    func testMeasuredSwipeDoesNotTopUpAfterSlowInnerSleepOrSend() throws {
+        let reference = HeldDragRecorder()
+        try reference.input().swipe(points: [(0.3, 0.2), (0.3, 0.33)], duration: 0.48)
+        for slowSleep in [true, false] {
+            for duration in [0.48, 0.5] {
+                let recorder = HeldDragRecorder()
+                var now: TimeInterval = 0
+                var pauses: [TimeInterval] = []
+                if !slowSleep {
+                    recorder.onReport = {
+                        if let (id, bytes) = recorder.reports.last,
+                            id == .relativeMouse, bytes[1] != 0 || bytes[2] != 0
+                        { now += 0.005 }
+                    }
+                }
+                let input = recorder.input(
+                    sleep: { seconds in
+                        pauses.append(seconds)
+                        now += seconds
+                        if slowSleep, seconds == 0.03 { now += 0.005 }
+                    }, monotonicNow: { now })
+                try input.swipe(points: [(0.3, 0.2), (0.3, 0.33)], duration: duration)
+
+                XCTAssertTrue(pauses.allSatisfy { $0 >= 0.03 }, "elapsed movement already exceeds either interval")
+                XCTAssertEqual(recorder.reports.map(\.0), reference.reports.map(\.0))
+                XCTAssertEqual(recorder.reports.map(\.1), reference.reports.map(\.1))
+                XCTAssertEqual(pauses.filter { $0 == 0.03 }.count, recorder.movement.count + 3,
+                    "retain each report interval plus initial priming, press and release pacing")
+                XCTAssertEqual(recorder.presses.count, 1)
+                XCTAssertEqual(recorder.buttons, 0)
+                XCTAssertEqual(recorder.reports.last?.1, [0, 0, 0, 0])
+            }
+        }
+    }
