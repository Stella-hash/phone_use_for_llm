+    func testMeasuredSwipeFastTopUpsPreserveReportsAndTheInjectedSleepFloor() throws {
+        var reference: [[UInt8]]?
+        for advancesClock in [false, true] {
+            for duration in [0.48, 0.5] {
+                let recorder = HeldDragRecorder()
+                var now: TimeInterval = 0
+                var pauses: [TimeInterval] = []
+                let input = recorder.input(
+                    sleep: { seconds in
+                        pauses.append(seconds)
+                        if advancesClock { now += seconds }
+                    }, monotonicNow: { now })
+                try input.swipe(points: [(0.3, 0.2), (0.3, 0.33)], duration: duration)
+
+                let topUps = pauses.filter { $0 > 0 && $0 < 0.03 - 1e-12 }
+                XCTAssertEqual(topUps.count, duration == 0.48 ? 0 : 15)
+                for wait in topUps { XCTAssertEqual(wait, 0.00125, accuracy: 1e-12) }
+                if let reference { XCTAssertEqual(recorder.reports.map(\.1), reference) }
+                else { reference = recorder.reports.map(\.1) }
+                XCTAssertEqual(recorder.presses.count, 1)
+                XCTAssertEqual(recorder.buttons, 0)
+                XCTAssertEqual(recorder.reports.last?.1, [0, 0, 0, 0])
+                XCTAssertEqual(recorder.position.y, 0.33 * 2556, accuracy: 0.36)
+            }
+        }
+    }
