+private func localizedActStepSchema(_ type: String, language: AppLanguage) throws -> [String: Any] {
+    let act = try XCTUnwrap(MCPToolCatalog.tools(for: language).first { $0["name"] as? String == "act" })
+    let schema = try XCTUnwrap(act["inputSchema"] as? [String: Any])
+    let properties = try XCTUnwrap(schema["properties"] as? [String: [String: Any]])
+    let items = try XCTUnwrap(properties["steps"]?["items"] as? [String: Any])
+    let choices = try XCTUnwrap(items["oneOf"] as? [[String: Any]])
+    return try XCTUnwrap(choices.first {
+        (($0["properties"] as? [String: [String: Any]])?["type"]?["enum"] as? [String]) == [type]
+    })
+}
