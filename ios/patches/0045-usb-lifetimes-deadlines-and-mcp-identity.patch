diff --git a/Tests/iPhoneUseTests/MCP/MCPDevicePrivacyTests.swift b/Tests/iPhoneUseTests/MCP/MCPDevicePrivacyTests.swift
new file mode 100644
index 0000000..38ab6e5
--- /dev/null
+++ b/Tests/iPhoneUseTests/MCP/MCPDevicePrivacyTests.swift
@@ -0,0 +1,122 @@
+import Foundation
+import XCTest
+
+@testable import iPhoneUse
+
+final class MCPDevicePrivacyTests: XCTestCase {
+    private let physical = "11111111-1111111111111111"
+    private let other = "22222222-2222222222222222"
+    private let alias = "configured-usb-phone"
+
+    private func encode(_ value: Any) throws -> String {
+        String(decoding: try JSONSerialization.data(withJSONObject: value, options: [.sortedKeys]), as: UTF8.self)
+    }
+
+    private func textObject(_ result: [String: Any]) throws -> [String: Any] {
+        let blocks = try XCTUnwrap(result["content"] as? [[String: Any]])
+        let text = try XCTUnwrap(blocks.first(where: { $0["type"] as? String == "text" })?["text"] as? String)
+        return try XCTUnwrap(JSONSerialization.jsonObject(with: Data(text.utf8)) as? [String: Any])
+    }
+
+    func testManagedSelectorsAcceptOnlyAliasOrOmissionAndCheckBothFields() throws {
+        for arguments: [String: Any] in [[:], ["device": alias], ["device_id": alias.uppercased()],
+                                         ["device": alias, "device_id": alias]] {
+            XCTAssertNoThrow(try MCPServer.validateManagedSelectors(arguments, configuredDevice: physical))
+        }
+        for arguments: [String: Any] in [["device": physical], ["device": other], ["device": "USB iPhone"],
+                                         ["device": alias, "device_id": other], ["device_id": 7]] {
+            XCTAssertThrowsError(try MCPServer.validateManagedSelectors(arguments, configuredDevice: physical))
+        }
+    }
+
+    func testDeviceListShowsOnlyAliasAndRejectsWrongOrMultiplePhysicalTargets() throws {
+        func list(_ ids: [String]) throws -> Data {
+            try JSONSerialization.data(withJSONObject: ["devices": ids.map { ["id": $0, "name": $0] }])
+        }
+        let input = try list([physical])
+        let result = try MCPServer.deviceListContent(input, configuredDevice: physical)
+        let devices = try XCTUnwrap(try textObject(result)["devices"] as? [[String: String]])
+        XCTAssertEqual(devices, [["id": alias, "name": "USB iPhone", "transport": "coredevice-usb"]])
+        XCTAssertFalse(try encode(result).contains(physical))
+        XCTAssertEqual(try MCPServer.resolveDevice(alias, data: input, configuredDevice: physical), physical)
+        for ids in [[], [other], [physical, other], [physical, physical]] {
+            XCTAssertThrowsError(try MCPServer.deviceListContent(list(ids), configuredDevice: physical))
+        }
+    }
+
+    func testScreenshotCaptionChangesWithoutChangingImageOrOCRText() throws {
+        let image = Data(physical.utf8)
+        let ocr = ScreenOCR.Result(width: 20, height: 40, items: [.init(text: "kept OCR", x: 1, y: 2)])
+        let original = MCPServer.screenshotContent(image: image, device: physical, width: "20", height: "40",
+            includeImage: true, ocr: ocr, mimeType: "image/png")
+        let projected = MCPServer.modelResult(original, configuredDevice: physical)
+        let blocks = try XCTUnwrap(projected["content"] as? [[String: Any]])
+        XCTAssertEqual(blocks.first?["data"] as? String, image.base64EncodedString())
+        let text = try XCTUnwrap(blocks.last?["text"] as? String)
+        XCTAssertTrue(text.contains(alias))
+        XCTAssertFalse(text.contains(physical))
+        XCTAssertTrue(text.contains("kept OCR"))
+        let chinese: [String: Any] = ["content": [["type": "text", "text": "\(physical) 的截图，20x40 像素。"]]]
+        XCTAssertTrue(try encode(MCPServer.modelResult(chinese, configuredDevice: physical)).contains(alias))
+    }
+
+    func testOCRAndBurstTextAndStructuredMetadataUseSameAlias() throws {
+        let ocr = ScreenOCR.Result(width: 20, height: 40, items: [], screenHash: "fixture")
+        let rawOCR: [String: Any] = ["content": [["type": "text", "text": try encode(ocr.json(device: physical))]]]
+        XCTAssertEqual(try textObject(MCPServer.modelResult(rawOCR, configuredDevice: physical))["device"] as? String, alias)
+        let frame = MCPServer.ObservationFrame(image: Data([1]), device: physical, width: "20", height: "40",
+            mimeType: "image/png", identity: .init(source: "coredevice-usb:42", sequence: 1, receivedAt: 11), signature: "fixture")
+        var burst = MCPScreenshotBurst.Result(options: try .init(["frames": 2]), startedAt: 10)
+        burst.samples = [.init(frame: frame, returnedAfter: 1)]
+        let projected = MCPServer.modelResult(MCPScreenshotBurst.content(burst, device: physical, includeImage: false),
+            configuredDevice: physical)
+        XCTAssertEqual(try textObject(projected)["device"] as? String, alias)
+        XCTAssertEqual((projected["structuredContent"] as? [String: Any])?["device"] as? String, alias)
+        XCTAssertFalse(try encode(projected).contains(physical))
+    }
+
+    func testSessionProjectionDoesNotChangePrivateStorageIdentity() throws {
+        let directory = FileManager.default.temporaryDirectory.appendingPathComponent("mcp-privacy-\(UUID().uuidString)")
+        defer { try? FileManager.default.removeItem(at: directory) }
+        let store = try MCPContextStore(device: physical, directory: directory)
+        let context = try store.context()
+        let result: [String: Any] = ["content": [["type": "text", "text": try encode(context)]], "structuredContent": context]
+        let projected = MCPServer.modelResult(result, configuredDevice: physical)
+        XCTAssertEqual(try textObject(projected)["device"] as? String, alias)
+        XCTAssertEqual((projected["structuredContent"] as? [String: Any])?["device"] as? String, alias)
+        XCTAssertFalse(try encode(projected).contains(physical))
+        let saved = try XCTUnwrap(JSONSerialization.jsonObject(with: Data(contentsOf: store.file)) as? [String: Any])
+        XCTAssertEqual(saved["device"] as? String, physical)
+    }
+
+    func testAXEnvelopeChangesButNativeAndCheckpointPayloadsRemainExact() throws {
+        let payload: [String: Any] = ["device": physical, "device_id": physical, "text": "original \(physical)"]
+        let tree: [String: Any] = ["schema_version": 1, "source": "ios-native-ax", "status": "ok",
+            "device_id": physical, "nodes": [payload], "parents": [payload], "parent_fields": [payload],
+            "defaults": payload, "node_defaults": payload, "ancestors": [payload], "items": [payload],
+            "checkpoint": payload, "archive": ["status": "failed"]]
+        let result = MCPServer.modelResult(try MCPServer.accessibilityResult(tree), configuredDevice: physical)
+        let visible = try textObject(result)
+        XCTAssertEqual(visible["device_id"] as? String, alias)
+        for key in ["nodes", "parents", "parent_fields", "ancestors", "items"] {
+            XCTAssertEqual(try encode(visible[key]!), try encode([payload]))
+        }
+        for key in ["defaults", "node_defaults", "checkpoint"] {
+            XCTAssertEqual(try encode(visible[key]!), try encode(payload))
+        }
+        let structured = MCPServer.modelResult(["structuredContent": ["device": physical, "checkpoint": payload]],
+            configuredDevice: physical)["structuredContent"] as? [String: Any]
+        XCTAssertEqual(structured?["device"] as? String, alias)
+        XCTAssertEqual(try encode(try XCTUnwrap(structured?["checkpoint"])), try encode(payload))
+    }
+
+    func testDiagnosticMetadataRedactsIdentifierButCheckpointDiagnosticWordsStayLiteral() throws {
+        let note: [String: Any] = ["device": physical, "reason": "original \(physical)"]
+        let raw: [String: Any] = ["structuredContent": ["device": physical, "reason": "failed \(physical)",
+            "observation": ["detail": "failed \(physical)"], "checkpoint": note]]
+        let projected = try XCTUnwrap(MCPServer.modelResult(raw, configuredDevice: physical)["structuredContent"] as? [String: Any])
+        XCTAssertEqual(projected["reason"] as? String, "failed \(alias)")
+        XCTAssertEqual((projected["observation"] as? [String: Any])?["detail"] as? String, "failed \(alias)")
+        XCTAssertEqual(try encode(projected["checkpoint"]!), try encode(note))
+    }
+}
