diff --git a/Sources/iPhoneUse/Input/HeldDragProfile.swift b/Sources/iPhoneUse/Input/HeldDragProfile.swift
new file mode 100644
index 0000000..5ac861a
--- /dev/null
+++ b/Sources/iPhoneUse/Input/HeldDragProfile.swift
@@ -0,0 +1,102 @@
+import Foundation
+
+/// Optional, local measurements of button-held relative reports. This is not
+/// a pointer calibration: button-up positioning remains native absolute, and
+/// these samples must never be reused as a hover curve or scaled to a screen.
+struct HeldDragProfile: Codable {
+    struct Sample: Codable, Equatable {
+        let count: Int
+        let distance: Double
+    }
+
+    let schemaVersion: Int
+    let host: UUID
+    let screenID: String
+    let screenWidth: Int
+    let screenHeight: Int
+    /// Requested driver pacing used while measuring, not phone event latency.
+    let reportInterval: TimeInterval
+    let samples: [Sample]
+
+    enum Selection {
+        case notConfigured
+        case invalid(String)
+        case loaded(HeldDragProfile)
+
+        static func load(environment: [String: String] = ProcessInfo.processInfo.environment) -> Selection {
+            guard let path = environment["IPHONE_USE_HELD_DRAG_PROFILE"] else { return .notConfigured }
+            guard !path.isEmpty else { return .invalid("profile path is empty") }
+            do {
+                let profile = try JSONDecoder().decode(
+                    HeldDragProfile.self, from: Data(contentsOf: URL(fileURLWithPath: path)))
+                if let issue = profile.validationIssue { return .invalid(issue) }
+                return .loaded(profile)
+            } catch {
+                return .invalid("cannot read held-drag profile: \(error)")
+            }
+        }
+    }
+
+    var validationIssue: String? {
+        guard schemaVersion == 1 else { return "unsupported schemaVersion" }
+        guard !screenID.isEmpty, screenWidth > 0, screenHeight > 0 else {
+            return "screen identity and dimensions are required"
+        }
+        guard reportInterval.isFinite, (0.01...0.1).contains(reportInterval) else {
+            return "reportInterval must be between 0.01 and 0.1 seconds"
+        }
+        guard samples.first?.count == 1 else { return "samples must begin with measured count 1" }
+        var previous = Sample(count: 0, distance: 0)
+        for sample in samples {
+            guard (1...127).contains(sample.count), sample.count > previous.count,
+                sample.distance.isFinite, sample.distance > previous.distance
+            else { return "sample counts and positive distances must be strictly increasing" }
+            previous = sample
+        }
+        return nil
+    }
+
+    func bindingIssue(host: UUID, screenID: String?, size: CGSize?, interval: TimeInterval) -> String? {
+        if let issue = validationIssue { return issue }
+        guard self.host == host else { return "Bluetooth host does not match profile" }
+        guard self.screenID == screenID else { return "capture screen ID does not match profile" }
+        guard let size, size.width == Double(screenWidth), size.height == Double(screenHeight) else {
+            return "live capture dimensions do not match profile"
+        }
+        guard interval.isFinite, abs(reportInterval - interval) < 0.000_001 else {
+            return "driver report interval does not match profile"
+        }
+        return nil
+    }
+
+    struct Movement {
+        let dx: Int
+        let dy: Int
+        let position: CGPoint
+    }
+
+    /// Send only measured counts and one axis at a time. Intermediate targets
+    /// carry their residual to the next frame rather than emitting a chain of
+    /// tiny correction reports. Segment endpoints finish within half count 1;
+    /// no large overshoot is allowed at a corner or release point.
+    func movement(from position: CGPoint, to target: CGPoint, finishing: Bool) -> Movement? {
+        let tolerance = samples[0].distance / 2
+        let errors = [target.x - position.x, target.y - position.y]
+        let axis = abs(errors[0]) >= abs(errors[1]) ? 0 : 1
+        let error = errors[axis]
+        guard abs(error) > tolerance else { return nil }
+        let candidates = samples.filter {
+            abs(abs(error) - $0.distance) < abs(error)
+                && (!finishing || $0.distance <= abs(error) + tolerance)
+        }
+        guard let sample = candidates.min(by: {
+            abs(abs(error) - $0.distance) < abs(abs(error) - $1.distance)
+        }) else { return nil }
+        let sign = error < 0 ? -1 : 1
+        let delta = Double(sign) * sample.distance
+        let count = sign * sample.count
+        var next = position
+        if axis == 0 { next.x += delta } else { next.y += delta }
+        return Movement(dx: axis == 0 ? count : 0, dy: axis == 1 ? count : 0, position: next)
+    }
+}
