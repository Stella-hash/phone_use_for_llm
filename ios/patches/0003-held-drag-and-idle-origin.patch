+// Fresh input has unknown phone-side absolute state. Verify its two-report
+// priming prefix separately, then keep the existing gesture assertions focused
+// on the requested target, held movement, and release.
+private func removeInitialAbsolutePrime(_ reports: inout [(ReportID, [UInt8])]) {
+    XCTAssertGreaterThanOrEqual(reports.count, 3)
+    guard reports.count >= 3 else { return }
+    XCTAssertEqual(reports[0].0, .absolutePointer)
+    XCTAssertEqual(reports[0].1[0], 0)
+    XCTAssertEqual(reports[1].0, .relativeMouse)
+    XCTAssertEqual(reports[1].1, [0, 0, 0, 0])
+    XCTAssertEqual(reports[2].0, .absolutePointer)
+    XCTAssertNotEqual(Array(reports[0].1[1...2]), Array(reports[2].1[1...2]))
+    XCTAssertNotEqual(Array(reports[0].1[3...4]), Array(reports[2].1[3...4]))
+    reports.removeFirst(2)
+}
