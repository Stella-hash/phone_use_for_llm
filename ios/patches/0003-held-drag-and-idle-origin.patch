     func testInvalidatedCalibratedEstimateHomesBeforeNextWindowMove() throws {
diff --git a/Tests/iPhoneUseTests/Input/HeldDragProfileTests.swift b/Tests/iPhoneUseTests/Input/HeldDragProfileTests.swift
new file mode 100644
index 0000000..338ff79
--- /dev/null
+++ b/Tests/iPhoneUseTests/Input/HeldDragProfileTests.swift
@@ -0,0 +1,208 @@
+import XCTest
+
+@testable import iPhoneUse
+
+private final class HeldDragRecorder {
+    let host = UUID()
+    let screenID = "held-drag-test-phone"
+    var size = CGSize(width: 1180, height: 2556)
+    var reports: [(ReportID, [UInt8])] = []
+    var position = CGPoint.zero
+    var presses: [CGPoint] = []
+    var heldPositions: [CGPoint] = []
+    var buttons: UInt8 = 0
+    var onReport: (() -> Void)?
+
+    var profile: HeldDragProfile {
+        HeldDragProfile(
+            schemaVersion: 1, host: host, screenID: screenID, screenWidth: 1180, screenHeight: 2556,
+            reportInterval: 0.03,
+            samples: zip([1, 2, 4, 8, 16, 32], [0.625, 1.21875, 5.71875, 17.75, 41.75, 117.25])
+                .map { .init(count: $0.0, distance: $0.1) })
+    }
+
+    func input(selection: HeldDragProfile.Selection? = nil, screenID: String? = nil) -> DeviceInput {
+        DeviceInput(
+            host: host, session: UUID(), screenID: screenID ?? self.screenID,
+            screenSize: { self.size }, heldDragProfile: selection ?? .loaded(profile),
+            sleep: { _ in }, reportSender: receive)
+    }
+
+    func receive(_ id: ReportID, _ bytes: [UInt8]) {
+        reports.append((id, bytes))
+        if id == .absolutePointer {
+            position = CGPoint(
+                x: Double(Int(bytes[1]) | Int(bytes[2]) << 8) / 32767 * 1180,
+                y: Double(Int(bytes[3]) | Int(bytes[4]) << 8) / 32767 * 2556)
+        } else if id == .relativeMouse {
+            if bytes[0] != 0, buttons == 0 { presses.append(position) }
+            buttons = bytes[0]
+            let dx = Int(Int8(bitPattern: bytes[1]))
+            let dy = Int(Int8(bitPattern: bytes[2]))
+            for (axis, count) in [(0, dx), (1, dy)] where count != 0 {
+                guard let sample = profile.samples.first(where: { $0.count == abs(count) }) else {
+                    XCTFail("driver emitted an unmeasured count \(count)")
+                    continue
+                }
+                let distance = Double(count.signum()) * sample.distance
+                if axis == 0 { position.x += distance } else { position.y += distance }
+            }
+            if buttons != 0 { heldPositions.append(position) }
+        }
+        onReport?()
+    }
+
+    var movement: [[UInt8]] {
+        reports.compactMap { id, bytes in
+            id == .relativeMouse && (bytes[1] != 0 || bytes[2] != 0) ? bytes : nil
+        }
+    }
+}
+
+final class HeldDragProfileTests: XCTestCase {
+    func testLoaderDistinguishesAbsentInvalidAndLoadedFiles() throws {
+        guard case .notConfigured = HeldDragProfile.Selection.load(environment: [:]) else {
+            return XCTFail("absent environment must preserve estimated drag")
+        }
+        let directory = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        defer { try? FileManager.default.removeItem(at: directory) }
+        let url = directory.appendingPathComponent("held.json")
+        let env = ["IPHONE_USE_HELD_DRAG_PROFILE": url.path]
+        guard case .invalid = HeldDragProfile.Selection.load(environment: env) else {
+            return XCTFail("missing configured file must be explicit")
+        }
+        let profile = HeldDragRecorder().profile
+        try JSONEncoder().encode(profile).write(to: url)
+        guard case .loaded(let loaded) = HeldDragProfile.Selection.load(environment: env) else {
+            return XCTFail("valid profile was not loaded")
+        }
+        XCTAssertEqual(loaded.samples, profile.samples)
+        var json = try XCTUnwrap(JSONSerialization.jsonObject(with: Data(contentsOf: url)) as? [String: Any])
+        for invalidSamples in [
+            [], [["count": 2, "distance": 1.2]],
+            [["count": 1, "distance": 0]],
+            [["count": 1, "distance": 1], ["count": 1, "distance": 2]],
+            [["count": 1, "distance": 1], ["count": 2, "distance": 0.5]],
+            [["count": 1, "distance": 1], ["count": 128, "distance": 2]],
+        ] as [[[String: Any]]] {
+            json["samples"] = invalidSamples
+            try JSONSerialization.data(withJSONObject: json).write(to: url)
+            guard case .invalid = HeldDragProfile.Selection.load(environment: env) else {
+                XCTFail("invalid sample table was accepted: \(invalidSamples)")
+                continue
+            }
+        }
+    }
+
+    func testProfileBindingRequiresExactHostScreenDimensionsAndPacing() {
+        let recorder = HeldDragRecorder()
+        let profile = recorder.profile
+        XCTAssertNil(profile.bindingIssue(host: recorder.host, screenID: recorder.screenID, size: recorder.size, interval: 0.03))
+        for (host, screen, size, interval) in [
+            (UUID(), recorder.screenID, recorder.size, 0.03),
+            (recorder.host, "different", recorder.size, 0.03),
+            (recorder.host, recorder.screenID, CGSize(width: 2556, height: 1180), 0.03),
+            (recorder.host, recorder.screenID, recorder.size, 0.075),
+        ] {
+            XCTAssertNotNil(profile.bindingIssue(host: host, screenID: screen, size: size, interval: interval))
+        }
+        XCTAssertNotNil(profile.bindingIssue(host: recorder.host, screenID: nil, size: recorder.size, interval: 0.03))
+        XCTAssertNotNil(profile.bindingIssue(host: recorder.host, screenID: recorder.screenID, size: nil, interval: 0.03))
+    }
+
+    func testMeasuredHeldReportsReachEndpointsAtDifferentSpeedsAndDirections() throws {
+        for (dx, dy, duration) in [
+            (0.0, 93.56, 0.48), (0, 151.49, 0.24), (0, 269.85, 0.12),
+            (0, -269.85, 0.12), (160, 0, 0.24), (-160, 0, 0.24),
+            (130, 180, 0.24),
+        ] {
+            let recorder = HeldDragRecorder()
+            let input = recorder.input()
+            let start = (231.0 / 462, 420.0 / 1000)
+            let end = ((231 + dx) / 462, (420 + dy) / 1000)
+            try input.swipe(points: [start, end], duration: duration)
+
+            XCTAssertEqual(recorder.position.x, end.0 * 1180, accuracy: 0.36)
+            XCTAssertEqual(recorder.position.y, end.1 * 2556, accuracy: 0.36)
+            XCTAssertEqual(recorder.buttons, 0)
+            XCTAssertEqual(recorder.presses.count, 1)
+            XCTAssertTrue(recorder.movement.allSatisfy { $0[0] == 1 && ($0[1] == 0 || $0[2] == 0) })
+            XCTAssertLessThanOrEqual(recorder.movement.count, Int(duration / 0.03) + 16,
+                "intermediate targets must not each trigger count-1 correction chains")
+            let status = try XCTUnwrap(input.pointerStatus["heldDrag"] as? [String: Any])
+            XCTAssertEqual(status["profileState"] as? String, "loaded")
+            XCTAssertEqual(status["mode"] as? String, "measured")
+        }
+    }
+
+    func testMeasuredPolylineReachesCornerBeforeTurningAndWindowReleaseFinishes() throws {
+        let recorder = HeldDragRecorder()
+        let input = recorder.input()
+        try input.swipe(points: [(0.3, 0.3), (0.6, 0.3), (0.6, 0.6)], duration: 0.12)
+        let turn = try XCTUnwrap(recorder.heldPositions.first { abs($0.y - 0.3 * 2556) > 0.1 })
+        XCTAssertEqual(turn.x, 0.6 * 1180, accuracy: 0.36)
+        XCTAssertEqual(recorder.position.y, 0.6 * 2556, accuracy: 0.36)
+        input.press(x: 0.2, y: 0.2)
+        input.drag(x: 0.5, y: 0.4)
+        input.release(x: 0.7, y: 0.6)
+        try input.type("")
+        XCTAssertEqual(recorder.position.x, 0.7 * 1180, accuracy: 0.36)
+        XCTAssertEqual(recorder.position.y, 0.6 * 2556, accuracy: 0.36)
+        XCTAssertEqual(recorder.buttons, 0)
+    }
+
+    func testInvalidOrMismatchedHeldProfileRejectsOnlyHeldGesturesBeforeReports() throws {
+        for selection in [HeldDragProfile.Selection.invalid("broken file"), .loaded(HeldDragRecorder().profile)] {
+            let recorder = HeldDragRecorder()
+            let input = recorder.input(selection: selection)
+            XCTAssertThrowsError(try input.swipe(points: [(0.3, 0.3), (0.6, 0.6)], duration: 0.12))
+            input.press(x: 0.3, y: 0.3)
+            try input.type("")
+            XCTAssertTrue(recorder.reports.isEmpty)
+            try input.tap(x: 0.3, y: 0.3, hold: 0)
+            try input.move(x: 0.6, y: 0.6)
+            XCTAssertEqual(recorder.presses.count, 1)
+            XCTAssertTrue(recorder.movement.isEmpty)
+            let status = try XCTUnwrap(input.pointerStatus["heldDrag"] as? [String: Any])
+            XCTAssertEqual(status["mode"] as? String, "unavailable")
+        }
+    }
+
+    func testDimensionChangeWhileHeldReleasesAndReportsMismatch() throws {
+        let recorder = HeldDragRecorder()
+        let input = recorder.input()
+        recorder.onReport = {
+            if !recorder.movement.isEmpty { recorder.size = CGSize(width: 2556, height: 1180) }
+        }
+        XCTAssertThrowsError(try input.swipe(points: [(0.3, 0.3), (0.6, 0.6)], duration: 0.12))
+        XCTAssertEqual(recorder.movement.count, 1)
+        XCTAssertEqual(recorder.buttons, 0)
+        XCTAssertEqual(recorder.reports.last?.1, [0, 0, 0, 0])
+        let status = try XCTUnwrap(input.pointerStatus["heldDrag"] as? [String: Any])
+        XCTAssertEqual(status["profileState"] as? String, "mismatch")
+    }
+
+    func testMeasuredProfileLeavesAbsolutePositioningAndLegacyCalibrationSeparate() throws {
+        let recorder = HeldDragRecorder()
+        let input = recorder.input()
+        try input.move(x: 0.3, y: 0.3)
+        recorder.reports = []
+        try input.tap(x: 0.6, y: 0.6, hold: 0)
+        XCTAssertEqual(recorder.reports.map(\.0), [.absolutePointer, .relativeMouse, .relativeMouse])
+        XCTAssertTrue(recorder.movement.isEmpty)
+
+        let calibration = RelativePointerCalibration(
+            host: UUID(), screenWidth: 100, screenHeight: 200, reportInterval: 0.01,
+            distances: [0, 1, 3, 8, 20])
+        var reports: [ReportID] = []
+        let legacy = DeviceInput(
+            host: calibration.host, session: UUID(), calibration: calibration,
+            heldDragProfile: .invalid("does not belong to legacy relative mode"),
+            sleep: { _ in }, reportSender: { id, _ in reports.append(id) })
+        try legacy.swipe(points: [(0.2, 0.2), (0.4, 0.4)], duration: 0.06)
+        XCTAssertTrue(reports.allSatisfy { $0 == .relativeMouse })
+        let status = try XCTUnwrap(legacy.pointerStatus["heldDrag"] as? [String: Any])
+        XCTAssertEqual(status["mode"] as? String, "legacy-relative")
+    }
+}
