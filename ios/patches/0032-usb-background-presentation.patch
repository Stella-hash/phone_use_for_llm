@@ -3,6 +3,49 @@ import XCTest
 @testable import iPhoneUse
 
 final class ControlWindowStateTests: XCTestCase {
+    func testUSBQuietRefusesEveryNativeWindowRequest() {
+        var state = ControlWindowState(mode: .residentQuiet, bluetoothEnabled: false)
+        for devices in [[], ["phone-a"]] {
+            for reason in [ControlWindowUpdateReason.discovery, .userRequest, .resumeDesktopMode] {
+                XCTAssertEqual(state.update(connectedIDs: devices, reason: reason), [])
+                XCTAssertEqual(state.deviceIDs, [])
+                XCTAssertFalse(state.needsWaitingWindow)
+            }
+        }
+    }
+
+    func testUSBDesktopQuietTransitionClosesWithoutExitingAndReopensOnlyInDesktop() {
+        var state = ControlWindowState(mode: .desktop, bluetoothEnabled: false)
+        XCTAssertEqual(state.update(connectedIDs: ["phone-a"]), ["phone-a"])
+        state.setMode(.residentQuiet)
+        XCTAssertFalse(state.permitsNativeWindows)
+        XCTAssertFalse(state.close(deviceID: "phone-a"))
+        XCTAssertEqual(state.update(connectedIDs: ["phone-a"], reason: .userRequest), [])
+        XCTAssertFalse(state.needsWaitingWindow)
+        state.setMode(.desktop)
+        XCTAssertEqual(state.update(connectedIDs: ["phone-a"], reason: .resumeDesktopMode), ["phone-a"])
+        XCTAssertTrue(state.close(deviceID: "phone-a"))
+    }
+
+    func testUSBWaitingPlaceholderDoesNotSurviveQuietTransition() {
+        var state = ControlWindowState(mode: .desktop, bluetoothEnabled: false)
+        _ = state.update(connectedIDs: [])
+        XCTAssertTrue(state.needsWaitingWindow)
+        state.setMode(.residentQuiet)
+        XCTAssertFalse(state.needsWaitingWindow)
+        XCTAssertFalse(state.close(deviceID: nil))
+        XCTAssertEqual(state.update(connectedIDs: ["phone-a"]), [])
+    }
+
+    func testOnlyUSBQuietUsesAccessoryPresentation() {
+        XCTAssertEqual(AppRunMode.residentQuiet.activationPolicy(bluetoothEnabled: false), .accessory)
+        XCTAssertFalse(AppRunMode.residentQuiet.permitsNativeWindows(bluetoothEnabled: false))
+        for (mode, bluetooth) in [(AppRunMode.desktop, false), (.desktop, true), (.residentQuiet, true)] {
+            XCTAssertEqual(mode.activationPolicy(bluetoothEnabled: bluetooth), .regular)
+            XCTAssertTrue(mode.permitsNativeWindows(bluetoothEnabled: bluetooth))
+        }
+    }
+
