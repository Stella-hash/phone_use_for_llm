diff --git a/Tests/iPhoneUseTests/Input/DeviceClipboardTests.swift b/Tests/iPhoneUseTests/Input/DeviceClipboardTests.swift
new file mode 100644
index 0000000..fff7168
--- /dev/null
+++ b/Tests/iPhoneUseTests/Input/DeviceClipboardTests.swift
@@ -0,0 +1,107 @@
+import Foundation
+import XCTest
+
+@testable import iPhoneUse
+
+final class DeviceClipboardTests: XCTestCase {
+    private let deviceID = "00000000-0000000000000001"
+
+    private func temporary() throws -> URL {
+        let directory = FileManager.default.temporaryDirectory
+            .appendingPathComponent("iphone-use-clipboard-test-\(UUID().uuidString)")
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: false)
+        addTeardownBlock { try? FileManager.default.removeItem(at: directory) }
+        return directory
+    }
+
+    private func helper(_ script: String, in directory: URL) throws -> [String: String] {
+        let executable = directory.appendingPathComponent("helper")
+        try Data(("#!/bin/sh\n" + script).utf8).write(to: executable)
+        try FileManager.default.setAttributes([.posixPermissions: 0o700], ofItemAtPath: executable.path)
+        return [DeviceClipboard.pythonKey: executable.path, DeviceClipboard.deviceKey: deviceID]
+    }
+
+    func testConfiguredDefaultIsLiteralAndExplicitFalsePreservesHID() throws {
+        let literal = try TypeTextRequest(["text": "中文 🧩\né"], deviceClipboardConfigured: true)
+        XCTAssertFalse(literal.ensureChineseIME)
+        XCTAssertEqual(literal.actions.first?.body["use_clipboard"] as? Bool, true)
+        let hid = try TypeTextRequest(["text": "abc", "use_clipboard": false], deviceClipboardConfigured: true)
+        XCTAssertNil(hid.actions.first?.body["use_clipboard"])
+        XCTAssertThrowsError(
+            try TypeTextRequest(["text": "🧩", "use_clipboard": false], deviceClipboardConfigured: true))
+        XCTAssertThrowsError(try TypeTextRequest(["text": "🧩"], deviceClipboardConfigured: false))
+        XCTAssertNoThrow(try TypeTextRequest(["text": "🧩", "use_clipboard": true], deviceClipboardConfigured: false))
+    }
+
+    func testPartialConfigurationCannotFallBackToAnotherClipboard() throws {
+        XCTAssertFalse(DeviceClipboard.isConfigured(environment: [:]))
+        for environment in [
+            [DeviceClipboard.pythonKey: "/missing/python"],
+            [DeviceClipboard.deviceKey: deviceID],
+            [DeviceClipboard.pythonKey: "relative/python", DeviceClipboard.deviceKey: deviceID],
+            [DeviceClipboard.pythonKey: "/missing/python", DeviceClipboard.deviceKey: ""],
+            [DeviceClipboard.pythonKey: "/missing/python", DeviceClipboard.deviceKey: "another phone"],
+        ] {
+            XCTAssertTrue(DeviceClipboard.isConfigured(environment: environment))
+            XCTAssertThrowsError(try DeviceClipboard.Configuration(environment: environment))
+        }
+    }
+
+    func testExactUTF8TravelsThroughStdinWithOneFixedTargetAndNoShellExpansion() throws {
+        let directory = try temporary()
+        let text = "E 中文 🧩 — café\n$HOME `touch do-not-create` \"quote\""
+        let environment = try helper(
+            "/bin/cat > '\(directory.path)/payload'\n"
+                + "printf '%s\\n' \"$@\" > '\(directory.path)/arguments'\n"
+                + "printf '%s' \"$PYMOBILEDEVICE3_UDID\" > '\(directory.path)/target'\n"
+                + "printf '%s' \"$PYMOBILEDEVICE3_NATIVE\" > '\(directory.path)/native'\n",
+            in: directory
+        )
+        .merging(["PYMOBILEDEVICE3_UDID": "wrong", "PYMOBILEDEVICE3_NATIVE": "1"]) { _, new in new }
+        try DeviceClipboard.write(text, environment: environment)
+        XCTAssertEqual(try Data(contentsOf: directory.appendingPathComponent("payload")), Data(text.utf8))
+        XCTAssertEqual(try String(contentsOf: directory.appendingPathComponent("target"), encoding: .utf8), deviceID)
+        XCTAssertEqual(try String(contentsOf: directory.appendingPathComponent("native"), encoding: .utf8), "")
+        let arguments = try String(contentsOf: directory.appendingPathComponent("arguments"), encoding: .utf8)
+        XCTAssertEqual(arguments, "-m\npymobiledevice3\ndeveloper\ncore-device\ncopy\n--userspace\n")
+        XCTAssertFalse(arguments.contains(text))
+    }
+
+    func testHelperFailurePrecedesClearAndPasteReports() throws {
+        let environment = try helper("printf 'service unavailable' >&2\nexit 7\n", in: temporary())
+        var reports = 0
+        let input = DeviceInput(host: UUID(), session: UUID(), sleep: { _ in }, reportSender: { _, _ in reports += 1 })
+        let request = try TypeTextRequest(
+            ["text": "中文 🧩", "clear_before": true, "press_enter": true], deviceClipboardConfigured: true)
+        XCTAssertThrowsError(
+            try request.perform(on: input, clipboard: { try DeviceClipboard.write($0, environment: environment) })
+        ) { error in
+            XCTAssertTrue(String(describing: error).contains("service unavailable"))
+        }
+        XCTAssertEqual(reports, 0)
+    }
+
+    func testTimeoutIsBoundedAndDoesNotRetryTheHelper() throws {
+        let directory = try temporary()
+        let environment = try helper(
+            "printf 'called\\n' >> '\(directory.path)/calls'\nexec /bin/sleep 5\n", in: directory)
+        let started = ProcessInfo.processInfo.systemUptime
+        XCTAssertThrowsError(try DeviceClipboard.write("text", environment: environment, timeout: 0.2)) {
+            XCTAssertTrue(String(describing: $0).contains("delivery is uncertain"))
+        }
+        XCTAssertLessThan(ProcessInfo.processInfo.systemUptime - started, 3)
+        // Under a busy test runner the deadline can precede the child's main.
+        // If it did run, there must be only one invocation, never a retry.
+        let calls = (try? String(contentsOf: directory.appendingPathComponent("calls"), encoding: .utf8)) ?? ""
+        XCTAssertTrue(calls.isEmpty || calls == "called\n")
+    }
+
+    func testLongUnicodePayloadIsNotRestrictedByAnInventedServiceLimit() throws {
+        let directory = try temporary()
+        let environment = try helper("/bin/cat > '\(directory.path)/payload'\n", in: directory)
+        let text = String(repeating: "中文🧩\n", count: 1000)
+        XCTAssertGreaterThan(text.utf16.count, 4096)
+        try DeviceClipboard.write(text, environment: environment)
+        XCTAssertEqual(try Data(contentsOf: directory.appendingPathComponent("payload")), Data(text.utf8))
+    }
+}
