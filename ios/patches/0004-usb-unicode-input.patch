new file mode 100644
index 0000000..87aa594
--- /dev/null
+++ b/Sources/iPhoneUse/Input/DeviceClipboard.swift
@@ -0,0 +1,106 @@
+import Darwin
+import Foundation
+
+/// Literal UTF-8 delivery to the selected phone's clipboard. This changes the
+/// phone clipboard, not an accessibility field value. Cmd+V and observation are
+/// separate steps; a successful service reply does not verify the focused field.
+enum DeviceClipboard {
+    static let pythonKey = "IPHONE_USE_USB_CLIPBOARD_PYTHON"
+    static let deviceKey = "IPHONE_USE_USB_DEVICE_ID"
+
+    static var isConfigured: Bool { isConfigured(environment: ProcessInfo.processInfo.environment) }
+
+    static func isConfigured(environment: [String: String]) -> Bool {
+        environment[pythonKey] != nil || environment[deviceKey] != nil
+    }
+
+    struct Configuration {
+        let python: URL
+        let deviceID: String
+
+        init(environment: [String: String]) throws {
+            guard let python = environment[pythonKey], python.hasPrefix("/"),
+                !python.contains("\0"), let deviceID = environment[deviceKey],
+                deviceID.range(of: "^(?:[0-9A-Fa-f]{8}-[0-9A-Fa-f]{16}|[0-9A-Fa-f]{40})$", options: .regularExpression)
+                    != nil
+            else {
+                throw DeviceError("USB clipboard requires an absolute Python path and the exact physical iPhone UDID")
+            }
+            self.python = URL(fileURLWithPath: python)
+            self.deviceID = deviceID
+        }
+
+        var arguments: [String] { ["-m", "pymobiledevice3", "developer", "core-device", "copy", "--userspace"] }
+
+        func childEnvironment(_ inherited: [String: String]) -> [String: String] {
+            // Do not let a shell's tunnel or native-transport override select a
+            // different service route. --userspace and this exact ID are fixed.
+            var result = inherited.filter { !$0.key.hasPrefix("PYMOBILEDEVICE3_") }
+            result["PYMOBILEDEVICE3_UDID"] = deviceID
+            result["PYMOBILEDEVICE3_USERSPACE"] = "1"
+            return result
+        }
+    }
+
+    static func write(
+        _ text: String, environment: [String: String] = ProcessInfo.processInfo.environment,
+        timeout: TimeInterval = 10
+    ) throws {
+        let configuration = try Configuration(environment: environment)
+        guard timeout.isFinite, timeout > 0 else { throw DeviceError("USB clipboard timeout must be positive") }
+        guard FileManager.default.isExecutableFile(atPath: configuration.python.path) else {
+            throw DeviceError("USB clipboard Python is unavailable; run the configured USB setup before typing")
+        }
+
+        // A private, short-lived stdin file avoids pipe backpressure and SIGPIPE
+        // if the helper rejects its configuration before reading input. Text is
+        // never a command argument, shell command, or diagnostic log entry.
+        let directory = FileManager.default.temporaryDirectory
+            .appendingPathComponent("iphone-use-device-clipboard-\(UUID().uuidString)")
+        try FileManager.default.createDirectory(
+            at: directory, withIntermediateDirectories: false, attributes: [.posixPermissions: 0o700])
+        defer { try? FileManager.default.removeItem(at: directory) }
+        let inputURL = directory.appendingPathComponent("stdin")
+        let errorURL = directory.appendingPathComponent("stderr")
+        guard
+            FileManager.default.createFile(
+                atPath: inputURL.path, contents: Data(text.utf8), attributes: [.posixPermissions: 0o600]),
+            FileManager.default.createFile(
+                atPath: errorURL.path, contents: nil, attributes: [.posixPermissions: 0o600])
+        else { throw DeviceError("Could not prepare USB clipboard input") }
+        let input = try FileHandle(forReadingFrom: inputURL)
+        let diagnostic = try FileHandle(forWritingTo: errorURL)
+        defer {
+            try? input.close()
+            try? diagnostic.close()
+        }
+
+        let process = Process()
+        process.executableURL = configuration.python
+        process.arguments = configuration.arguments
+        process.environment = configuration.childEnvironment(environment)
+        process.standardInput = input
+        process.standardOutput = FileHandle.nullDevice
+        process.standardError = diagnostic
+        let finished = DispatchSemaphore(value: 0)
+        process.terminationHandler = { _ in finished.signal() }
+        do { try process.run() } catch {
+            throw DeviceError("Could not start USB clipboard helper: \(error.localizedDescription)")
+        }
+        guard finished.wait(timeout: .now() + timeout) == .success else {
+            // Stop only this helper. Do not switch transports or repeat SET.
+            if process.isRunning { process.terminate() }
+            if finished.wait(timeout: .now() + 1) == .timedOut {
+                if process.isRunning { kill(process.processIdentifier, SIGKILL) }
+                _ = finished.wait(timeout: .now() + 1)
+            }
+            throw DeviceError("USB clipboard timed out; delivery is uncertain. No paste or clear keys were sent")
+        }
+        guard process.terminationReason == .exit, process.terminationStatus == 0 else {
+            let detail = (try? String(contentsOf: errorURL, encoding: .utf8)) ?? ""
+            let bounded = String(detail.trimmingCharacters(in: .whitespacesAndNewlines).prefix(1200))
+            throw DeviceError(
+                "USB clipboard failed (\(process.terminationStatus)); no paste or clear keys were sent. \(bounded)")
+        }
+    }
+}
