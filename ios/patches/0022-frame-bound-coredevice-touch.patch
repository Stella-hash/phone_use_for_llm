diff --git a/Sources/iPhoneUse/Input/CoreDeviceTouch.swift b/Sources/iPhoneUse/Input/CoreDeviceTouch.swift
new file mode 100644
index 0000000..d0d040f
--- /dev/null
+++ b/Sources/iPhoneUse/Input/CoreDeviceTouch.swift
@@ -0,0 +1,212 @@
+import Darwin
+import Foundation
+
+/// Serialize HTTP input for one phone across transports. Observation remains
+/// independent so the helper can be checked against the resident capture.
+enum DeviceCommandLocks {
+    private static let lock = NSLock()
+    private static var devices: [String: NSLock] = [:]
+    static func acquire(_ device: String) -> NSLock {
+        let selected = lock.withLock { () -> NSLock in
+            if let existing = devices[device] { return existing }
+            let created = NSLock(); devices[device] = created; return created
+        }
+        selected.lock()
+        return selected
+    }
+}
+
+/// A finite full-contact program, validated before either the helper or input
+/// transport is opened. Pixel bounds are supplied by the consumed frame.
+struct TouchSequenceRequest {
+    let samples: [[String: Any]]
+
+    init(_ body: [String: Any], image: (Int, Int)? = nil) throws {
+        guard let samples = body["samples"] as? [[String: Any]], (2...256).contains(samples.count) else {
+            throw InputRequestError("samples must contain 2...256 contact frames")
+        }
+        var previous = -1.0
+        for sample in samples {
+            guard Set(sample.keys) == ["at_ms", "contacts"],
+                let contacts = sample["contacts"] as? [[String: Any]], contacts.count <= 5
+            else { throw InputRequestError("Each sample requires at_ms and at most five contacts") }
+            let at = try InputRequestValue.number(sample["at_ms"], field: "at_ms")
+            guard (0...6000).contains(at), at > previous else {
+                throw InputRequestError("Sample times must strictly increase within 0...6000 ms")
+            }
+            previous = at
+            var used: Set<Int> = []
+            for contact in contacts {
+                guard Set(contact.keys) == ["id", "x", "y"] else { throw InputRequestError("Expected id, x and y") }
+                let id = try InputRequestValue.number(contact["id"], field: "id")
+                guard (0...4).contains(id), id.rounded() == id, used.insert(Int(id)).inserted else {
+                    throw InputRequestError("Contact IDs must be unique integers 0...4")
+                }
+                var point = contact
+                if let image { point["width"] = image.0; point["height"] = image.1 }
+                _ = try CoordinateRequest(point)
+            }
+        }
+        guard try InputRequestValue.number(samples[0]["at_ms"], field: "at_ms") == 0,
+            !(samples[0]["contacts"] as! [[String: Any]]).isEmpty,
+            (samples.last!["contacts"] as! [[String: Any]]).isEmpty
+        else { throw InputRequestError("Start with contact at zero; finish with all contacts lifted") }
+        self.samples = samples
+    }
+
+    static func gesture(path: String, body: [String: Any]) throws -> TouchSequenceRequest {
+        func frame(_ at: Double, _ x: Double, _ y: Double) -> [String: Any] {
+            ["at_ms": at, "contacts": [["id": 0, "x": x, "y": y]]]
+        }
+        if path == "/tap" {
+            let hold = try HoldRequest(body).seconds
+            guard hold > 0, hold <= 6 else { throw InputRequestError("Direct touch hold must be >0 and <=6 seconds") }
+            return try Self(["samples": [
+                frame(0, InputRequestValue.number(body["x"], field: "x"), InputRequestValue.number(body["y"], field: "y")),
+                ["at_ms": hold * 1000, "contacts": []],
+            ]])
+        }
+        guard path == "/swipe", let points = body["points"] as? [[String: Any]], points.count >= 2 else {
+            throw InputRequestError("Unsupported direct-touch gesture")
+        }
+        let duration = try InputRequestValue.number(body["duration"] ?? 0.3, field: "duration")
+        guard duration > 0, duration <= 5.999 else { throw InputRequestError("Direct swipe duration must be >0 and <=5.999 seconds") }
+        let xy = try points.map { (try InputRequestValue.number($0["x"], field: "x"), try InputRequestValue.number($0["y"], field: "y")) }
+        var distances = [0.0]
+        for i in 1..<xy.count { distances.append(distances.last! + hypot(xy[i].0-xy[i-1].0, xy[i].1-xy[i-1].1)) }
+        let count = min(254, max(1, Int(ceil(duration * 60))))
+        var samples: [[String: Any]] = []
+        for i in 0...count {
+            let fraction = Double(i) / Double(count), target = distances.last! * fraction
+            var segment = 1
+            while segment < distances.count - 1, distances[segment] < target { segment += 1 }
+            let length = distances[segment] - distances[segment-1]
+            let part = length > 0 ? (target - distances[segment-1]) / length : 0
+            let a = xy[segment-1], b = xy[segment]
+            samples.append(frame(duration * 1000 * fraction, a.0+(b.0-a.0)*part, a.1+(b.1-a.1)*part))
+        }
+        samples.append(["at_ms": duration * 1000 + 1, "contacts": []])
+        return try Self(["samples": samples])
+    }
+}
+
+/// The same owned child performs USB preflight and touch. It cannot send its
+/// first contact until the host rechecks the capture reference and commits.
+/// No media session, BLE fallback, automatic pairing or uncertain-action retry.
+enum CoreDeviceTouch {
+    static let helperKey = "IPHONE_USE_TOUCH_HELPER"
+    static var isConfigured: Bool { ProcessInfo.processInfo.environment[helperKey] != nil }
+
+    static func perform(
+        _ program: TouchSequenceRequest, reference: ScreenshotReferences.Reference,
+        environment: [String: String] = ProcessInfo.processInfo.environment,
+        beforeCommit: (DeviceDisplayMapping) throws -> Void
+    ) throws -> [String: Any] {
+        guard let helper = environment[helperKey], helper.hasPrefix("/"), !helper.contains("\0"),
+            environment["IPHONE_USE_DEVICE_ID"] == reference.device else {
+            throw InputRequestError("Direct touch requires the configured helper and exact capture device")
+        }
+        let configuration = try DeviceClipboard.Configuration(environment: environment)
+        _ = try TouchSequenceRequest(["samples": program.samples], image: (reference.width, reference.height))
+        let plan: [String: Any] = ["image": ["width": reference.width, "height": reference.height], "samples": program.samples]
+        let data = try JSONSerialization.data(withJSONObject: plan)
+        guard data.count <= 65536 else { throw InputRequestError("Touch program exceeds 64 KiB") }
+        let directory = FileManager.default.temporaryDirectory.appendingPathComponent("iphone-use-touch-\(UUID().uuidString)")
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: false, attributes: [.posixPermissions: 0o700])
+        defer { try? FileManager.default.removeItem(at: directory) }
+        let stdinURL = directory.appendingPathComponent("plan.json")
+        let stdoutURL = directory.appendingPathComponent("receipt.jsonl")
+        let commitURL = directory.appendingPathComponent("commit.json")
+        guard FileManager.default.createFile(atPath: stdinURL.path, contents: data, attributes: [.posixPermissions: 0o600]),
+            FileManager.default.createFile(atPath: stdoutURL.path, contents: nil, attributes: [.posixPermissions: 0o600]) else {
+            throw InputRequestError("Cannot prepare direct-touch helper files")
+        }
+        let input = try FileHandle(forReadingFrom: stdinURL), output = try FileHandle(forWritingTo: stdoutURL)
+        defer { try? input.close(); try? output.close() }
+        let process = Process(), finished = DispatchSemaphore(value: 0)
+        process.executableURL = configuration.python
+        process.arguments = ["-B", helper, "--commit-file", commitURL.path]
+        process.environment = configuration.childEnvironment(environment)
+        process.standardInput = input; process.standardOutput = output; process.standardError = FileHandle.nullDevice
+        process.terminationHandler = { _ in finished.signal() }
+        var committed = false
+        defer {
+            if process.isRunning {
+                process.terminate()
+                if finished.wait(timeout: .now() + 7) == .timedOut, process.isRunning {
+                    kill(process.processIdentifier, SIGKILL)
+                    _ = finished.wait(timeout: .now() + 1)
+                }
+            }
+        }
+        func failure(_ reason: String) -> [String: Any] {
+            ["backend": "coredevice", "input_status": committed ? "unconfirmed" : "not_sent", "reason": reason,
+             "frame_bound": true, "orientation_bound": false, "device_delivery": "unverified", "application_effect": "unverified"]
+        }
+        func messages() throws -> [[String: Any]] {
+            let file = try FileHandle(forReadingFrom: stdoutURL)
+            defer { try? file.close() }
+            let data = try file.read(upToCount: 65537) ?? Data()
+            guard data.count <= 65536 else { throw InputRequestError("Touch receipt exceeds byte limit") }
+            // The child flushes complete JSON lines; retain no partial tail.
+            guard let newline = data.lastIndex(of: 10) else { return [] }
+            let lines = data[..<newline].split(separator: 10, omittingEmptySubsequences: false)
+            return try lines.map {
+                guard let value = try JSONSerialization.jsonObject(with: Data($0)) as? [String: Any] else {
+                    throw InputRequestError("Invalid touch protocol record")
+                }
+                return value
+            }
+        }
+        func exchange() throws -> [String: Any] {
+        do { try process.run() } catch { return failure("Touch helper did not start") }
+        let readyDeadline = ProcessInfo.processInfo.systemUptime + 8
+        var ready: [String: Any]?
+        while ProcessInfo.processInfo.systemUptime < readyDeadline {
+            if let value = try messages().first(where: { $0["phase"] as? String == "ready" }) { ready = value; break }
+            if !process.isRunning { break }
+            Thread.sleep(forTimeInterval: 0.01)
+        }
+        if let ready, let display = ready["display"] as? [String: Any] {
+            let mapping = try DeviceDisplayMapping(result: ["schema_version": 1, "source": "ios-native-display", "status": "ok",
+                "device_id": configuration.deviceID, "display": display], deviceID: configuration.deviceID)
+            try mapping.validate(captureSize: CGSize(width: reference.screenWidth, height: reference.screenHeight))
+            try beforeCommit(mapping)
+            // Once offered, interruption is uncertain even if no final receipt arrives.
+            committed = true
+            let pending = directory.appendingPathComponent("commit.pending")
+            guard FileManager.default.createFile(atPath: pending.path, contents: Data("{\"commit\":true}".utf8),
+                attributes: [.posixPermissions: 0o600]), rename(pending.path, commitURL.path) == 0
+            else { return failure("Could not commit touch program") }
+            if finished.wait(timeout: .now() + 15) == .timedOut { return failure("Touch helper timed out after commit; do not replay") }
+        } else if process.isRunning {
+            return failure("Touch preflight did not become ready")
+        }
+        guard var receipt = try messages().last(where: { $0["schema_version"] as? Int == 1 }),
+            let status = receipt["input_status"] as? String, ["not_sent", "sent_unverified", "unconfirmed"].contains(status) else {
+            return failure("Touch helper ended without a valid receipt")
+        }
+        if !committed && (status != "not_sent" || (receipt["reports_attempted"] as? Int ?? 0) != 0) {
+            // A contradictory child cannot establish either validated input or
+            // absence of input. Preserve uncertainty rather than trust success.
+            var rejected = failure("Helper reported input without the host commit")
+            rejected["input_status"] = "unconfirmed"; rejected["frame_bound"] = false
+            return rejected
+        }
+        if status == "sent_unverified", receipt["host_commit_received"] as? Bool != true {
+            return failure("Helper did not confirm the host commit; do not replay")
+        }
+        if process.terminationReason != .exit || process.terminationStatus != 0 {
+            receipt["input_status"] = committed ? "unconfirmed" : "not_sent"
+        }
+        receipt.removeValue(forKey: "reports")
+        receipt["backend"] = "coredevice"; receipt["frame_bound"] = true; receipt["orientation_bound"] = false
+        return receipt
+        }
+        do { return try exchange() }
+        catch {
+            if committed { return failure("Touch receipt failed after commit; do not replay") }
+            throw error
+        }
+    }
+}
