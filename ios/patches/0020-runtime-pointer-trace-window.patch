diff --git a/Sources/iPhoneUse/Bluetooth/PointerTraceWindow.swift b/Sources/iPhoneUse/Bluetooth/PointerTraceWindow.swift
new file mode 100644
index 0000000..aa0fcdf
--- /dev/null
+++ b/Sources/iPhoneUse/Bluetooth/PointerTraceWindow.swift
@@ -0,0 +1,81 @@
+import Foundation
+import CoreFoundation
+
+/// Diagnostic admission only: owns no input queue, capture or Bluetooth state.
+/// Writers run under this lock so disable cannot return while a row is being
+/// written. They must never call back into this object or query input state.
+final class PointerTraceWindow {
+    static let maximumSeconds = 300
+    private let lock = NSLock()
+    private let now: () -> TimeInterval
+    private var window: (id: String, deadline: TimeInterval)?
+
+    init(startupEnabled: Bool = false, now: @escaping () -> TimeInterval = { ProcessInfo.processInfo.systemUptime }) {
+        self.now = now
+        if startupEnabled {
+            window = (UUID().uuidString, now() + Double(Self.maximumSeconds))
+        }
+    }
+
+    var enabled: Bool { lock.withLock { current(at: now()) != nil } }
+
+    func status() -> [String: Any] {
+        lock.withLock { snapshot(at: now()) }
+    }
+
+    /// Zero disables even a window enabled by the legacy startup environment.
+    /// Each positive request opens a new window; old pending reports cannot join it.
+    func configure(seconds: Int) -> [String: Any] {
+        precondition((0...Self.maximumSeconds).contains(seconds))
+        return lock.withLock {
+            let time = now()
+            window = seconds == 0 ? nil : (UUID().uuidString, time + Double(seconds))
+            return snapshot(at: time)
+        }
+    }
+
+    @discardableResult
+    func begin(_ write: (String, TimeInterval) -> Void) -> String? {
+        lock.withLock {
+            let time = now()
+            guard let active = current(at: time) else { return nil }
+            let id = active.id + "/" + UUID().uuidString
+            write(id, time)
+            return id
+        }
+    }
+
+    /// nil is for an independent lifecycle diagnostic, never an untraced report.
+    func record(traceID: String?, _ write: (TimeInterval) -> Void) {
+        lock.withLock {
+            let time = now()
+            guard let active = current(at: time) else { return }
+            if let traceID, !traceID.hasPrefix(active.id + "/") { return }
+            write(time)
+        }
+    }
+
+    private func current(at time: TimeInterval) -> (id: String, deadline: TimeInterval)? {
+        if let active = window, time >= active.deadline { window = nil }
+        return window
+    }
+
+    private func snapshot(at time: TimeInterval) -> [String: Any] {
+        guard let active = current(at: time) else { return ["enabled": false, "remaining_seconds": 0] }
+        return ["enabled": true, "window_id": active.id, "expires_at_uptime": active.deadline,
+                "remaining_seconds": max(0, active.deadline - time)]
+    }
+
+    static func requestedSeconds(_ body: [String: Any]) throws -> Int {
+        guard Set(body.keys) == ["seconds"], let number = body["seconds"] as? NSNumber,
+            CFGetTypeID(number) != CFBooleanGetTypeID(), number.doubleValue.isFinite,
+            number.doubleValue.rounded(.towardZero) == number.doubleValue,
+            (0...Double(maximumSeconds)).contains(number.doubleValue)
+        else { throw RequestError() }
+        return number.intValue
+    }
+
+    struct RequestError: Error, CustomStringConvertible {
+        var description: String { "pointer trace requires only integer seconds from 0 to 300; 0 disables" }
+    }
+}
