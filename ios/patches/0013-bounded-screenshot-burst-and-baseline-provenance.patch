--- /dev/null
+++ b/Tests/iPhoneUseTests/MCP/MCPScreenshotBurstTests.swift
@@ -0,0 +1,162 @@
+import Foundation
+import XCTest
+
+@testable import iPhoneUse
+
+final class MCPScreenshotBurstTests: XCTestCase {
+    private func sample(
+        sequence: UInt64, at: TimeInterval, source: String = "capture-1", device: String = "phone-1",
+        metadata: Bool = true, image: Data = Data([1, 2, 3])
+    ) -> MCPServer.ObservationFrame {
+        MCPServer.ObservationFrame(
+            image: image, device: device, width: "462", height: "1000", mimeType: "image/png",
+            identity: metadata ? MCPServer.FrameIdentity(source: source, sequence: sequence, receivedAt: at) : nil,
+            signature: "same-pixels")
+    }
+
+    func testBoundedReadOnlySchemaMatchesValidation() throws {
+        let options = try MCPScreenshotBurst.Options([:])
+        XCTAssertEqual(options.frames, 3)
+        XCTAssertEqual(options.intervalMilliseconds, 300)
+        for invalid: [String: Any] in [
+            ["frames": 1], ["frames": 7], ["frames": 2.5], ["frames": true], ["frames": "3"],
+            ["interval_ms": 99], ["interval_ms": 1001], ["interval_ms": Double.nan],
+            ["interval_ms": false], ["device": 7], ["observe": "none"],
+        ] { XCTAssertThrowsError(try MCPScreenshotBurst.Options(invalid)) }
+        for language: AppLanguage in [.en, .zh] {
+            let tool = try XCTUnwrap(MCPToolCatalog.tools(for: language).first { $0["name"] as? String == "screenshot_burst" })
+            XCTAssertEqual((tool["annotations"] as? [String: Bool])?["readOnlyHint"], true)
+            let schema = try XCTUnwrap(tool["inputSchema"] as? [String: Any])
+            let properties = try XCTUnwrap(schema["properties"] as? [String: [String: Any]])
+            XCTAssertEqual(schema["additionalProperties"] as? Bool, false)
+            XCTAssertEqual(properties["frames"]?["maximum"] as? Int, 6)
+            XCTAssertEqual(properties["interval_ms"]?["minimum"] as? Int, 100)
+            XCTAssertNil(properties["observe"])
+            XCTAssertNotNil(properties["device_id"])
+        }
+        XCTAssertNil(try MCPToolRequest.action(named: "screenshot_burst", arguments: [:], longEdge: 1000))
+    }
+
+    func testFreshIdenticalPixelsRemainDistinctOrderedSamplesWithActualGaps() throws {
+        var clock: TimeInterval = 10
+        var sequence: UInt64 = 0
+        let result = MCPScreenshotBurst.collect(
+            options: try MCPScreenshotBurst.Options([:]), device: "phone-1",
+            sleep: { clock += $0 }, now: { clock }, frame: { remaining in
+                XCTAssertGreaterThan(remaining, 0)
+                sequence += 1; clock += 0.01
+                return self.sample(sequence: sequence, at: clock)
+            })
+        XCTAssertTrue(result.complete)
+        XCTAssertEqual(result.samples.count, 3)
+        XCTAssertEqual(Set(result.samples.map { $0.frame.identity!.sequence }).count, 3)
+        XCTAssertEqual(Set(result.samples.map { $0.frame.signature }).count, 1)
+        let frames = try XCTUnwrap(result.json["frames"] as? [[String: Any]])
+        XCTAssertEqual(frames.map { $0["index"] as? Int }, [1, 2, 3])
+        XCTAssertEqual(frames.dropFirst().map { $0["capture_gap_ms"] as? Int }, [310, 310])
+        XCTAssertEqual(result.elapsed, 0.63, accuracy: 0.0001)
+    }
+
+    func testOldAndDuplicateCapturesAreOmittedWithoutHidingAValidSourceRestart() throws {
+        var clock: TimeInterval = 10
+        var reads = 0
+        var first: MCPServer.ObservationFrame?
+        let result = MCPScreenshotBurst.collect(
+            options: try MCPScreenshotBurst.Options(["frames": 2, "interval_ms": 100]), device: "phone-1",
+            sleep: { clock += $0 }, now: { clock }, frame: { _ in
+                reads += 1; clock += 0.01
+                if reads == 1 { return self.sample(sequence: 98, at: 9.9) }
+                if reads == 2 { first = self.sample(sequence: 99, at: clock); return first! }
+                if reads == 3 { return first! }
+                return self.sample(sequence: 1, at: clock, source: "capture-restarted")
+            })
+        XCTAssertTrue(result.complete)
+        XCTAssertEqual(reads, 4)
+        XCTAssertEqual(result.discardedSamples, 2)
+        XCTAssertEqual(result.samples.map { $0.frame.identity?.source }, ["capture-1", "capture-restarted"])
+    }
+
+    func testFrozenCaptureEndsAtSamplingDeadlineWithNoRepeatedImages() throws {
+        let result = MCPScreenshotBurst.collect(
+            options: try MCPScreenshotBurst.Options([:]), device: "phone-1", sleep: { _ in }, now: { 10 },
+            frame: { _ in self.sample(sequence: 1, at: 9.9) })
+        XCTAssertFalse(result.complete)
+        XCTAssertTrue(result.samples.isEmpty)
+        XCTAssertEqual(result.reason, "sampling_deadline")
+        XCTAssertEqual(result.elapsed, MCPScreenshotBurst.samplingBudget, accuracy: 0.0001)
+        XCTAssertLessThanOrEqual(result.discardedSamples, 121)
+    }
+
+    func testUnavailableCapturePreservesEarlierSamplesAndReportsPartialFailure() throws {
+        var clock: TimeInterval = 10
+        var reads = 0
+        let result = MCPScreenshotBurst.collect(
+            options: try MCPScreenshotBurst.Options([:]), device: "phone-1",
+            sleep: { clock += $0 }, now: { clock }, frame: { _ in
+                reads += 1; clock += 0.01
+                if reads > 1 { throw MCPServer.MCPError("capture stopped") }
+                return self.sample(sequence: 1, at: clock)
+            })
+        XCTAssertEqual(reads, 2, "capture errors are not retried")
+        XCTAssertEqual(result.samples.count, 1)
+        XCTAssertEqual(result.reason, "capture_unavailable")
+        XCTAssertEqual(result.json["status"] as? String, "partial")
+        XCTAssertEqual(MCPScreenshotBurst.content(result, device: "phone-1", includeImage: true)["isError"] as? Bool, true)
+    }
+
+    func testMissingForeignMalformedOrFutureFramesStopBeforeImagesAreAccepted() throws {
+        let cases: [(MCPServer.ObservationFrame, String)] = [
+            (sample(sequence: 1, at: 10.01, metadata: false), "missing_frame_metadata"),
+            (sample(sequence: 1, at: 10.01, device: "other"), "capture_device_mismatch"),
+            (sample(sequence: 1, at: 10.01, image: Data()), "invalid_frame"),
+            (sample(sequence: 1, at: 11), "invalid_frame_timestamp"),
+        ]
+        for (frame, reason) in cases {
+            var clock: TimeInterval = 10
+            var reads = 0
+            let result = MCPScreenshotBurst.collect(
+                options: try MCPScreenshotBurst.Options([:]), device: "phone-1",
+                sleep: { clock += $0 }, now: { clock }, frame: { _ in reads += 1; clock += 0.01; return frame })
+            XCTAssertEqual(result.reason, reason)
+            XCTAssertEqual(reads, 1)
+            XCTAssertTrue(result.samples.isEmpty)
+        }
+    }
+
+    func testImageBudgetStopsBeforeAppendingAnOversizedSequence() throws {
+        var clock: TimeInterval = 10
+        var reads = 0
+        let result = MCPScreenshotBurst.collect(
+            options: try MCPScreenshotBurst.Options(["frames": 2]), device: "phone-1",
+            sleep: { clock += $0 }, now: { clock }, frame: { _ in
+                reads += 1; clock += 0.01
+                return self.sample(
+                    sequence: UInt64(reads), at: clock,
+                    image: reads == 1 ? Data([1]) : Data(repeating: 2, count: MCPScreenshotBurst.imageByteBudget))
+            })
+        XCTAssertEqual(result.samples.count, 1)
+        XCTAssertEqual(result.reason, "image_byte_budget")
+        XCTAssertEqual(result.json["status"] as? String, "partial")
+    }
+
+    func testOrderedCaptionsPrecedeImagesAndMetadataOnlyModeOmitsImagePayloads() throws {
+        var clock: TimeInterval = 10
+        var sequence: UInt64 = 0
+        let result = MCPScreenshotBurst.collect(
+            options: try MCPScreenshotBurst.Options(["frames": 2]), device: "phone-1",
+            sleep: { clock += $0 }, now: { clock }, frame: { _ in
+                sequence += 1; clock += 0.01
+                return self.sample(sequence: sequence, at: clock)
+            })
+        for includeImage in [false, true] {
+            let content = MCPScreenshotBurst.content(result, device: "phone-1", includeImage: includeImage)
+            XCTAssertNil(content["isError"])
+            let blocks = try XCTUnwrap(content["content"] as? [[String: Any]])
+            XCTAssertEqual(blocks.filter { $0["type"] as? String == "image" }.count, includeImage ? 2 : 0)
+            XCTAssertTrue(try XCTUnwrap(blocks[1]["text"] as? String).hasPrefix("Frame 1/2, capture +10 ms"))
+            if includeImage {
+                XCTAssertEqual(blocks.map { $0["type"] as? String }, ["text", "text", "image", "text", "image"])
+            }
+        }
+    }
+}
