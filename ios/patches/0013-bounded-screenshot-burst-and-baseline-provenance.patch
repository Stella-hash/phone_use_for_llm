new file mode 100644
index 0000000..cf36022
--- /dev/null
+++ b/Sources/iPhoneUse/MCP/MCPScreenshotBurst.swift
@@ -0,0 +1,163 @@
+import CoreFoundation
+import Foundation
+
+/// A short observation sequence, not a video stream or an input loop. The
+/// existing capture identity distinguishes new samples even when pixels match.
+enum MCPScreenshotBurst {
+    static let samplingBudget: TimeInterval = 6
+    static let imageByteBudget = 8 * 1024 * 1024
+
+    struct Options {
+        let frames: Int
+        let intervalMilliseconds: Int
+        var interval: TimeInterval { Double(intervalMilliseconds) / 1000 }
+
+        init(_ arguments: [String: Any]) throws {
+            guard Set(arguments.keys).isSubset(of: ["device", "device_id", "include_image", "frames", "interval_ms"]),
+                arguments["device"] == nil || arguments["device"] is String,
+                arguments["device_id"] == nil || arguments["device_id"] is String
+            else { throw MCPServer.MCPError("Invalid screenshot_burst arguments") }
+            frames = try Self.integer(arguments["frames"], fallback: 3, range: 2...6, name: "frames")
+            intervalMilliseconds = try Self.integer(
+                arguments["interval_ms"], fallback: 300, range: 100...1000, name: "interval_ms")
+        }
+
+        private static func integer(_ raw: Any?, fallback: Int, range: ClosedRange<Int>, name: String) throws -> Int {
+            guard let raw else { return fallback }
+            guard let value = raw as? NSNumber, CFGetTypeID(value) != CFBooleanGetTypeID(),
+                value.doubleValue.isFinite, value.doubleValue.rounded() == value.doubleValue,
+                (Double(range.lowerBound)...Double(range.upperBound)).contains(value.doubleValue)
+            else { throw MCPServer.MCPError("\(name) must be an integer in \(range.lowerBound)...\(range.upperBound)") }
+            return value.intValue
+        }
+    }
+
+    struct Sample {
+        let frame: MCPServer.ObservationFrame
+        let returnedAfter: TimeInterval
+    }
+
+    struct Result {
+        let options: Options
+        let startedAt: TimeInterval
+        var samples: [Sample] = []
+        var elapsed: TimeInterval = 0
+        var discardedSamples = 0
+        var reason: String?
+        var detail: String?
+        var complete: Bool { samples.count == options.frames }
+
+        var json: [String: Any] {
+            var previous: MCPServer.FrameIdentity?
+            let frames: [[String: Any]] = samples.enumerated().map { index, sample in
+                // Only frames with validated capture metadata enter samples.
+                let identity = sample.frame.identity!
+                var frame = identity.json
+                frame["index"] = index + 1
+                frame["width"] = Int(sample.frame.width)
+                frame["height"] = Int(sample.frame.height)
+                frame["captured_after_start_ms"] = Int(((identity.receivedAt - startedAt) * 1000).rounded())
+                frame["returned_after_start_ms"] = Int((sample.returnedAfter * 1000).rounded())
+                if let previous {
+                    frame["capture_gap_ms"] = Int(((identity.receivedAt - previous.receivedAt) * 1000).rounded())
+                }
+                previous = identity
+                return frame
+            }
+            var result: [String: Any] = [
+                "status": complete ? "complete" : samples.isEmpty ? "unavailable" : "partial",
+                "requested_frames": options.frames, "returned_frames": samples.count,
+                "requested_interval_ms": options.intervalMilliseconds,
+                "sampling_budget_ms": Int(MCPScreenshotBurst.samplingBudget * 1000),
+                "image_byte_budget": MCPScreenshotBurst.imageByteBudget,
+                "elapsed_ms": Int((elapsed * 1000).rounded()),
+                "discarded_stale_samples": discardedSamples,
+                "frames": frames,
+            ]
+            if let reason { result["reason"] = reason }
+            if let detail { result["detail"] = detail }
+            return result
+        }
+    }
+
+    static func collect(
+        options: Options, device: String,
+        sleep: (TimeInterval) -> Void = { Thread.sleep(forTimeInterval: $0) },
+        now: () -> TimeInterval = { ProcessInfo.processInfo.systemUptime },
+        frame: (TimeInterval) throws -> MCPServer.ObservationFrame
+    ) -> Result {
+        let start = now()
+        var result = Result(options: options, startedAt: start)
+        var nextRead: TimeInterval = 0
+        var bytes = 0
+        while !result.complete, result.elapsed < samplingBudget {
+            if result.elapsed < nextRead {
+                let delay = min(nextRead - result.elapsed, samplingBudget - result.elapsed)
+                sleep(delay)
+                result.elapsed = max(result.elapsed + delay, now() - start)
+            }
+            guard result.elapsed < samplingBudget else { break }
+            let current: MCPServer.ObservationFrame
+            do { current = try frame(samplingBudget - result.elapsed) }
+            catch {
+                result.reason = "capture_unavailable"
+                result.detail = String(decoding: String(describing: error).utf8.prefix(512), as: UTF8.self)
+                result.elapsed = max(result.elapsed, now() - start)
+                break
+            }
+            result.elapsed = max(result.elapsed, now() - start)
+            guard result.elapsed < samplingBudget else { break }
+            guard current.device.caseInsensitiveCompare(device) == .orderedSame else {
+                result.reason = "capture_device_mismatch"; break
+            }
+            guard let identity = current.identity else { result.reason = "missing_frame_metadata"; break }
+            guard identity.receivedAt <= start + result.elapsed + 0.001 else {
+                result.reason = "invalid_frame_timestamp"; break
+            }
+            guard !current.image.isEmpty, !current.signature.isEmpty,
+                ["image/png", "image/jpeg"].contains(current.mimeType),
+                let width = Int(current.width), let height = Int(current.height),
+                (1...MCPServer.longEdge).contains(width), (1...MCPServer.longEdge).contains(height)
+            else { result.reason = "invalid_frame"; break }
+            guard identity.receivedAt > start, identity.isNewer(than: result.samples.last?.frame.identity) else {
+                result.discardedSamples += 1
+                nextRead = result.elapsed + 0.05
+                continue
+            }
+            guard current.image.count <= imageByteBudget - bytes else {
+                result.reason = "image_byte_budget"; break
+            }
+            bytes += current.image.count
+            result.samples.append(Sample(frame: current, returnedAfter: result.elapsed))
+            // Delay from the completed fetch, without catch-up bursts after a
+            // slow response. Actual capture gaps remain explicit in the result.
+            nextRead = result.elapsed + options.interval
+        }
+        if !result.complete, result.reason == nil { result.reason = "sampling_deadline" }
+        return result
+    }
+
+    static func content(_ burst: Result, device: String, includeImage: Bool) -> [String: Any] {
+        let metadata: [String: Any] = ["device": device, "burst": burst.json]
+        let encoded = try? JSONSerialization.data(withJSONObject: metadata, options: [.sortedKeys])
+        var content: [[String: Any]] = [[
+            "type": "text", "text": encoded.map { String(decoding: $0, as: UTF8.self) } ?? "Burst metadata unavailable",
+        ]]
+        for (index, sample) in burst.samples.enumerated() {
+            let offset = Int(((sample.frame.identity!.receivedAt - burst.startedAt) * 1000).rounded())
+            content.append([
+                "type": "text",
+                "text": "Frame \(index + 1)/\(burst.samples.count), capture +\(offset) ms, "
+                    + "\(sample.frame.width)×\(sample.frame.height) pixels.",
+            ])
+            if includeImage {
+                content.append([
+                    "type": "image", "data": sample.frame.image.base64EncodedString(), "mimeType": sample.frame.mimeType,
+                ])
+            }
+        }
+        var result: [String: Any] = ["content": content, "structuredContent": metadata]
+        if !burst.complete { result["isError"] = true }
+        return result
+    }
+}
