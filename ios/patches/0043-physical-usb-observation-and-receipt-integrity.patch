index 0000000..5d5e24a
--- /dev/null
+++ b/Sources/iPhoneUse/Capture/USBScreenCapture.swift
@@ -0,0 +1,122 @@
+import Darwin
+import Foundation
+import ImageIO
+import UniformTypeIdentifiers
+
+/// Managed input and observation share one physical UDID. An AVFoundation
+/// acquisition UUID, same-size raster or visual match cannot authorize input.
+struct USBDeviceBinding: Equatable {
+    let deviceID: String
+    let attachmentID: UInt64
+    var source: String { "coredevice-usb:\(attachmentID)" }
+
+    static func resolve(
+        environment: [String: String],
+        pin: () -> USBValeriaConfigurator.PinnedUSBDevice? = USBValeriaConfigurator.currentSingleIOSDeviceIdentity
+    ) throws -> USBDeviceBinding {
+        let configuration = try DeviceClipboard.Configuration(environment: environment)
+        guard environment["IPHONE_USE_DEVICE_ID"] == configuration.deviceID else {
+            throw InputRequestError("Capture and USB target must be the same physical UDID; remove the legacy captureId configuration")
+        }
+        guard let helper = environment[USBScreenCapture.helperKey], helper.hasPrefix("/"), !helper.contains("\0") else {
+            throw InputRequestError("Physical USB screenshots are required before managed input can be enabled")
+        }
+        guard let attached = pin(), attached.registryEntryID != 0,
+            USBValeriaConfigurator.normalizedSerial(attached.serial)
+                == USBValeriaConfigurator.normalizedSerial(configuration.deviceID) else {
+            throw InputRequestError("Connect exactly one iPhone with the configured physical USB UDID; identity is not confirmed")
+        }
+        return USBDeviceBinding(deviceID: configuration.deviceID, attachmentID: attached.registryEntryID)
+    }
+
+    func revalidate(environment: [String: String],
+        pin: () -> USBValeriaConfigurator.PinnedUSBDevice? = USBValeriaConfigurator.currentSingleIOSDeviceIdentity
+    ) throws {
+        guard try Self.resolve(environment: environment, pin: pin) == self else {
+            throw ScreenshotReferences.Rejected("physical USB attachment changed; observe again")
+        }
+    }
+}
+
+/// One owned read-only helper; no capture mux, BLE, AX or image identity guess.
+enum USBScreenCapture {
+    static let helperKey = "IPHONE_USE_USB_SCREENSHOT_HELPER"
+    static let maximumBytes = 16 * 1024 * 1024
+    struct Image {
+        let data: Data
+        let screenSize: CGSize
+        let imageSize: (Int, Int)
+    }
+
+    static func capture(environment: [String: String]) throws -> Data {
+        let configuration = try DeviceClipboard.Configuration(environment: environment)
+        guard let helper = environment[helperKey], helper.hasPrefix("/"), !helper.contains("\0"),
+            FileManager.default.isReadableFile(atPath: helper),
+            FileManager.default.isExecutableFile(atPath: configuration.python.path) else {
+            throw DeviceError("Physical USB screenshot helper is unavailable; run setup-usb")
+        }
+        let directory = FileManager.default.temporaryDirectory.appendingPathComponent("iphone-use-usb-screen-\(UUID().uuidString)")
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: false,
+            attributes: [.posixPermissions: 0o700])
+        defer { try? FileManager.default.removeItem(at: directory) }
+        let outputURL = directory.appendingPathComponent("screen.png")
+        guard FileManager.default.createFile(atPath: outputURL.path, contents: nil,
+            attributes: [.posixPermissions: 0o600]) else { throw DeviceError("Cannot prepare USB screenshot output") }
+        let output = try FileHandle(forWritingTo: outputURL)
+        defer { try? output.close() }
+        let process = Process(), finished = DispatchSemaphore(value: 0)
+        process.executableURL = configuration.python
+        process.arguments = ["-I", "-B", helper]
+        process.environment = configuration.childEnvironment(environment)
+        process.standardInput = FileHandle.nullDevice
+        process.standardOutput = output
+        process.standardError = FileHandle.nullDevice
+        process.terminationHandler = { _ in finished.signal() }
+        try process.run()
+        guard finished.wait(timeout: .now() + 8) == .success else {
+            if process.isRunning { process.terminate() }
+            if finished.wait(timeout: .now() + 2) == .timedOut, process.isRunning {
+                kill(process.processIdentifier, SIGKILL)
+                _ = finished.wait(timeout: .now() + 1)
+            }
+            throw DeviceError("Physical USB screenshot timed out; no fallback was used")
+        }
+        guard process.terminationReason == .exit, process.terminationStatus == 0 else {
+            throw DeviceError("Physical USB screenshot unavailable; no capture-ID fallback was used")
+        }
+        let attributes = try FileManager.default.attributesOfItem(atPath: outputURL.path)
+        guard let size = attributes[.size] as? NSNumber, (9...maximumBytes).contains(size.intValue) else {
+            throw DeviceError("Physical USB screenshot exceeded the image byte budget")
+        }
+        return try Data(contentsOf: outputURL)
+    }
+
+    static func image(_ data: Data, png: Bool, maxWidth: Int?, maxEdge: Int?) throws -> Image {
+        guard data.count <= maximumBytes, data.starts(with: [137, 80, 78, 71, 13, 10, 26, 10]),
+            let source = CGImageSourceCreateWithData(data as CFData, nil),
+            let properties = CGImageSourceCopyPropertiesAtIndex(source, 0, nil) as? [CFString: Any],
+            let width = properties[kCGImagePropertyPixelWidth] as? Int,
+            let height = properties[kCGImagePropertyPixelHeight] as? Int,
+            (1...16384).contains(width), (1...16384).contains(height), width * height <= 40_000_000 else {
+            throw DeviceError("Physical USB screenshot returned invalid PNG dimensions")
+        }
+        let screen = CGSize(width: width, height: height)
+        let size = RequestCoordinates.imageSize(screen, maxWidth: maxWidth, maxEdge: maxEdge)
+        guard size.0 > 0, size.1 > 0,
+            let original = CGImageSourceCreateImageAtIndex(source, 0, nil),
+            let context = CGContext(data: nil, width: size.0, height: size.1, bitsPerComponent: 8,
+                bytesPerRow: 0, space: CGColorSpaceCreateDeviceRGB(), bitmapInfo: CGImageAlphaInfo.noneSkipLast.rawValue)
+        else { throw DeviceError("Cannot decode physical USB screenshot") }
+        context.interpolationQuality = .high
+        context.draw(original, in: CGRect(x: 0, y: 0, width: size.0, height: size.1))
+        guard let image = context.makeImage() else { throw DeviceError("Cannot resize physical USB screenshot") }
+        let result = NSMutableData()
+        guard let destination = CGImageDestinationCreateWithData(result,
+            (png ? UTType.png.identifier : UTType.jpeg.identifier) as CFString, 1, nil) else {
+            throw DeviceError("Cannot encode physical USB screenshot")
+        }
+        CGImageDestinationAddImage(destination, image, [kCGImageDestinationLossyCompressionQuality: 0.8] as CFDictionary)
+        guard CGImageDestinationFinalize(destination) else { throw DeviceError("Cannot finish physical USB screenshot") }
+        return Image(data: result as Data, screenSize: screen, imageSize: size)
+    }
+}
