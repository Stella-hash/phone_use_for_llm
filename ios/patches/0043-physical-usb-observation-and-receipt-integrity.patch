+    def test_full_frame_cache_survives_internal_baseline_polls_and_burst(self):
+        # Model the route's bounded store already filled by prior public frames.
+        # Native ScreenshotObservationOnlyTests exercises the actual store too.
+        tokens = ["00000000-0000-4000-8000-%012d" % index for index in range(1, 129)]
+        state = {"sequence": 0, "posted": False, "issued": 0, "selected_was_present": False}
+        reads = []
+
+        def screenshot(path):
+            reads.append(path)
+            state["sequence"] += 1
+            status, image, headers = capture_reply(240 if state["posted"] else 0,
+                                                    state["sequence"], capture_uptime())
+            if parse_qs(urlsplit(path).query).get("observationOnly") != ["1"]:
+                state["issued"] += 1
+                token = "00000000-0000-4000-9000-%012d" % state["issued"]
+                tokens.append(token)
+                if len(tokens) > 128:
+                    tokens.pop(0)
+                headers["X-Frame-ID"] = token
+            return status, image, headers
+
+        def post(body):
+            state["selected_was_present"] = body["steps"][0]["frame_id"] in tokens
+            if state["selected_was_present"]:
+                tokens.remove(body["steps"][0]["frame_id"])
+            state["posted"] = True
+
+        self.server.screenshot_response = screenshot
+        self.server.before_post = post
+        action, burst, public = self.exchange([
+            ("act", {"steps": [{"type": "tap", "frame_id": FRAME, "x": 7, "y": 9}],
+                     "observation_timeout": 0.5}),
+            ("screenshot_burst", {"frames": 2, "interval_ms": 100}),
+            ("screenshot", {}),
+        ])
+        self.assertTrue(state["selected_was_present"], "hidden baseline evicted the selected frame before input")
+        self.assertTrue(all(not result.get("isError") for result in (action, burst, public)))
+        self.assertEqual(state["issued"], 1, "only the explicitly requested screenshot may issue a token")
+        self.assertEqual(len(tokens), 128)
+        self.assertIn("00000000-0000-4000-8000-000000000002", tokens)
+        self.assertNotIn("frame", action["structuredContent"])
+        self.assertNotIn("frame", burst["structuredContent"])
+        self.assertIn(public["structuredContent"]["frame"]["id"], tokens)
+        self.assertTrue(all(parse_qs(urlsplit(path).query).get("observationOnly") == ["1"] for path in reads[:-1]))
+        self.assertNotIn("observationOnly", parse_qs(urlsplit(reads[-1]).query))
+
