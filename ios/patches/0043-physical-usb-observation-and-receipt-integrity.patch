new file mode 100644
index 0000000..a73d85b
--- /dev/null
+++ b/Sources/iPhoneUse/API/USBControlAPI.swift
@@ -0,0 +1,145 @@
+import Foundation
+
+/// The managed USB surface has one identity, selected before any helper starts.
+/// It deliberately does not dispatch through the legacy AV/BLE device registry.
+enum USBControlAPI {
+    static var isConfigured: Bool {
+        let env = ProcessInfo.processInfo.environment
+        return env[USBScreenCapture.helperKey] != nil || env[CoreDeviceTouch.helperKey] != nil
+            || env[CoreDeviceKeyboard.helperKey] != nil || DeviceClipboard.isConfigured(environment: env)
+    }
+
+    struct Dependencies {
+        var environment = ProcessInfo.processInfo.environment
+        var pin: () -> USBValeriaConfigurator.PinnedUSBDevice? = USBValeriaConfigurator.currentSingleIOSDeviceIdentity
+        var capture: ([String: String]) throws -> Data = USBScreenCapture.capture
+        var keyboard: (CoreDeviceKeyboardProgram, String, [String: String], () throws -> Void,
+            (() throws -> Void)?) throws -> [String: Any] = { program, device, env, before, clipboard in
+                try CoreDeviceKeyboard.perform(program, device: device, environment: env,
+                    beforeCommit: before, clipboard: clipboard)
+            }
+        var touch: (TouchSequenceRequest, ScreenshotReferences.Reference, [String: String],
+            (DeviceDisplayMapping) throws -> Void) throws -> [String: Any] = { program, reference, env, before in
+                try CoreDeviceTouch.perform(program, reference: reference, environment: env, beforeCommit: before)
+            }
+        var clipboard: (String, [String: String], () throws -> Void) throws -> Void = { text, env, before in
+            try DeviceClipboard.write(text, environment: env, beforeWrite: before)
+        }
+        var references = ScreenshotReferences.shared
+    }
+
+    private static let sequenceLock = NSLock()
+    private static var sequence: UInt64 = 0
+
+    static func handle(_ request: HTTPRequest, dependencies d: Dependencies = Dependencies()) -> HTTPResponse {
+        if request.method == "GET", ["/viewer", "/viewer/"].contains(request.path) {
+            return WebPreview.response(for: request.query["lang"].flatMap(AppLanguage.init(rawValue:))
+                ?? AppLanguageStore.shared.language)
+        }
+        if request.method == "GET", request.path == "/config" {
+            return .json(["language": AppLanguageStore.shared.language.rawValue])
+        }
+        do {
+            let binding = try USBDeviceBinding.resolve(environment: d.environment, pin: d.pin)
+            let query = ControlAPI.deviceSelector(body: request.body, query: request.query)
+            guard query == nil || query == binding.deviceID else {
+                throw InputRequestError("This host accepts only its exact physical USB UDID")
+            }
+            let revalidate = { try binding.revalidate(environment: d.environment, pin: d.pin) }
+            func capture(_ maxWidth: Int?, _ maxEdge: Int?, png: Bool = true) throws -> USBScreenCapture.Image {
+                try revalidate()
+                let data = try d.capture(d.environment)
+                try revalidate()
+                return try USBScreenCapture.image(data, png: png, maxWidth: maxWidth, maxEdge: maxEdge)
+            }
+            func captureText(_ device: String?, _ maxEdge: Int?) throws -> (String, Data) {
+                guard device == nil || device == binding.deviceID else { throw InputRequestError("USB target mismatch") }
+                return (binding.deviceID, try capture(nil, maxEdge).data)
+            }
+            let device: [String: Any] = ["id": binding.deviceID, "name": "USB iPhone", "transport": "coredevice-usb"]
+            switch (request.method, request.path) {
+            case ("GET", "/"), ("GET", "/status"), ("GET", "/devices"):
+                return .json(["runtime_identity": RuntimeIdentity.current.json, "devices": [device],
+                    "directTouch": true, "directKeyboard": true, "bluetoothEnabled": false, "bluetoothHosts": [],
+                    "capture": ["transport": "coredevice-usb", "identity_basis": "exact_physical_udid",
+                        "source": binding.source, "idleSuspended": false]])
+            case ("GET", "/screenshot"):
+                let observationOnly = try ControlAPI.screenshotObservationOnly(request.query)
+                func dimension(_ key: String) throws -> Int? {
+                    guard let raw = request.query[key] else { return nil }
+                    guard let value = Int(raw), (1...16384).contains(value) else { throw InputRequestError("Invalid screenshot size") }
+                    return value
+                }
+                let ocr = request.query["ocr"] == "1"
+                let png = request.query["format"] == "png" || ocr
+                let image = try capture(dimension("maxWidth"), dimension("maxEdge"), png: png)
+                let next = sequenceLock.withLock { sequence += 1; return sequence }
+                var headers = ControlAPI.screenshotHeaders(device: binding.deviceID, source: binding.source,
+                    screenSize: image.screenSize, imageSize: image.imageSize, sequence: next,
+                    receivedAt: ProcessInfo.processInfo.systemUptime, observationOnly: observationOnly, references: d.references)
+                if ocr {
+                    headers["X-Screen-OCR"] = try JSONSerialization.data(withJSONObject:
+                        ScreenOCR.recognize(image.data, device: binding.deviceID).json(device: binding.deviceID)).base64EncodedString()
+                }
+                return HTTPResponse(contentType: png ? "image/png" : "image/jpeg", headers: headers, body: image.data)
+            case ("GET", "/ocr"), ("POST", "/ocr"):
+                var options = request.body
+                if options["maxEdge"] == nil, let value = request.query["maxEdge"] {
+                    guard let edge = Int(value), edge > 0 else { throw InputRequestError("Invalid OCR maxEdge") }
+                    options["maxEdge"] = edge
+                }
+                let image = try capture(nil, OCRRequest.maxEdge(options))
+                return .json(ScreenOCR.recognize(image.data, device: binding.deviceID).json(device: binding.deviceID))
+            case ("POST", "/act"):
+                return try ActRequest(request.body, directKeyboardConfigured: true, requireFrameTouch: true).perform(
+                    device: binding.deviceID, capture: captureText, execute: { path, body, _ in
+                        handle(HTTPRequest(method: "POST", path: path, query: [:], body: body), dependencies: d)
+                    })
+            case ("POST", "/tap"), ("POST", "/swipe"), ("POST", "/touch"),
+                 ("POST", "/home"), ("POST", "/key"), ("POST", "/type"):
+                let lock = DeviceCommandLocks.acquire(binding.deviceID)
+                defer { lock.unlock() }
+                try revalidate()
+                var step = request.body
+                step.removeValue(forKey: "device"); step.removeValue(forKey: "device_id")
+                step["type"] = String(request.path.dropFirst())
+                _ = try ActRequest(["steps": [step]], directKeyboardConfigured: true, requireFrameTouch: true)
+                if ["/tap", "/swipe", "/touch"].contains(request.path) {
+                    guard let raw = request.body["frame_id"] else { throw InputRequestError("Touch requires a fresh frame_id") }
+                    let reference = try d.references.consumeUSB(raw, device: binding.deviceID, source: binding.source)
+                    let body = try reference.coordinateBody(request.body)
+                    let program = try request.path == "/touch"
+                        ? TouchSequenceRequest(body, image: (reference.width, reference.height))
+                        : TouchSequenceRequest.gesture(path: request.path, body: body)
+                    let receipt = try d.touch(program, reference, d.environment) { mapping in
+                        try mapping.validate(captureSize: CGSize(width: reference.screenWidth, height: reference.screenHeight))
+                        try revalidate()
+                    }
+                    return .json(["ok": receipt["input_status"] as? String == "sent_unverified",
+                        "device": binding.deviceID, "touch_receipt": receipt])
+                }
+                let text = try request.path == "/type" ? TypeTextRequest(request.body,
+                    deviceClipboardConfigured: true, directKeyboardConfigured: true) : nil
+                let switchIME = try text?.ensureChineseIME == true
+                    && ChineseIMEHeuristic.isEnglish(ScreenOCR.recognize(capture(nil, 1600).data, device: binding.deviceID))
+                let program: CoreDeviceKeyboardProgram
+                if let text { program = try CoreDeviceKeyboardProgram.text(text, switchIME: switchIME) }
+                else if request.path == "/home" { program = try CoreDeviceKeyboardProgram.home() }
+                else { program = try CoreDeviceKeyboardProgram.key(KeyRequest(request.body)) }
+                let clipboard: (() throws -> Void)? = text?.hasClipboard == true ? {
+                    try text!.writeClipboard { value in try d.clipboard(value, d.environment, revalidate) }
+                } : nil
+                let receipt = try d.keyboard(program, binding.deviceID, d.environment, revalidate, clipboard)
+                return CoreDeviceKeyboard.response(receipt, device: binding.deviceID)
+            default:
+                return .rejectedRequest("Route unavailable in managed USB mode", status: 404)
+            }
+        } catch let error as ScreenshotReferences.Rejected {
+            return .json(["error": error.description, "frame_rejected": true, "input_sent": false], status: 409)
+        } catch {
+            // Owned input wrappers return uncertain receipts after any possible
+            // effect. Thrown errors here are pre-input validation/read failures.
+            return .rejectedRequest(String(describing: error), status: 409)
+        }
+    }
+}
