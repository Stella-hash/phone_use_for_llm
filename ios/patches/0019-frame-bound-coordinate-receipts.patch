new file mode 100644
index 0000000..06e7c1d
--- /dev/null
+++ b/Sources/iPhoneUse/API/ScreenshotReferences.swift
@@ -0,0 +1,101 @@
+import CoreFoundation
+import Foundation
+
+/// A bounded coordinate reference, not a claim that the app has stopped changing.
+/// Metadata only; tokens live in this resident host and survive stdio reconnects.
+final class ScreenshotReferences {
+    static let shared = ScreenshotReferences()
+
+    struct Rejected: Error, CustomStringConvertible {
+        let description: String
+        init(_ reason: String) { description = "Frame reference rejected before input: " + reason }
+    }
+
+    struct Reference {
+        let id: String
+        let device: String
+        let source: String
+        let width: Int
+        let height: Int
+        let screenWidth: Int
+        let screenHeight: Int
+
+        func coordinateBody(_ body: [String: Any]) throws -> [String: Any] {
+            if let raw = body["fraction"] {
+                guard let value = raw as? NSNumber, CFGetTypeID(value) == CFBooleanGetTypeID(), !value.boolValue else {
+                    throw Rejected("frame_id requires screenshot pixels, not fractions")
+                }
+            }
+            func point(_ point: [String: Any]) throws {
+                for (key, limit) in [("x", width), ("y", height)] {
+                    guard let number = point[key] as? NSNumber,
+                        CFGetTypeID(number) != CFBooleanGetTypeID(), number.doubleValue.isFinite,
+                        number.doubleValue >= 0, number.doubleValue < Double(limit)
+                    else { throw Rejected("\(key) must be inside the referenced \(width)x\(height) image") }
+                }
+            }
+            if let raw = body["points"] {
+                guard body["x"] == nil, body["y"] == nil else {
+                    throw Rejected("use points or x/y, not both")
+                }
+                guard let points = raw as? [[String: Any]], points.count >= 2 else {
+                    throw Rejected("points must contain at least two image-pixel positions")
+                }
+                for p in points { try point(p) }
+            } else {
+                try point(body)
+            }
+            var bound = body
+            bound["width"] = width
+            bound["height"] = height
+            bound.removeValue(forKey: "maxEdge")
+            bound["fraction"] = false
+            return bound
+        }
+    }
+
+    private let lock = NSLock()
+    private let capacity: Int
+    private var references: [String: Reference] = [:]
+    private var order: [String] = []
+
+    init(capacity: Int = 128) { self.capacity = max(1, capacity) }
+
+    func issue(device: String, source: String, screenSize: CGSize, imageSize: (Int, Int)) -> Reference {
+        let reference = Reference(
+            id: UUID().uuidString, device: device, source: source,
+            width: imageSize.0, height: imageSize.1,
+            screenWidth: Int(screenSize.width), screenHeight: Int(screenSize.height))
+        lock.lock()
+        defer { lock.unlock() }
+        references[reference.id] = reference
+        order.append(reference.id)
+        while order.count > capacity { references.removeValue(forKey: order.removeFirst()) }
+        return reference
+    }
+
+    /// A valid selected-device token is consumed once, including failed attempts.
+    /// A new observation is the recovery path; this never replays an input.
+    func consume(_ raw: Any, device: String, source: String, screenSize: CGSize?) throws -> Reference {
+        lock.lock()
+        defer { lock.unlock() }
+        guard let id = raw as? String, let reference = references[id] else {
+            throw Rejected("unknown, consumed or evicted frame_id; observe again")
+        }
+        guard reference.device == device else { throw Rejected("frame_id belongs to another device") }
+        references.removeValue(forKey: id)
+        order.removeAll { $0 == id }
+        try Self.validate(reference, device: device, source: source, screenSize: screenSize)
+        return reference
+    }
+
+    /// Repeat on the input queue after USB orientation lookup, before the first HID report.
+    static func validate(_ reference: Reference, device: String, source: String, screenSize: CGSize?) throws {
+        guard reference.device == device, reference.source == source else {
+            throw Rejected("device or capture session changed; observe again")
+        }
+        guard let size = screenSize,
+            size.width == Double(reference.screenWidth), size.height == Double(reference.screenHeight)
+        else { throw Rejected("capture dimensions changed; observe again") }
+    }
+}
