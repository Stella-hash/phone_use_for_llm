+def identified_capture_reply(gray, sequence, received_at):
+    """Distinguish encoded frames without changing their decoded pixels."""
+    status, image, headers = capture_reply(gray, sequence, received_at)
+    payload = b"frame-sequence\0" + str(sequence).encode()
+    marker = (struct.pack(">I", len(payload)) + b"tEXt" + payload
+              + struct.pack(">I", zlib.crc32(b"tEXt" + payload)))
+    # The existing fixture ends with the standard 12-byte IEND chunk.
+    image = image[:-12] + marker + image[-12:]
+    headers["X-Frame-ID"] = "00000000-0000-4000-8000-%012d" % sequence
+    return status, image, headers
+
