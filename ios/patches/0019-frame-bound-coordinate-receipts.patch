+        }
+    }
+
+    func testValidationCanRunAgainAfterPreflightWithoutReusingTheStoreToken() throws {
+        let store = ScreenshotReferences()
+        let reference = try consume(store, issue(store).id)
+        XCTAssertNoThrow(
+            try ScreenshotReferences.validate(reference, device: "phone-a", source: "capture-a", screenSize: screen))
+        XCTAssertThrowsError(
+            try ScreenshotReferences.validate(reference, device: "phone-a", source: "replacement", screenSize: screen))
+        XCTAssertThrowsError(
+            try ScreenshotReferences.validate(reference, device: "phone-b", source: "capture-a", screenSize: screen))
+        XCTAssertThrowsError(
+            try ScreenshotReferences.validate(
+                reference, device: "phone-a", source: "capture-a", screenSize: CGSize(width: 1180, height: 2556)))
+        XCTAssertThrowsError(try consume(store, reference.id))
+    }
+
+    func testCapacityEvictsOldestUnconsumedReference() throws {
+        let store = ScreenshotReferences(capacity: 2)
+        let first = issue(store)
+        let second = issue(store)
+        let third = issue(store)
+        XCTAssertThrowsError(try consume(store, first.id))
+        XCTAssertEqual(try consume(store, second.id).id, second.id)
+        XCTAssertEqual(try consume(store, third.id).id, third.id)
+    }
+
+    func testConsumptionFreesCapacityWithoutEvictingAnotherLiveReference() throws {
+        let store = ScreenshotReferences(capacity: 2)
+        let first = issue(store)
+        let second = issue(store)
+        _ = try consume(store, first.id)
+        let third = issue(store)
+        XCTAssertEqual(try consume(store, second.id).id, second.id)
+        XCTAssertEqual(try consume(store, third.id).id, third.id)
+    }
+
+    func testNewResidentStoreDoesNotAcceptPreviousHostReferences() throws {
+        let oldHost = ScreenshotReferences()
