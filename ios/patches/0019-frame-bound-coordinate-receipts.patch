+        ) { error in XCTAssertTrue(error is ScreenshotReferences.Rejected) }
+        XCTAssertEqual(try consume(store, reference.id).device, "phone-a")
+    }
+
+    func testCaptureReplacementConsumesAndRejectsTheOldReference() {
+        let store = ScreenshotReferences()
+        let reference = issue(store)
