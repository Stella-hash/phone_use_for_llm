+final class ScreenshotReferencesTests: XCTestCase {
+    private let screen = CGSize(width: 2556, height: 1180)
+
+    private func issue(
+        _ store: ScreenshotReferences, device: String = "phone-a", source: String = "capture-a",
+        imageSize: (Int, Int) = (1000, 462)
+    ) -> ScreenshotReferences.Reference {
+        store.issue(device: device, source: source, screenSize: screen, imageSize: imageSize)
+    }
+
+    private func consume(_ store: ScreenshotReferences, _ id: Any) throws -> ScreenshotReferences.Reference {
+        try store.consume(id, device: "phone-a", source: "capture-a", screenSize: screen)
+    }
+
+    func testNewObservationsKeepIndependentCoordinateReferences() throws {
+        let store = ScreenshotReferences()
+        let first = issue(store)
+        let second = issue(store, imageSize: (500, 231))
+        XCTAssertFalse(first.id.isEmpty)
+        XCTAssertNotEqual(first.id, second.id)
+        let a = try consume(store, first.id)
+        let b = try consume(store, second.id)
+        XCTAssertEqual(a.width, 1000)
+        XCTAssertEqual(a.height, 462)
+        XCTAssertEqual(b.width, 500)
+        XCTAssertEqual(b.height, 231)
+        XCTAssertEqual(a.screenWidth, 2556)
+        XCTAssertEqual(a.screenHeight, 1180)
+        XCTAssertEqual(a.source, "capture-a")
+        // A diagnostic baseline or another screenshot must not silently replace
+        // the coordinate space of a previously returned image.
+    }
+
+    func testUnknownAndMalformedIDsDoNotConsumeAValidReference() throws {
+        let store = ScreenshotReferences()
+        let reference = issue(store)
+        for invalid: Any in ["", "unknown", 7, true, NSNull(), ["id": reference.id]] {
+            XCTAssertThrowsError(try consume(store, invalid)) { error in
+                XCTAssertTrue(error is ScreenshotReferences.Rejected)
+            }
+        }
+        XCTAssertEqual(try consume(store, reference.id).id, reference.id)
+        XCTAssertThrowsError(try consume(store, reference.id), "A consumed token must never authorize replay")
+    }
+
+    func testAnotherDeviceCannotStealOrUseTheReference() throws {
+        let store = ScreenshotReferences()
+        let reference = issue(store)
+        XCTAssertThrowsError(
