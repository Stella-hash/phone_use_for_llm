+            try store.consume(reference.id, device: "phone-a", source: "capture-b", screenSize: screen))
+        XCTAssertThrowsError(
+            try consume(store, reference.id),
+            "A selected-device failure requires a new observation even if the old source later returns")
+    }
+
+    func testMissingOrChangedGeometryRejectsTheReference() {
+        let store = ScreenshotReferences()
+        let changed: [CGSize?] = [
+            nil, CGSize(width: 1180, height: 2556), CGSize(width: 2555, height: 1180),
+            CGSize(width: 2556, height: 1179), CGSize(width: CGFloat.infinity, height: 1180),
+        ]
