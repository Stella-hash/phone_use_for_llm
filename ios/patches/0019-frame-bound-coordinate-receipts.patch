+        // Leave this isolated controller stopped: request dispatch must not wake
+        // capture, discover a real phone, or require a running resident host.
+        let activity = QuietModeActivityController(environment: [:])
+        let reference = ScreenshotReferences.shared.issue(
+            device: "frame-routing-test-device", source: "frame-routing-test-source",
+            screenSize: CGSize(width: 2556, height: 1180), imageSize: (1000, 462))
+        var captures = 0
+        var taps = 0
+        for path in ["/act", "/tap_text", "/calibration/auto", "/calibration/reload", "/ocr", "/type"] {
+            let body: [String: Any] = [
+                "frame_id": reference.id, "device": reference.device,
+                "steps": [["type": "home"]], "text": "Confirm",
+            ]
+            let response = ControlAPI.handle(
+                HTTPRequest(method: "POST", path: path, query: [:], body: body),
+                ocrCapture: { _, _ in
+                    captures += 1
+                    XCTFail("unsupported frame_id must reject before capture: \(path)")
+                    return ("frame-routing-test-device", Data())
+                },
+                ocrTap: { _, _, _, _ in
+                    taps += 1
+                    XCTFail("unsupported frame_id must reject before tap: \(path)")
+                }, activity: activity)
+            XCTAssertEqual(response.status, 409, path)
+            let result = try XCTUnwrap(JSONSerialization.jsonObject(with: response.body) as? [String: Any])
+            XCTAssertEqual(result["frame_rejected"] as? Bool, true, path)
+            XCTAssertEqual(result["input_sent"] as? Bool, false, path)
+            XCTAssertTrue((result["error"] as? String)?.contains("frame_id") == true, path)
+            XCTAssertNil(result["completed"], path)
+            XCTAssertNil(result["failed_step"], path)
+        }
+        XCTAssertEqual(captures, 0)
+        XCTAssertEqual(taps, 0)
+        // Unsupported routes have not attempted the coordinate action, so they
+        // must not spend a token that a subsequent supported route can use.
+        XCTAssertEqual(
+            try ScreenshotReferences.shared.consume(
+                reference.id, device: reference.device, source: reference.source,
+                screenSize: CGSize(width: 2556, height: 1180)
+            ).id,
+            reference.id)
+    }
+}
