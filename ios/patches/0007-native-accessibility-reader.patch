diff --git a/Tests/iPhoneUseTests/Input/DeviceAccessibilityTests.swift b/Tests/iPhoneUseTests/Input/DeviceAccessibilityTests.swift
new file mode 100644
index 0000000..ae41d01
--- /dev/null
+++ b/Tests/iPhoneUseTests/Input/DeviceAccessibilityTests.swift
@@ -0,0 +1,100 @@
+import Foundation
+import XCTest
+
+@testable import iPhoneUse
+
+final class DeviceAccessibilityTests: XCTestCase {
+    private let deviceID = "00000000-0000000000000001"
+
+    private func temporary() throws -> URL {
+        let directory = FileManager.default.temporaryDirectory
+            .appendingPathComponent("iphone-use-ax-test-\(UUID().uuidString)")
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: false)
+        addTeardownBlock { try? FileManager.default.removeItem(at: directory) }
+        return directory
+    }
+
+    private func helper(_ script: String, in directory: URL) throws -> [String: String] {
+        let executable = directory.appendingPathComponent("fake-python")
+        let helper = directory.appendingPathComponent("tree.py")
+        try Data(("#!/bin/sh\n" + script).utf8).write(to: executable)
+        try Data("# fixture helper path".utf8).write(to: helper)
+        try FileManager.default.setAttributes([.posixPermissions: 0o700], ofItemAtPath: executable.path)
+        return [
+            DeviceClipboard.pythonKey: executable.path, DeviceClipboard.deviceKey: deviceID,
+            DeviceAccessibility.helperKey: helper.path,
+        ]
+    }
+
+    func testFixedHelperReceivesOptionsViaStdinAndExactDeviceViaEnvironment() throws {
+        let directory = try temporary()
+        let environment = try helper(
+            "/bin/cat > '\(directory.path)/request'\n"
+                + "printf '%s\\n' \"$@\" > '\(directory.path)/arguments'\n"
+                + "printf '%s' \"$PYMOBILEDEVICE3_UDID\" > '\(directory.path)/target'\n"
+                + "printf '%s' \"$PYMOBILEDEVICE3_NATIVE\" > '\(directory.path)/native'\n"
+                + "printf '%s' '{\"schema_version\":1,\"source\":\"ios-native-ax\",\"status\":\"ok\",\"nodes\":[]}'\n",
+            in: directory
+        ).merging(["PYMOBILEDEVICE3_UDID": "wrong", "PYMOBILEDEVICE3_NATIVE": "1"]) { _, new in new }
+        let result = try DeviceAccessibility.read(
+            scope: "point", x: 123, y: 456, includeHidden: true, environment: environment)
+        XCTAssertEqual(result["status"] as? String, "ok")
+        let request =
+            try JSONSerialization.jsonObject(with: Data(contentsOf: directory.appendingPathComponent("request")))
+            as? [String: Any]
+        XCTAssertEqual(request?["scope"] as? String, "point")
+        XCTAssertEqual(request?["x"] as? Int, 123)
+        XCTAssertEqual(request?["y"] as? Int, 456)
+        XCTAssertEqual(request?["include_hidden"] as? Bool, true)
+        XCTAssertEqual(try String(contentsOf: directory.appendingPathComponent("target"), encoding: .utf8), deviceID)
+        XCTAssertEqual(try String(contentsOf: directory.appendingPathComponent("native"), encoding: .utf8), "")
+        XCTAssertEqual(
+            try String(contentsOf: directory.appendingPathComponent("arguments"), encoding: .utf8),
+            directory.appendingPathComponent("tree.py").path + "\n")
+    }
+
+    func testUnavailableNativeCapabilityRemainsAnExplicitResult() throws {
+        let environment = try helper(
+            "printf '%s' '{\"schema_version\":1,\"source\":\"ios-native-ax\",\"status\":\"unavailable\","
+                + "\"reason\":{\"code\":\"service_unavailable\",\"message\":\"Native AX absent\"},\"cleanup\":{}}'\n",
+            in: temporary())
+        let result = try DeviceAccessibility.read(environment: environment)
+        XCTAssertEqual(result["status"] as? String, "unavailable")
+        XCTAssertNil(result["nodes"])
+        XCTAssertEqual((result["reason"] as? [String: Any])?["code"] as? String, "service_unavailable")
+    }
+
+    func testInvalidOptionsFailBeforeLaunchingHelper() throws {
+        let directory = try temporary()
+        let environment = try helper("touch '\(directory.path)/called'\n", in: directory)
+        XCTAssertThrowsError(try DeviceAccessibility.read(scope: "ocr", environment: environment))
+        XCTAssertThrowsError(try DeviceAccessibility.read(x: .nan, environment: environment))
+        XCTAssertThrowsError(try DeviceAccessibility.read(y: 1001, environment: environment))
+        XCTAssertThrowsError(try DeviceAccessibility.read(environment: environment, timeout: 20))
+        XCTAssertFalse(FileManager.default.fileExists(atPath: directory.appendingPathComponent("called").path))
+    }
+
+    func testForeignObservationEnvelopeAndOversizedOutputAreRefused() throws {
+        let environment = try helper(
+            "printf '%s' '{\"schema_version\":1,\"source\":\"ocr\",\"status\":\"ok\"}'\n", in: temporary())
+        XCTAssertThrowsError(try DeviceAccessibility.read(environment: environment))
+        let oversized = try helper(
+            "/usr/bin/head -c 262146 /dev/zero\n", in: temporary())
+        XCTAssertThrowsError(try DeviceAccessibility.read(environment: oversized)) { error in
+            XCTAssertTrue(String(describing: error).contains("byte budget"))
+        }
+    }
+
+    func testTimeoutStopsOnlyOneOwnedHelperWithoutRetry() throws {
+        let directory = try temporary()
+        let environment = try helper(
+            "printf 'called\\n' >> '\(directory.path)/calls'\nexec /bin/sleep 5\n", in: directory)
+        let started = ProcessInfo.processInfo.systemUptime
+        XCTAssertThrowsError(try DeviceAccessibility.read(environment: environment, timeout: 0.2)) { error in
+            XCTAssertTrue(String(describing: error).contains("timed out"))
+        }
+        XCTAssertLessThan(ProcessInfo.processInfo.systemUptime - started, 5)
+        let calls = (try? String(contentsOf: directory.appendingPathComponent("calls"), encoding: .utf8)) ?? ""
+        XCTAssertTrue(calls.isEmpty || calls == "called\n")
+    }
+}
