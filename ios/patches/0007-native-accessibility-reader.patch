new file mode 100644
index 0000000..4156266
--- /dev/null
+++ b/Sources/iPhoneUse/Input/DeviceAccessibility.swift
@@ -0,0 +1,97 @@
+import Darwin
+import Foundation
+
+/// On-demand native iPhone AX observation through the configured, exact USB
+/// device. This does not activate elements, move focus, take screenshots or run
+/// OCR. Capability failures remain explicit JSON results from the helper.
+enum DeviceAccessibility {
+    static let helperKey = "IPHONE_USE_AX_HELPER"
+    static let maximumOutputBytes = 256 * 1024 + 1
+
+    static func read(
+        scope: String = "app", x: Double = 500, y: Double = 500,
+        includeHidden: Bool = false,
+        environment: [String: String] = ProcessInfo.processInfo.environment,
+        timeout: TimeInterval = 12
+    ) throws -> [String: Any] {
+        guard ["app", "point"].contains(scope), x.isFinite, y.isFinite,
+            (0...1000).contains(x), (0...1000).contains(y)
+        else { throw DeviceError("Native AX scope must be app or point, with x/y in 0...1000") }
+        guard timeout.isFinite, timeout > 0, timeout <= 12 else {
+            throw DeviceError("Native AX timeout must be positive and no greater than 12 seconds")
+        }
+        let configuration = try DeviceClipboard.Configuration(environment: environment)
+        guard let helper = environment[helperKey], helper.hasPrefix("/"), !helper.contains("\0"),
+            FileManager.default.isReadableFile(atPath: helper)
+        else { throw DeviceError("Native AX helper is unavailable; configure IPHONE_USE_AX_HELPER") }
+        guard FileManager.default.isExecutableFile(atPath: configuration.python.path) else {
+            throw DeviceError("Native AX Python is unavailable; run the configured USB setup")
+        }
+        let request: [String: Any] = ["scope": scope, "x": x, "y": y, "include_hidden": includeHidden]
+        let directory = FileManager.default.temporaryDirectory
+            .appendingPathComponent("iphone-use-native-ax-\(UUID().uuidString)")
+        try FileManager.default.createDirectory(
+            at: directory, withIntermediateDirectories: false, attributes: [.posixPermissions: 0o700])
+        defer { try? FileManager.default.removeItem(at: directory) }
+        let inputURL = directory.appendingPathComponent("stdin")
+        let outputURL = directory.appendingPathComponent("stdout")
+        let errorURL = directory.appendingPathComponent("stderr")
+        for (url, contents) in [
+            (inputURL, try JSONSerialization.data(withJSONObject: request)),
+            (outputURL, Data()), (errorURL, Data()),
+        ] {
+            guard
+                FileManager.default.createFile(
+                    atPath: url.path, contents: contents, attributes: [.posixPermissions: 0o600])
+            else { throw DeviceError("Could not prepare private native AX helper files") }
+        }
+        let input = try FileHandle(forReadingFrom: inputURL)
+        let output = try FileHandle(forWritingTo: outputURL)
+        let diagnostic = try FileHandle(forWritingTo: errorURL)
+        defer {
+            try? input.close()
+            try? output.close()
+            try? diagnostic.close()
+        }
+        let process = Process()
+        process.executableURL = configuration.python
+        process.arguments = [helper]
+        process.environment = configuration.childEnvironment(environment)
+        process.standardInput = input
+        process.standardOutput = output
+        process.standardError = diagnostic
+        let finished = DispatchSemaphore(value: 0)
+        process.terminationHandler = { _ in finished.signal() }
+        do { try process.run() } catch {
+            throw DeviceError("Could not start native AX helper: \(error.localizedDescription)")
+        }
+        guard finished.wait(timeout: .now() + timeout) == .success else {
+            // SIGTERM lets the owned helper close its AX subscription and
+            // userspace tunnel. Only this child is killed if cleanup stalls.
+            if process.isRunning { process.terminate() }
+            if finished.wait(timeout: .now() + 3) == .timedOut {
+                if process.isRunning { kill(process.processIdentifier, SIGKILL) }
+                _ = finished.wait(timeout: .now() + 1)
+            }
+            throw DeviceError("Native AX observation timed out; no screenshot/OCR fallback or UI action was performed")
+        }
+        guard process.terminationReason == .exit, process.terminationStatus == 0 else {
+            let file = try? FileHandle(forReadingFrom: errorURL)
+            defer { try? file?.close() }
+            let data = (try? file?.read(upToCount: 1200)) ?? Data()
+            let detail = String(data: data, encoding: .utf8) ?? ""
+            throw DeviceError("Native AX helper failed (\(process.terminationStatus)): \(detail)")
+        }
+        let attributes = try FileManager.default.attributesOfItem(atPath: outputURL.path)
+        guard let size = attributes[.size] as? NSNumber, size.intValue <= maximumOutputBytes else {
+            throw DeviceError("Native AX helper exceeded the JSON byte budget; no partial tree returned")
+        }
+        let data = try Data(contentsOf: outputURL)
+        guard let result = try JSONSerialization.jsonObject(with: data) as? [String: Any],
+            result["schema_version"] as? Int == 1,
+            result["source"] as? String == "ios-native-ax",
+            let status = result["status"] as? String, ["ok", "unavailable"].contains(status)
+        else { throw DeviceError("Native AX helper returned an invalid observation envelope") }
+        return result
+    }
+}
