+    /// Text-only clients receive the complete reading view once. Programmatic
+    /// consumers hydrate the same local archive from this small structured
+    /// envelope; node text is never duplicated in structuredContent.
+    static func accessibilityResult(_ tree: [String: Any]) throws -> [String: Any] {
+        var view = tree
+        if let archive = view.removeValue(forKey: "archive") as? [String: Any] {
+            view["archive_status"] = archive["status"] ?? "unknown"
+        }
+        view.removeValue(forKey: "selection")
+        var metadata: [String: Any] = ["payload_content_index": 0]
+        for key in ["source", "schema_version", "format", "status", "scope", "archive", "native_status", "selection"] {
+            metadata[key] = tree[key]
+        }
+        let data = try JSONSerialization.data(withJSONObject: view, options: [.sortedKeys, .withoutEscapingSlashes])
+        return ["content": [["type": "text", "text": String(decoding: data, as: UTF8.self)]],
+                "structuredContent": metadata, "isError": tree["status"] as? String != "ok"]
+    }
+
