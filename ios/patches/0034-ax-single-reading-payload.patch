+    def test_usb_mode_rejects_hidden_input_aliases_before_device_access(self):
+        self.env["IPHONE_USE_BLUETOOTH_DISABLED"] = "1"
+        results = self.exchange([(name, {}) for name in
+                                ("tap", "long_press", "swipe", "touch_sequence", "type_text",
+                                 "press_key", "home", "keyboard_sequence", "tap_text", "future_tool")])
+        self.assertTrue(all(result["isError"] for result in results))
+        self.assertTrue(all("use the advertised tools and act" in json.dumps(result) for result in results))
+        self.assertEqual(self.server.events, [("GET", "/config?wake=0")])
+
+    def test_native_accessibility_reading_retains_archive_reference_without_payload_duplication(self):
+        self.env["IPHONE_USE_DEVICE_ID"] = "phone-1"
+        self.env["IPHONE_USE_USB_DEVICE_ID"] = "00000000-0000000000000000"
+        self.env["IPHONE_USE_USB_CLIPBOARD_PYTHON"] = sys.executable
+        helper = Path(self.state.name) / "reading-ax.py"
+        self.env["IPHONE_USE_AX_HELPER"] = str(helper)
+        for status in ("ok", "unavailable"):
+            payload = {"schema_version": 1, "source": "ios-native-ax", "format": "ios-ax-reading-v1",
+                       "status": status, "scope": "point", "nodes": [["n1", None, {"label": "only-once-741"}]],
+                       "selection": {"request_process_id": 17},
+                       "archive": {"status": "saved", "snapshot_id": "fixture", "raw_path": "/private/source.json"}}
+            if status == "unavailable":
+                payload["nodes"] = []
+                payload["reason"] = {"code": "timeout", "message": "only-once-741"}
+            helper.write_text("import json\nprint(" + repr(json.dumps(payload)) + ")\n")
+            result = self.exchange([("accessibility_tree", {})])[0]
+            view = json.loads(result["content"][0]["text"])
+            metadata = result["structuredContent"]
+            self.assertEqual(metadata["archive"], payload["archive"])
+            self.assertEqual(metadata["selection"], payload["selection"])
+            self.assertEqual(metadata["format"], "ios-ax-reading-v1")
+            self.assertEqual(view["archive_status"], "saved")
+            self.assertNotIn("archive", view)
+            self.assertNotIn("selection", view)
+            self.assertEqual(json.dumps(result).count("only-once-741"), 1)
+            self.assertEqual(result["isError"], status != "ok")
+
