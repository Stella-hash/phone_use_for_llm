diff --git a/Sources/iPhoneUse/MCP/MCPResultSummary.swift b/Sources/iPhoneUse/MCP/MCPResultSummary.swift
new file mode 100644
index 0000000..b6542c3
--- /dev/null
+++ b/Sources/iPhoneUse/MCP/MCPResultSummary.swift
@@ -0,0 +1,82 @@
+import Foundation
+
+/// Human-readable projection of the final receipt, never a new success verdict.
+/// Complete transport, observation, frame and error data remain structured.
+enum MCPResultSummary {
+    static func text(_ metadata: [String: Any]) -> String? {
+        guard let receipt = metadata["input_receipt"] as? [String: Any] else { return nil }
+        let transport = receipt["transport"] as? [String: Any] ?? [:]
+        let backend = transport["backend"] as? String
+        let route = backend.map { " (\($0))" } ?? ""
+        let input: String
+        switch receipt["status"] as? String {
+        case "sent_unverified":
+            input = "locally sent\(route); device delivery unverified"
+        case "acknowledged":
+            input = "request acknowledged; device delivery unverified"
+        case "not_sent":
+            input = transport["no_op"] as? Bool == true ? "no-op; nothing sent" : "not sent"
+        case "unconfirmed":
+            input = "unconfirmed\(route); may have executed"
+        default:
+            input = "status unknown; execution not established"
+        }
+        var lines = ["Input: \(input)."]
+        if let observation = metadata["observation"] as? [String: Any] {
+            if observation["status"] as? String == "unobserved",
+                observation["reason"] as? String == "disabled"
+            {
+                lines.append("Observation: not requested.")
+            } else {
+                let status: String
+                switch observation["status"] as? String {
+                case "changed": status = "change detected"
+                case "stable": status = "stable"
+                case "timeout": status = "wait timed out"
+                case "unobserved": status = "unobserved"
+                default: status = "status unknown"
+                }
+                let reason = (observation["reason"] as? String).map { " (\($0))" } ?? ""
+                lines.append(
+                    "Observation: \(status)\(reason); fresh=\(flag(observation["fresh"])), "
+                    + "changed=\(flag(observation["changed_from_baseline"])), "
+                    + "stable=\(flag(observation["visually_stable"])).")
+                if let detail = observation["detail"] as? String, !detail.isEmpty {
+                    lines.append("Observation detail: \(detail)")
+                }
+            }
+        } else {
+            lines.append("Observation: not recorded.")
+        }
+        // These routes do not evaluate an application-specific success condition.
+        lines.append("App result: unverified.")
+        if hasCleanupWarning(transport) {
+            lines.append("Cleanup: warning; details retained in input_receipt.transport.")
+        }
+        // Preserve transport-only failure descriptions without repeating the
+        // entire transport payload on every successful frame-bound action.
+        for key in ["reason", "error_type"] {
+            if let detail = transport[key] as? String, !detail.isEmpty {
+                lines.append("Input \(key): \(detail)")
+            }
+        }
+        return lines.joined(separator: "\n")
+    }
+
+    private static func flag(_ value: Any?) -> String {
+        guard let value = value as? Bool else { return "unknown" }
+        return value ? "yes" : "no"
+    }
+
+    private static func hasCleanupWarning(_ transport: [String: Any]) -> Bool {
+        let cleanup = transport["cleanup"] as? [String: Any] ?? [:]
+        if let errors = cleanup["errors"] as? [Any], !errors.isEmpty { return true }
+        if ["warning", "failed", "error"].contains(cleanup["status"] as? String ?? "") { return true }
+        if cleanup["subscription_stop"] as? String == "not-acknowledged" { return true }
+        if ["pairing_scratch_removed", "connection_closed", "tunnel_closed"].contains(where: {
+            cleanup[$0] as? Bool == false
+        }) { return true }
+        let release = transport["cleanup_release"] as? [String: Any]
+        return release?["status"] as? String == "unconfirmed"
+    }
+}
