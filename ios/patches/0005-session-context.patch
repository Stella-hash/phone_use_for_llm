+    /// This route is entirely local and precedes /devices discovery. The fixed
+    /// configured identity allows resume while USB capture and the phone sleep.
+    static func sessionContext(_ arguments: [String: Any]) throws -> [String: Any] {
+        guard Set(arguments.keys).isSubset(of: ["device", "device_id", "checkpoint", "clear_checkpoint"]),
+            arguments["device"] == nil || arguments["device"] is String,
+            arguments["device_id"] == nil || arguments["device_id"] is String
+        else { throw MCPError("Invalid session_context arguments") }
+        if let a = arguments["device"] as? String, let b = arguments["device_id"] as? String,
