@@ -0,0 +1,114 @@
+import Foundation
+import XCTest
+
+@testable import iPhoneUse
+
+final class MCPContextStoreTests: XCTestCase {
+    private func directory() throws -> URL {
+        let url = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+        try FileManager.default.createDirectory(at: url, withIntermediateDirectories: true)
+        addTeardownBlock { try? FileManager.default.removeItem(at: url) }
+        return url
+    }
+
+    func testResumeKeepsCheckpointAndMarksInterruptedRecordUncertain() throws {
+        let directory = try directory()
+        let store = try MCPContextStore(device: "phone", directory: directory)
+        var event = try store.begin(tool: "tap", arguments: ["x": 20, "y": 30], kind: "input")
+        event.requests_started = 1
+        try store.save(event)
+        let checkpoint: [String: Any] = ["what_seen": "door", "what_done": "tried handle",
+            "uncertain": "door response", "next_step": "inspect screen", "source_event_id": event.id]
+        _ = try store.context(checkpoint: checkpoint)
+        let resumed = try MCPContextStore(device: "PHONE", directory: directory).context()
+        let recent = try XCTUnwrap(resumed["recent"] as? [[String: Any]])
+        XCTAssertEqual(recent.first?["state"] as? String, "uncertain_after_interruption")
+        XCTAssertEqual(recent.first?["requests_acknowledged"] as? Int, 0)
+        let saved = try XCTUnwrap(resumed["checkpoint"] as? [String: Any])
+        XCTAssertEqual(saved["kind"] as? String, "agent_note")
+        XCTAssertEqual(saved["historical"] as? Bool, true)
+        XCTAssertEqual(saved["untrusted_data"] as? Bool, true)
+        XCTAssertEqual(saved["what_seen"] as? String, "door")
+        XCTAssertEqual(resumed["checkpoint_source_retained"] as? Bool, true)
+        let permissions = try FileManager.default.attributesOfItem(atPath: store.file.path)[.posixPermissions] as? Int
+        XCTAssertEqual(permissions, 0o600)
+    }
+
+    func testCountBoundKeepsIdleMonthsResumableWithoutAnotherFile() throws {
+        let directory = try directory()
+        var now = Date(timeIntervalSince1970: 1_700_000_000)
+        let store = try MCPContextStore(device: "phone", directory: directory, now: { now })
+        for _ in 0..<25 { _ = try store.begin(tool: "screenshot", arguments: [:], kind: "observation") }
+        let checkpoint = ["what_seen": "board", "what_done": "looked", "uncertain": "next move", "next_step": "inspect"]
+        let context = try store.context(checkpoint: checkpoint)
+        let recent = try XCTUnwrap(context["recent"] as? [[String: Any]])
+        XCTAssertEqual(recent.count, 20)
+        XCTAssertEqual(recent.first?["id"] as? Int, 6)
+        now += 120 * 86400
+        let resumed = try MCPContextStore(device: "phone", directory: directory, now: { now }).context()
+        XCTAssertEqual((resumed["recent"] as? [Any])?.count, 20)
+        XCTAssertNotNil(resumed["checkpoint"])
+        XCTAssertEqual(resumed["checkpoint_age_seconds"] as? Int, 120 * 86400)
+        XCTAssertEqual(resumed["current_ui_verified"] as? Bool, false)
+        XCTAssertEqual(try FileManager.default.contentsOfDirectory(atPath: directory.path).count, 1)
+    }
+
+    func testAutomaticRecordWhitelistsAliasesAndOmitsTextKeysOCRAndErrors() throws {
+        let directory = try directory()
+        let store = try MCPContextStore(device: "phone", directory: directory)
+        let secret = "private-literal-marker"
+        for (tool, args) in [
+            ("type_text", ["text": secret, "clipboard": secret]),
+            ("press_key", ["key": secret, "modifiers": [secret]]),
+            ("tap_text", ["text": secret, "error": secret]),
+            ("keyboard_sequence", ["actions": [["text": secret], ["key": "9"], ["wait": 0]]]),
+            ("act", ["steps": [["type": "type", "text": secret], ["type": "tap_text", "text": secret]]]),
+        ] as [(String, [String: Any])] {
+            var event = try store.begin(tool: tool, arguments: args, kind: "input")
+            let observation = MCPServer.ObservationResult(status: .unobserved, reason: secret, detail: secret)
+            event.observation = MCPContextStore.Observation(observation)
+            try store.save(event)
+        }
+        let saved = try String(contentsOf: store.file, encoding: .utf8)
+        XCTAssertFalse(saved.contains(secret))
+        XCTAssertFalse(saved.contains("clipboard"))
+        XCTAssertFalse(saved.contains("\"key\":\"9\""))
+        XCTAssertTrue(saved.contains("step_kinds"))
+    }
+
+    func testCheckpointValidationAndUnreadableFileNeverSilentlyReplaceSavedData() throws {
+        let directory = try directory()
+        let store = try MCPContextStore(device: "phone", directory: directory)
+        let good: [String: Any] = ["what_seen": "one", "what_done": "two", "uncertain": "three", "next_step": "four"]
+        _ = try store.context(checkpoint: good)
+        for invalid: [String: Any] in [
+            [:], good.merging(["extra": "x"]) { _, value in value },
+            good.merging(["what_seen": String(repeating: "x", count: 601)]) { _, value in value },
+            good.merging(["source_event_id": true]) { _, value in value },
+            good.merging(["source_event_id": 999]) { _, value in value },
+        ] { XCTAssertThrowsError(try store.context(checkpoint: invalid)) }
+        let saved = try XCTUnwrap(try store.context()["checkpoint"] as? [String: Any])
+        XCTAssertEqual(saved["what_seen"] as? String, "one")
+        _ = try store.context(clear: true)
+        XCTAssertNil(try store.context()["checkpoint"])
+        let invalid = Data("broken-json-private-value".utf8)
+        try invalid.write(to: store.file)
+        XCTAssertThrowsError(try MCPContextStore(device: "phone", directory: directory))
+        XCTAssertEqual(try Data(contentsOf: store.file), invalid)
+    }
+
+    func testEncodedByteLimitRejectsHugeSingleGraphemeWithoutReplacingRecord() throws {
+        let directory = try directory()
+        let store = try MCPContextStore(device: "phone", directory: directory)
+        let good = ["what_seen": "board", "what_done": "looked", "uncertain": "move", "next_step": "inspect"]
+        _ = try store.context(checkpoint: good)
+        let before = try Data(contentsOf: store.file)
+        let huge = "a" + String(repeating: "\u{301}", count: 150000)
+        XCTAssertEqual(huge.count, 1)
+        var invalid = good
+        invalid["what_seen"] = huge
+        XCTAssertThrowsError(try store.context(checkpoint: invalid))
+        XCTAssertEqual(try Data(contentsOf: store.file), before)
+        XCTAssertLessThanOrEqual(before.count, 262144)
+    }
+}
