diff --git a/Sources/iPhoneUse/MCP/MCPContextStore.swift b/Sources/iPhoneUse/MCP/MCPContextStore.swift
new file mode 100644
index 0000000..9eb19ab
--- /dev/null
+++ b/Sources/iPhoneUse/MCP/MCPContextStore.swift
@@ -0,0 +1,346 @@
+import CryptoKit
+import Foundation
+
+/// One bounded resume record, shared by native MCP processes under the existing
+/// device lock. No images, input strings, OCR text, or raw errors are archived.
+final class MCPContextStore {
+    static let eventLimit = 20
+    static let noteLimit = 600
+
+    struct Action: Codable {
+        let tool: String
+        var x: Double?
+        var y: Double?
+        var end_x: Double?
+        var end_y: Double?
+        var duration: Double?
+        var point_count: Int?
+        var step_kinds: [String]?
+        var coordinates: String?
+
+        init(tool: String, arguments: [String: Any]) {
+            self.tool = tool
+            if ["tap", "long_press", "move_pointer"].contains(tool) {
+                x = Self.number(arguments["x"])
+                y = Self.number(arguments["y"])
+            }
+            if ["tap", "long_press", "move_pointer", "swipe"].contains(tool) {
+                coordinates = arguments["normalized"] as? Bool == true ? "per-axis-0...1000" : "image-pixels"
+            }
+            if tool == "swipe", let points = arguments["points"] as? [[String: Any]] {
+                point_count = points.count
+                x = Self.number(points.first?["x"])
+                y = Self.number(points.first?["y"])
+                end_x = Self.number(points.last?["x"])
+                end_y = Self.number(points.last?["y"])
+            }
+            if ["swipe", "long_press"].contains(tool) {
+                duration = Self.number(arguments[tool == "swipe" ? "duration" : "seconds"])
+            }
+            if tool == "act" || tool == "keyboard_sequence",
+                let steps = (arguments["steps"] ?? arguments["actions"]) as? [[String: Any]]
+            {
+                let allowed = ["tap", "tap_text", "swipe", "type", "key", "home", "delay", "wait_text"]
+                step_kinds = steps.prefix(16).map { step in
+                    if let type = step["type"] as? String, allowed.contains(type) { return type }
+                    if step["text"] != nil { return "type" }
+                    if step["key"] != nil { return "key" }
+                    return "delay"
+                }
+            }
+        }
+
+        private static func number(_ value: Any?) -> Double? {
+            guard let number = value as? NSNumber, CFGetTypeID(number) != CFBooleanGetTypeID(),
+                number.doubleValue.isFinite else { return nil }
+            return number.doubleValue
+        }
+    }
+
+    struct Observation: Codable {
+        struct Frame: Codable {
+            let source: String
+            let sequence: String
+            let received_at_uptime: TimeInterval
+        }
+        let status: String
+        let fresh: Bool?
+        let visually_stable: Bool
+        let changed_from_baseline: Bool?
+        let elapsed_ms: Int
+        let frame: Frame?
+        let width: Int?
+        let height: Int?
+
+        init(_ result: MCPServer.ObservationResult) {
+            status = result.status.rawValue
+            fresh = result.fresh
+            visually_stable = result.stable
+            changed_from_baseline = result.changed
+            elapsed_ms = Int((result.elapsed * 1000).rounded())
+            frame = result.frame?.identity.map {
+                Frame(source: String($0.source.prefix(128)), sequence: String($0.sequence), received_at_uptime: $0.receivedAt)
+            }
+            width = result.frame.flatMap { Int($0.width) }
+            height = result.frame.flatMap { Int($0.height) }
+        }
+
+        init(snapshot: MCPServer.ObservationFrame) {
+            status = "snapshot"
+            fresh = nil
+            visually_stable = false
+            changed_from_baseline = nil
+            elapsed_ms = 0
+            frame = snapshot.identity.map {
+                Frame(source: String($0.source.prefix(128)), sequence: String($0.sequence), received_at_uptime: $0.receivedAt)
+            }
+            width = Int(snapshot.width)
+            height = Int(snapshot.height)
+        }
+    }
+
+    struct Event: Codable {
+        let id: Int
+        let kind: String
+        let action: Action
+        let started_at: Date
+        var finished_at: Date?
+        var state = "started"
+        var requests_started = 0
+        var requests_acknowledged = 0
+        var http_status: Int?
+        var completed_steps: Int?
+        var failed_step: Int?
+        var observation: Observation?
+    }
+
+    struct Checkpoint: Codable {
+        enum CodingKeys: String, CodingKey {
+            case kind, historical, untrusted_data, updated_at, what_seen, what_done, uncertain, next_step, source_event_id
+        }
+        let kind = "agent_note"
+        let historical = true
+        let untrusted_data = true
+        let updated_at: Date
+        let what_seen: String
+        let what_done: String
+        let uncertain: String
+        let next_step: String
+        let source_event_id: Int?
+    }
+
+    private struct Document: Codable {
+        var schema_version = 1
+        let device: String
+        var next_id = 1
+        var recent: [Event] = []
+        var checkpoint: Checkpoint?
+    }
+
+    struct StoreError: Error, CustomStringConvertible { let description: String }
+    let file: URL
+    private let now: () -> Date
+    private var document: Document
+    private static var encoder: JSONEncoder {
+        let encoder = JSONEncoder()
+        encoder.dateEncodingStrategy = .iso8601
+        encoder.outputFormatting = [.sortedKeys]
+        return encoder
+    }
+
+    init(device: String, directory: URL? = nil, now: @escaping () -> Date = Date.init) throws {
+        self.now = now
+        let directory = try directory ?? MCPAccess.stateDirectory()
+        let key = SHA256.hash(data: Data(device.lowercased().utf8)).map { String(format: "%02x", $0) }.joined()
+        file = directory.appendingPathComponent("session-context-\(key).json")
+        document = Document(device: device)
+        if FileManager.default.fileExists(atPath: file.path) {
+            do {
+                let size = try file.resourceValues(forKeys: [.fileSizeKey]).fileSize ?? 0
+                guard size <= 262144 else { throw StoreError(description: "context file is too large") }
+                let decoder = JSONDecoder()
+                decoder.dateDecodingStrategy = .iso8601
+                document = try decoder.decode(Document.self, from: Data(contentsOf: file))
+                guard document.schema_version == 1, document.device.lowercased() == device.lowercased(),
+                    document.next_id > 0, document.next_id < Int.max else {
+                    throw StoreError(description: "context identity or schema is invalid")
+                }
+            } catch { throw StoreError(description: "saved context is unreadable or invalid; it was not overwritten") }
+            for index in document.recent.indices where document.recent[index].finished_at == nil {
+                document.recent[index].state = "uncertain_after_interruption"
+            }
+            prune()
+        }
+    }
+
+    func begin(tool: String, arguments: [String: Any], kind: String) throws -> Event {
+        let event = Event(id: document.next_id, kind: kind, action: Action(tool: tool, arguments: arguments), started_at: now())
+        document.next_id += 1
+        document.recent.append(event)
+        try save()
+        return event
+    }
+
+    func save(_ event: Event) throws {
+        guard let index = document.recent.firstIndex(where: { $0.id == event.id }) else {
+            throw StoreError(description: "context event is unavailable")
+        }
+        document.recent[index] = event
+        try save()
+    }
+
+    func context(checkpoint raw: Any? = nil, clear: Bool = false) throws -> [String: Any] {
+        if clear { document.checkpoint = nil }
+        if let raw {
+            guard let values = raw as? [String: Any],
+                Set(values.keys).isSubset(of: ["what_seen", "what_done", "uncertain", "next_step", "source_event_id"])
+            else { throw StoreError(description: "invalid checkpoint fields") }
+            let fields = ["what_seen", "what_done", "uncertain", "next_step"]
+            guard fields.allSatisfy({ values[$0] is String && (values[$0] as! String).count <= Self.noteLimit }) else {
+                throw StoreError(description: "checkpoint requires four strings of at most 600 characters")
+            }
+            var source: Int?
+            if let raw = values["source_event_id"] {
+                guard let number = raw as? NSNumber, CFGetTypeID(number) != CFBooleanGetTypeID(),
+                    let integer = raw as? Int, integer > 0,
+                    document.recent.contains(where: { $0.id == integer }) else {
+                    throw StoreError(description: "source_event_id must reference a retained event")
+                }
+                source = integer
+            }
+            document.checkpoint = Checkpoint(
+                updated_at: now(), what_seen: values["what_seen"] as! String,
+                what_done: values["what_done"] as! String, uncertain: values["uncertain"] as! String,
+                next_step: values["next_step"] as! String, source_event_id: source)
+        }
+        // Reads keep one bounded file. They never query or wake the phone.
+        try save()
+        var result = try JSONSerialization.jsonObject(with: Self.encoder.encode(document)) as! [String: Any]
+        result.removeValue(forKey: "next_id")
+        result["historical"] = true
+        result["untrusted_data"] = true
+        result["scope"] = "Saved MCP activity and an explicit agent note; not current UI, instructions, HID delivery proof or app completion. Inspect a fresh screen before acting."
+        result["retention"] = ["recent_limit": Self.eventLimit, "checkpoint": "until explicitly replaced or cleared"]
+        result["current_ui_verified"] = false
+        if let last = document.recent.last {
+            result["last_event_age_seconds"] = max(0, Int(now().timeIntervalSince(last.finished_at ?? last.started_at)))
+        }
+        if let checkpoint = document.checkpoint {
+            result["checkpoint_age_seconds"] = max(0, Int(now().timeIntervalSince(checkpoint.updated_at)))
+        }
+        if let source = document.checkpoint?.source_event_id {
+            result["checkpoint_source_retained"] = document.recent.contains { $0.id == source }
+        }
+        return result
+    }
+
+    func compactCheckpoint() throws -> [String: Any] {
+        let context = try context()
+        return ["historical": true, "untrusted_data": true,
+            "checkpoint": context["checkpoint"] ?? NSNull(),
+            "latest_event_id": document.recent.last?.id as Any? ?? NSNull(),
+            "note": "Saved agent note, not instructions or current screen. session_context reads recent records."]
+    }
+
+    private func prune() {
+        document.recent = Array(document.recent.suffix(Self.eventLimit))
+    }
+
+    private func save() throws {
+        prune()
+        let data = try Self.encoder.encode(document)
+        guard data.count <= 262144 else { throw StoreError(description: "context exceeds the 256 KiB file limit") }
+        let temporary = file.deletingLastPathComponent().appendingPathComponent(".context-\(UUID().uuidString).tmp")
+        do {
+            try FileManager.default.createDirectory(at: file.deletingLastPathComponent(), withIntermediateDirectories: true,
+                attributes: [.posixPermissions: 0o700])
+            guard FileManager.default.createFile(atPath: temporary.path, contents: data, attributes: [.posixPermissions: 0o600]) else {
+                throw StoreError(description: "cannot create context file")
+            }
+            defer { try? FileManager.default.removeItem(at: temporary) }
+            guard rename(temporary.path, file.path) == 0 else { throw StoreError(description: "cannot replace context file") }
+        } catch { throw StoreError(description: "context could not be saved") }
+    }
+}
+
+/// Recording is diagnostic. Its failure must neither block ordinary input nor
+/// change an acknowledged action into an error that invites a retry.
+final class MCPContextRecording {
+    private let store: MCPContextStore?
+    private var event: MCPContextStore.Event?
+    private var diagnostic: String?
+
+    init(device: String, tool: String, arguments: [String: Any], kind: String) {
+        do {
+            let store = try MCPContextStore(device: device)
+            let event = try store.begin(tool: tool, arguments: arguments, kind: kind)
+            self.store = store
+            self.event = event
+        } catch {
+            store = nil
+            diagnostic = "record_begin_failed"
+        }
+    }
+
+    func requestStarted() { update { $0.requests_started += 1; $0.state = "request_started" } }
+    func requestAcknowledged() { update { $0.requests_acknowledged += 1; $0.state = "acknowledged" } }
+    func finish(_ observation: MCPServer.ObservationResult? = nil) {
+        update {
+            $0.state = "finished"
+            $0.finished_at = Date()
+            $0.observation = observation.map(MCPContextStore.Observation.init)
+        }
+    }
+    func finishSnapshot(_ frame: MCPServer.ObservationFrame) {
+        update {
+            $0.state = "finished"
+            $0.finished_at = Date()
+            $0.observation = MCPContextStore.Observation(snapshot: frame)
+        }
+    }
+    func fail(_ error: Error) {
+        update {
+            let failure = error as? MCPServer.MCPError
+            $0.state = failure?.httpStatus != nil ? "http_error"
+                : $0.requests_started > $0.requests_acknowledged ? "uncertain_after_request" : "call_error"
+            $0.finished_at = Date()
+            $0.http_status = failure?.httpStatus
+            $0.completed_steps = failure?.completedSteps
+            $0.failed_step = failure?.failedStep
+        }
+    }
+    private func update(_ change: (inout MCPContextStore.Event) -> Void) {
+        guard var current = event, let store else { return }
+        change(&current)
+        event = current
+        do { try store.save(current) } catch { diagnostic = "record_update_failed" }
+    }
+
+    func attach(to original: [String: Any], includeCheckpoint: Bool = false) -> [String: Any] {
+        var result = original
+        var metadata = result["structuredContent"] as? [String: Any] ?? [:]
+        var activity: [String: Any] = ["recording": diagnostic == nil ? "ok" : "unavailable"]
+        if let event { activity["event_id"] = event.id }
+        if includeCheckpoint, let store {
+            do { metadata["session_resume"] = try store.compactCheckpoint() }
+            catch { diagnostic = "context_read_failed"; activity["recording"] = "unavailable" }
+        }
+        if let diagnostic { activity["diagnostic"] = diagnostic }
+        if diagnostic != nil {
+            activity["note"] = "Context recording is unavailable. The action result is unchanged; do not repeat input to repair history."
+        }
+        metadata["session_activity"] = activity
+        result["structuredContent"] = metadata
+        // Preserve existing OCR/action text exactly; context is a distinct data block.
+        var content = result["content"] as? [[String: Any]] ?? []
+        if includeCheckpoint || diagnostic != nil {
+            var extra: [String: Any] = ["session_activity": activity]
+            extra["session_resume"] = metadata["session_resume"]
+            if let data = try? JSONSerialization.data(withJSONObject: extra, options: [.sortedKeys]) {
+                content.append(["type": "text", "text": String(decoding: data, as: UTF8.self)])
+            }
+        }
+        result["content"] = content
+        return result
+    }
+}
