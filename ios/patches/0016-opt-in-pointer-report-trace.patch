diff --git a/Tests/iPhoneUseTests/Bluetooth/HIDPointerTraceTests.swift b/Tests/iPhoneUseTests/Bluetooth/HIDPointerTraceTests.swift
new file mode 100644
index 0000000..e06e114
--- /dev/null
+++ b/Tests/iPhoneUseTests/Bluetooth/HIDPointerTraceTests.swift
@@ -0,0 +1,169 @@
+import Foundation
+import XCTest
+
+@testable import iPhoneUse
+
+final class HIDPointerTraceTests: XCTestCase {
+    private let host = UUID()
+    private let other = UUID()
+
+    func testIdenticalRelativeReportsKeepDistinctIDsAndRetryKeepsTheSameHead() throws {
+        var state = HIDConnectionState()
+        var events: [String] = []
+        var permissionReads = 0
+        state.onTrace = { event, report, _ in events.append("\(event):\(report.traceID ?? "nil")") }
+        state.subscribe(.report(.relativeMouse), host: host)
+        let session = try XCTUnwrap(state.sessions[host])
+        for id in ["first", "second"] {
+            state.enqueue(.report(.relativeMouse), data: Data([1, 0, 8, 0]), host: host, session: session,
+                isAllowed: { permissionReads += 1; return true }, traceID: id)
+        }
+        XCTAssertEqual(events, ["enqueued:first", "enqueued:second"])
+        XCTAssertEqual(permissionReads, 2)
+        let blocked = try XCTUnwrap(state.nextPendingReportIndex())
+        XCTAssertEqual(blocked.report.traceID, "first")
+        // updateValue(false) leaves this entry in place. A later drain must retry
+        // its identity, not turn an identical second report into the same event.
+        let retried = try XCTUnwrap(state.nextPendingReportIndex())
+        XCTAssertEqual(retried.report.traceID, "first")
+        XCTAssertEqual(retried.report.data, Data([1, 0, 8, 0]))
+        XCTAssertEqual(state.pending.count, 2)
+        state.removePending(at: retried.index)
+        XCTAssertEqual(try XCTUnwrap(state.nextPendingReportIndex()).report.traceID, "second")
+        XCTAssertEqual(permissionReads, 5, "trace must not evaluate a permission a second time")
+        XCTAssertEqual(events.count, 2, "queue inspection/retry does not fabricate another enqueue")
+    }
+
+    func testEnqueueRejectionsHaveActualReasonsWithoutExtraPermissionReads() throws {
+        var state = HIDConnectionState(hostSelection: .only(host))
+        var discarded: [String] = []
+        var permissionReads = 0
+        state.onTrace = { event, report, reason in
+            if event == "discard" { discarded.append("\(report.traceID ?? "nil"):\(reason ?? "nil")") }
+        }
+        state.subscribe(.report(.relativeMouse), host: host)
+        state.subscribe(.report(.relativeMouse), host: other)
+        let session = try XCTUnwrap(state.sessions[host])
+        let permission = { permissionReads += 1; return false }
+        state.enqueue(.report(.relativeMouse), data: Data([1, 0, 8, 0]), host: other,
+            session: state.sessions[other], isAllowed: permission, traceID: "host")
+        state.enqueue(.report(.absolutePointer), data: Data([0, 1, 0, 2, 0]), host: host,
+            session: session, isAllowed: permission, traceID: "subscription")
+        state.enqueue(.report(.relativeMouse), data: Data([1, 0, 8, 0]), host: host,
+            session: UUID(), isAllowed: permission, traceID: "session")
+        XCTAssertEqual(permissionReads, 0)
+        state.enqueue(.report(.relativeMouse), data: Data([1, 0, 8, 0]), host: host,
+            session: session, isAllowed: permission, traceID: "association")
+        XCTAssertEqual(permissionReads, 1)
+        state.enqueue(.report(.relativeMouse), data: Data([0, 0, 0, 0]), host: host,
+            session: session, isAllowed: permission, traceID: "release")
+        XCTAssertEqual(permissionReads, 1, "neutral release retains the existing bypass")
+        XCTAssertEqual(discarded, ["host:host_excluded", "subscription:not_subscribed",
+            "session:stale_session", "association:association_denied"])
+        XCTAssertEqual(state.pending.map(\.traceID), ["release"])
+    }
+
+    func testCoalescingUnsubscribeAndResetTerminateTheOriginalReportIDs() throws {
+        var state = HIDConnectionState()
+        var discarded: [String] = []
+        state.onTrace = { event, report, reason in
+            if event == "discard" { discarded.append("\(report.traceID ?? "nil"):\(reason ?? "nil")") }
+        }
+        for id in [ReportID.absolutePointer, .relativeMouse] { state.subscribe(.report(id), host: host) }
+        state.subscribe(.report(.relativeMouse), host: other)
+        let session = try XCTUnwrap(state.sessions[host])
+        for id in ["abs-old", "abs-new"] {
+            state.enqueue(.report(.absolutePointer), data: Data([0, 1, 0, 2, 0]), host: host,
+                session: session, traceID: id)
+        }
+        for id in ["rel-first", "rel-second"] {
+            state.enqueue(.report(.relativeMouse), data: Data([1, 0, 8, 0]), host: host,
+                session: session, traceID: id)
+        }
+        XCTAssertEqual(state.pending.map(\.traceID), ["abs-new", "rel-first", "rel-second"])
+        state.unsubscribe(.report(.relativeMouse), host: host)
+        state.enqueue(.report(.relativeMouse), data: Data([1, 0, 8, 0]), host: other,
+            session: state.sessions[other], traceID: "other")
+        state.reset()
+        XCTAssertTrue(state.pending.isEmpty)
+        XCTAssertEqual(discarded, ["abs-old:absolute_coalesced", "rel-first:unsubscribed",
+            "rel-second:unsubscribed", "abs-new:connection_reset", "other:connection_reset"])
+    }
+
+    func testPendingInvalidationTracePreservesReleaseAndExistingDropObserver() throws {
+        var state = HIDConnectionState()
+        var discarded: [String] = []
+        var dropped: [String?] = []
+        var allowed = true
+        var permissionReads = 0
+        state.onTrace = { event, report, reason in
+            if event == "discard" { discarded.append("\(report.traceID ?? "nil"):\(reason ?? "nil")") }
+        }
+        state.subscribe(.report(.relativeMouse), host: host)
+        let session = try XCTUnwrap(state.sessions[host])
+        let permission = { permissionReads += 1; return allowed }
+        state.enqueue(.report(.relativeMouse), data: Data([1, 0, 8, 0]), host: host,
+            session: session, isAllowed: permission, traceID: "movement")
+        state.enqueue(.report(.relativeMouse), data: Data([0, 0, 0, 0]), host: host,
+            session: session, isAllowed: permission, traceID: "release")
+        allowed = false
+        let next = try XCTUnwrap(state.nextPendingReportIndex(onDrop: { dropped.append($0.traceID) }))
+        XCTAssertEqual(next.report.traceID, "release")
+        XCTAssertEqual(permissionReads, 2)
+        XCTAssertEqual(discarded, ["movement:association_denied"])
+        XCTAssertEqual(dropped, ["movement"])
+    }
+
+    func testTraceObserverLeavesQueueAndPermissionEvaluationUnchanged() throws {
+        var results: [[Data]] = []
+        var counts: [Int] = []
+        for tracing in [false, true] {
+            var state = HIDConnectionState()
+            if tracing { state.onTrace = { _, _, _ in } }
+            state.subscribe(.report(.relativeMouse), host: host)
+            let session = try XCTUnwrap(state.sessions[host])
+            var reads = 0
+            let permission = { reads += 1; return reads <= 2 }
+            for id in ["first", "second"] {
+                state.enqueue(.report(.relativeMouse), data: Data([1, 0, 8, 0]), host: host,
+                    session: session, isAllowed: permission, traceID: tracing ? id : nil)
+            }
+            state.enqueue(.report(.relativeMouse), data: Data([0, 0, 0, 0]), host: host,
+                session: session, isAllowed: permission)
+            var sent: [Data] = []
+            while let next = state.nextPendingReportIndex() {
+                sent.append(next.report.data)
+                state.removePending(at: next.index)
+            }
+            results.append(sent)
+            counts.append(reads)
+        }
+        XCTAssertEqual(results[0], results[1])
+        XCTAssertEqual(results[0], [Data([0, 0, 0, 0])])
+        XCTAssertEqual(counts, [4, 4])
+    }
+
+    func testTraceRowsKeepAcceptanceSeparateFromDeliveryAndExcludeKeyboardBytes() throws {
+        XCTAssertNil(HIDPointerTrace.row("offered", traceID: "a", host: host, session: nil,
+            report: .relativeMouse, bytes: [1, 0, 8, 0], uptime: 100, enabled: false))
+        XCTAssertNil(HIDPointerTrace.row("offered", traceID: "a", host: host, session: nil,
+            report: .keyboard, bytes: [0, 0, 4, 0, 0, 0, 0, 0], uptime: 100, enabled: true))
+        let row = try XCTUnwrap(HIDPointerTrace.row("notify", traceID: "same-on-every-retry", host: host,
+            session: UUID(), report: .relativeMouse, bytes: [1, 0, 8, 0], accepted: true,
+            uptime: 1234.56789, enabled: true))
+        let encoded = try JSONSerialization.data(withJSONObject: row)
+        let decoded = try XCTUnwrap(JSONSerialization.jsonObject(with: encoded) as? [String: Any])
+        XCTAssertEqual(decoded["trace_id"] as? String, "same-on-every-retry")
+        XCTAssertEqual(decoded["uptime"] as? Double, 1234.56789)
+        XCTAssertEqual(decoded["bytes"] as? [Int], [1, 0, 8, 0])
+        XCTAssertEqual(decoded["corebluetooth_accepted"] as? Bool, true)
+        XCTAssertNil(decoded["delivered"])
+        XCTAssertNil(decoded["hid_delivery"])
+        let retry = try XCTUnwrap(HIDPointerTrace.row("notify", traceID: "same-on-every-retry", host: host,
+            session: nil, report: .relativeMouse, bytes: [1, 0, 8, 0], accepted: false,
+            uptime: 1234.5, enabled: true))
+        XCTAssertEqual(retry["trace_id"] as? String, decoded["trace_id"] as? String)
+        XCTAssertEqual(retry["corebluetooth_accepted"] as? Bool, false)
+        XCTAssertLessThan(retry["uptime"] as? Double ?? .infinity, decoded["uptime"] as? Double ?? -.infinity)
+    }
+}
