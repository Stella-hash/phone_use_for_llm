+/// Temporary, opt-in diagnostic rows in the existing host log. No file, queue,
+/// protocol or delivery acknowledgement is introduced. Clock values share the
+/// capture-frame systemUptime domain; repeated notify rows with one ID are retries.
+enum HIDPointerTrace {
+    static let enabled = ProcessInfo.processInfo.environment["IPHONE_USE_TRACE_POINTER"] == "1"
+
+    static func makeID(_ report: ReportID) -> String? {
+        enabled && (report == .absolutePointer || report == .relativeMouse) ? UUID().uuidString : nil
+    }
+
+    static func row(
+        _ event: String, traceID: String?, host: UUID, session: UUID?, report: ReportID?,
+        bytes: [UInt8]?, reason: String? = nil, accepted: Bool? = nil,
+        uptime: TimeInterval, enabled: Bool
+    ) -> [String: Any]? {
+        guard enabled, report == nil || report == .absolutePointer || report == .relativeMouse else { return nil }
+        var row: [String: Any] = ["event": event, "uptime": uptime, "host": host.uuidString]
+        row["trace_id"] = traceID
+        row["session"] = session?.uuidString
+        row["report"] = report.map { String(describing: $0) }
+        row["bytes"] = bytes
+        row["reason"] = reason
+        // true means CoreBluetooth accepted the notification, never that iOS
+        // received/applied it. false leaves this report queued for another try.
+        row["corebluetooth_accepted"] = accepted
+        return row
+    }
+
+    static func emit(
+        _ event: String, traceID: String?, host: UUID, session: UUID?, report: ReportID? = nil,
+        bytes: [UInt8]? = nil, reason: String? = nil, accepted: Bool? = nil
+    ) {
+        guard enabled else { return }
+        guard let row = row(
+            event, traceID: traceID, host: host, session: session, report: report, bytes: bytes,
+            reason: reason, accepted: accepted, uptime: ProcessInfo.processInfo.systemUptime, enabled: enabled)
+        else { return }
+        do {
+            let data = try JSONSerialization.data(withJSONObject: row, options: [.sortedKeys])
+            log("pointer_trace " + String(decoding: data, as: UTF8.self))
+        } catch { log("pointer_trace encoding_failed; trace is incomplete") }
+    }
+
+    static func pending(_ event: String, _ report: HIDConnectionState.PendingReport, reason: String? = nil, accepted: Bool? = nil) {
+        guard enabled, case .report(let id) = report.channel else { return }
+        emit(event, traceID: report.traceID, host: report.host, session: report.session,
+            report: id, bytes: [UInt8](report.data), reason: reason, accepted: accepted)
+    }
+}
