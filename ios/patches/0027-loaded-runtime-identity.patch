+            live, replacement = directory / "identity", directory / "replacement"
+            for marker, output in [("A", live), ("B", replacement)]:
+                main.write_text('import Darwin\nimport Foundation\nprint("' + marker + '")\nfflush(stdout)\n'
+                                'while readLine() != nil {\n'
+                                ' let data = try JSONSerialization.data(withJSONObject: RuntimeIdentity.current.json)\n'
+                                ' print(String(decoding: data, as: UTF8.self)); fflush(stdout)\n}\n')
+                built = subprocess.run(["xcrun", "swiftc", str(source), str(main), "-o", str(output)],
+                                       capture_output=True, text=True, timeout=60)
+                self.assertEqual(built.returncode, 0, built.stderr)
+            def read(process):
