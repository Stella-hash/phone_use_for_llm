+import Foundation
+
+struct ScreenCaptureStopResult: Equatable {
+    let initiated: Bool
+    let captureDrained: Bool
+    let usbRestored: Bool
+
+    var isClean: Bool { initiated && captureDrained && usbRestored }
+}
+
+/// Enforces a single monotonic deadline across asynchronous capture session
+/// shutdown and post-drain USB configuration restoration.
+enum CaptureShutdownCoordinator {
+    static func stop(
+        waitTimeout: TimeInterval,
+        activeSources: [StoppableCaptureSource],
+        pendingUSBOperations: [StoppableCaptureSource] = [],
+        notifyQueue: DispatchQueue,
+        restoreAllUSB: @escaping (_ deadlineUptime: TimeInterval) -> Bool
+    ) -> ScreenCaptureStopResult {
+        let boundedWait = (waitTimeout.isFinite && waitTimeout > 0) ? waitTimeout : 0
+        let deadline = ProcessInfo.processInfo.systemUptime + boundedWait
+
+        let group = DispatchGroup()
+        let allResources = DispatchGroup()
+        for source in activeSources {
+            group.enter()
+            allResources.enter()
+            source.stop { group.leave(); allResources.leave() }
+        }
+        for operation in pendingUSBOperations {
+            allResources.enter()
+            operation.stop { allResources.leave() }
+        }
+
+        let usbDone = DispatchSemaphore(value: 0)
+        let resultLock = NSLock()
+        var usbClean = false
+        allResources.notify(queue: notifyQueue) {
+            let restored = restoreAllUSB(deadline)
+            resultLock.withLock { usbClean = restored }
+            usbDone.signal()
+        }
+
+        guard boundedWait > 0 else {
+            let drained = activeSources.isEmpty
+            let restoredNow =
+                drained
+                && (usbDone.wait(timeout: .now()) == .success)
+                && resultLock.withLock({ usbClean })
+            return ScreenCaptureStopResult(
+                initiated: true,
+                captureDrained: drained,
+                usbRestored: restoredNow)
+        }
+
+        let captureDrained: Bool
+        if activeSources.isEmpty {
+            captureDrained = true
+        } else {
+            let remainingForCapture = deadline - ProcessInfo.processInfo.systemUptime
+            if remainingForCapture > 0 {
+                captureDrained = group.wait(timeout: .now() + remainingForCapture) == .success
+            } else {
+                captureDrained = group.wait(timeout: .now()) == .success
+            }
+        }
+
+        guard captureDrained else {
+            return ScreenCaptureStopResult(
+                initiated: true,
+                captureDrained: false,
+                usbRestored: false)
+        }
+
+        let remainingForUSB = deadline - ProcessInfo.processInfo.systemUptime
+        let waitedOK: Bool
+        if remainingForUSB > 0 {
+            waitedOK = usbDone.wait(timeout: .now() + remainingForUSB) == .success
+        } else {
+            waitedOK = usbDone.wait(timeout: .now()) == .success
+        }
+        let usbRestored = waitedOK && resultLock.withLock({ usbClean })
+        return ScreenCaptureStopResult(
+            initiated: true,
+            captureDrained: true,
+            usbRestored: usbRestored)
+    }
+}
+
+
+protocol StoppableCaptureSource: AnyObject {
+    func stop(completion: (() -> Void)?)
+}
+
+/// A reservation owns an in-progress constructor as well as the resulting source.
+/// A stop before attach waits for attach (or construction failure), and every
+/// waiter observes the same, single underlying stop. No callback runs under lock.
+final class CaptureResourceLease: StoppableCaptureSource {
+    let token: UUID
+    private let lock = NSLock()
+    private var source: StoppableCaptureSource?
+    private var stopRequested = false
+    private var stopStarted = false
+    private var completed = false
+    private var completions: [() -> Void] = []
+
+    init(token: UUID = UUID(), onDrained: @escaping () -> Void = {}) {
+        self.token = token
+        completions = [onDrained]
+    }
+
+    func attach(_ source: StoppableCaptureSource) {
+        let shouldStop = lock.withLock { () -> Bool in
+            precondition(self.source == nil && !completed)
+            self.source = source
+            guard stopRequested else { return false }
+            stopStarted = true
+            return true
+        }
+        if shouldStop { source.stop { self.finish() } }
+    }
+
+    /// Also completes a failed constructor or a synchronous USB operation lease.
+    func finish() {
+        let callbacks: [() -> Void] = lock.withLock {
+            guard !completed else { return [] }
+            completed = true
+            source = nil
+            let callbacks = completions
+            completions.removeAll()
+            return callbacks
+        }
+        callbacks.forEach { $0() }
+    }
+
+    func stop(completion: (() -> Void)?) {
+        let action: (StoppableCaptureSource?, Bool) = lock.withLock {
+            if completed { return (nil, true) }
+            if let completion { completions.append(completion) }
+            stopRequested = true
+            guard !stopStarted, let source else { return (nil, false) }
+            stopStarted = true
+            return (source, false)
+        }
+        if action.1 { completion?() }
+        action.0?.stop { self.finish() }
+    }
+}
+
+/// The manager's ownership authority. All methods run under its lock; AV/IOKit
+/// work and lease callbacks run outside it. Published sources are only a lookup
+/// index: removal from that index does not release this resource ownership.
+struct CaptureLifecycleOwnership {
+    struct DiscoveryTicket: Equatable {
+        let generation: UInt64
+        let sequence: UInt64
+    }
+    private struct Resource {
+        let sourceID: String?
+        let entryID: UInt64?
+        let lease: CaptureResourceLease
+        let isUSBOperation: Bool
+        var published = false
+        var retiring = false
+        var isDeferredRestore = false
+        var deferredAttempt: UInt64 = 0
+        var whenReady: ((CaptureResourceLease) -> Void)?
+    }
+    private var resources: [UUID: Resource] = [:]
+    private var shutdowns: Set<UUID> = []
+    private var discoveryScheduled = false
+    private var pendingDiscovery: UInt64?
+    private var currentDiscovery: DiscoveryTicket?
+    private var discoverySequence: UInt64 = 0
+
+    /// One worker owns snapshot -> apply. Any number of concurrent requests
+    /// become one fresh follow-up snapshot, never a replay of an old device list.
+    mutating func requestDiscovery(generation: UInt64) -> Bool {
+        pendingDiscovery = generation
+        guard !discoveryScheduled else { return false }
+        discoveryScheduled = true
+        return true
+    }
+
+    mutating func nextDiscovery() -> DiscoveryTicket? {
+        guard let generation = pendingDiscovery else {
+            discoveryScheduled = false
+            currentDiscovery = nil
+            return nil
+        }
+        pendingDiscovery = nil
+        discoverySequence &+= 1
+        let ticket = DiscoveryTicket(generation: generation, sequence: discoverySequence)
+        currentDiscovery = ticket
+        return ticket
+    }
+
+    mutating func invalidateDiscovery() {
+        pendingDiscovery = nil
+        currentDiscovery = nil
+        // The existing worker still owns its queue slot, even across stop/start.
+    }
+
+    func accepts(_ ticket: DiscoveryTicket, generation: UInt64) -> Bool {
+        ticket == currentDiscovery && ticket.generation == generation && shutdowns.isEmpty
+    }
+
+    private func conflicts(_ resource: Resource, sourceID: String?, entryID: UInt64?) -> Bool {
+        if let sourceID, sourceID == resource.sourceID { return true }
+        if let entryID, let ownedEntry = resource.entryID { return entryID == ownedEntry }
+        // An unknown physical identity cannot prove independence from a drain.
+        return resource.entryID == nil || entryID == nil
+    }
+
+    var hasShutdown: Bool { !shutdowns.isEmpty }
+    var hasCaptureResources: Bool { resources.values.contains { !$0.isUSBOperation } }
+
+    mutating func reserveSource(
+        id: String, entryID: UInt64?, lease: CaptureResourceLease
+    ) -> Bool {
+        guard shutdowns.isEmpty,
+            !resources.values.contains(where: {
+                if $0.sourceID == id { return true }
+                if !$0.retiring && !$0.isUSBOperation { return false }
+                return conflicts($0, sourceID: id, entryID: entryID)
+            })
+        else { return false }
+        resources[lease.token] = Resource(
+            sourceID: id, entryID: entryID, lease: lease, isUSBOperation: false)
+        return true
+    }
+
+    mutating func publish(_ lease: CaptureResourceLease) -> Bool {
+        guard var resource = resources[lease.token], !resource.retiring,
+            shutdowns.isEmpty else { return false }
+        resource.published = true
+        resources[lease.token] = resource
+        return true
+    }
+
+    mutating func retireSource(id: String) -> CaptureResourceLease? {
+        guard let token = resources.first(where: {
+            !$0.value.isUSBOperation && $0.value.sourceID == id && !$0.value.retiring
+        })?.key else { return nil }
+        resources[token]?.retiring = true
+        return resources[token]?.lease
+    }
+
+    func permitsUSB(sourceID: String?, entryID: UInt64?, excluding token: UUID? = nil) -> Bool {
+        guard shutdowns.isEmpty else { return false }
+        if let token, resources[token]?.isUSBOperation != true { return false }
+        return !resources.values.contains {
+            if $0.lease.token == token { return false }
+            guard $0.retiring || !$0.published || $0.isUSBOperation else { return false }
+            return conflicts($0, sourceID: sourceID, entryID: entryID)
+        }
+    }
+
+    mutating func reserveUSB(
+        sourceID: String?, entryID: UInt64?, lease: CaptureResourceLease
+    ) -> Bool {
+        guard permitsUSB(sourceID: sourceID, entryID: entryID) else { return false }
+        resources[lease.token] = Resource(
+            sourceID: sourceID, entryID: entryID, lease: lease, isUSBOperation: true)
+        return true
+    }
+
+    /// A denied live restore retains one admission lease until its conflicting
+    /// drain finishes. This is queued work, not a second USB switch ledger.
+    mutating func deferUSBRestore(
+        entryID: UInt64, lease: CaptureResourceLease,
+        reusing: CaptureResourceLease?, whenReady: @escaping (CaptureResourceLease) -> Void
+    ) -> Bool {
+        guard shutdowns.isEmpty else { return false }
+        if let existing = resources.values.first(where: { $0.isDeferredRestore && $0.entryID == entryID }) {
+            if existing.lease === reusing {
+                resources[existing.lease.token]?.whenReady = whenReady
+            }
+            return false // coalesced; the newly offered lease is not owned
+        }
+        var resource = Resource(sourceID: nil, entryID: entryID, lease: lease, isUSBOperation: true)
+        resource.isDeferredRestore = true
+        resource.whenReady = whenReady
+        resources[lease.token] = resource
+        return true
+    }
+
+    mutating func takeReadyUSBRestores() -> [(lease: CaptureResourceLease, attempt: UInt64, body: (CaptureResourceLease) -> Void)] {
+        guard shutdowns.isEmpty else { return [] }
+        var ready: [(CaptureResourceLease, UInt64, (CaptureResourceLease) -> Void)] = []
+        for token in Array(resources.keys) {
+            guard let resource = resources[token], let body = resource.whenReady,
+                permitsUSB(sourceID: nil, entryID: resource.entryID, excluding: token) else { continue }
+            resources[token]?.whenReady = nil
+            resources[token]?.deferredAttempt &+= 1
+            ready.append((resource.lease, resources[token]!.deferredAttempt, body))
+        }
+        return ready
+    }
+
+    /// A previous callback cannot release a lease already admitted for a newer
+    /// retry. A drain may finish between requeue and that callback's return.
+    func completedUSBRestoreAttempt(_ token: UUID, attempt: UInt64) -> Bool {
+        guard let resource = resources[token] else { return false }
+        return resource.deferredAttempt == attempt && resource.whenReady == nil
+    }
+
+    @discardableResult
+    mutating func release(_ token: UUID) -> Bool {
+        guard let resource = resources.removeValue(forKey: token) else { return false }
+        return resource.retiring || resource.isUSBOperation
+    }
+
+    mutating func beginShutdown() -> (
+        token: UUID, leases: [StoppableCaptureSource], usbOperations: [StoppableCaptureSource],
+        cancelledRestores: [CaptureResourceLease]
+    ) {
+        let token = UUID()
+        shutdowns.insert(token)
+        invalidateDiscovery()
+        let cancelled = resources.values.filter { $0.whenReady != nil }.map(\.lease)
+        for key in resources.keys {
+            resources[key]?.retiring = true
+            resources[key]?.whenReady = nil
+        }
+        return (
+            token, resources.values.filter { !$0.isUSBOperation }.map(\.lease),
+            resources.values.filter(\.isUSBOperation).map(\.lease), cancelled)
+    }
+
+    /// Called only after every lease drained AND the prior USB restore queue
+    /// work settled. A bounded stop timeout does not remove this admission fence.
+    mutating func finishShutdown(_ token: UUID) { shutdowns.remove(token) }
+
+    var diagnostic: [String: Any] {
+        let admission = hasShutdown ? "blocked_by_previous_shutdown" :
+            (resources.values.contains(where: { $0.retiring }) ? "waiting_for_conflicting_source_drain" :
+                (resources.values.contains(where: { $0.isUSBOperation }) ? "waiting_for_conflicting_usb_operation" : "ready"))
+        return [
+            "admission": admission,
+            "draining": resources.values.filter(\.retiring).count,
+            "opening": resources.values.filter { !$0.published && !$0.isUSBOperation && !$0.retiring }.count,
+            "usbOperations": resources.values.filter(\.isUSBOperation).count,
+            "deferredUSBRestores": resources.values.filter { $0.whenReady != nil }.count,
+            "shutdownPending": shutdowns.count,
+            "discoveryPending": pendingDiscovery != nil,
+            "discoverySequence": discoverySequence,
+        ]
+    }
+}
