diff --git a/Tests/iPhoneUseTests/Devices/DeviceInputCacheTests.swift b/Tests/iPhoneUseTests/Devices/DeviceInputCacheTests.swift
new file mode 100644
index 0000000..6696fec
--- /dev/null
+++ b/Tests/iPhoneUseTests/Devices/DeviceInputCacheTests.swift
@@ -0,0 +1,56 @@
+import Foundation
+import XCTest
+
+@testable import iPhoneUse
+
+final class DeviceInputCacheTests: XCTestCase {
+    private func input(session: UUID) -> DeviceInput {
+        DeviceInput(
+            host: UUID(), session: session, sleep: { _ in },
+            reportSender: { _, _ in
+                XCTFail("cache matching must not send input")
+            })
+    }
+
+    func testExpiredCaptureCannotMatchAReplacementEvenWithTheSameDeviceID() {
+        let session = UUID()
+        var capture: NSObject? = NSObject()
+        weak var lifetimeWitness = capture
+        let cached = DeviceRegistry.CachedInput(
+            input: input(session: session), screenID: "phone", screenObject: capture)
+        XCTAssertTrue(cached.matches(session: session, screenID: "phone", screenObject: capture))
+
+        // Quiet suspension drops the capture objects but keeps the BLE session
+        // and cached input. No allocator address-reuse trick is needed: once the
+        // weak referent expires, this entry must miss for every replacement.
+        capture = nil
+        XCTAssertNil(lifetimeWitness, "the input cache must not keep stopped captures alive")
+        XCTAssertNil(cached.screenObject)
+        let replacement = NSObject()
+        XCTAssertFalse(cached.matches(session: session, screenID: "phone", screenObject: replacement))
+        XCTAssertFalse(cached.matches(session: session, screenID: "phone", screenObject: nil))
+        XCTAssertFalse(cached.matches(session: session, screenID: nil, screenObject: nil))
+    }
+
+    func testLiveCaptureStillRequiresExactObjectDeviceIDSessionAndActiveInput() throws {
+        let session = UUID()
+        let capture = NSObject()
+        let currentInput = input(session: session)
+        let cached = DeviceRegistry.CachedInput(
+            input: currentInput, screenID: "phone", screenObject: capture)
+        XCTAssertTrue(cached.matches(session: session, screenID: "phone", screenObject: capture))
+        XCTAssertFalse(cached.matches(session: session, screenID: "phone", screenObject: NSObject()))
+        XCTAssertFalse(cached.matches(session: session, screenID: "another", screenObject: capture))
+        XCTAssertFalse(cached.matches(session: UUID(), screenID: "phone", screenObject: capture))
+        try currentInput.retireForCalibrationReload()
+        XCTAssertFalse(cached.matches(session: session, screenID: "phone", screenObject: capture))
+    }
+
+    func testIntentionallyUnboundProbeOnlyMatchesAnotherUnboundRequest() {
+        let session = UUID()
+        let cached = DeviceRegistry.CachedInput(input: input(session: session), screenID: nil, screenObject: nil)
+        XCTAssertTrue(cached.matches(session: session, screenID: nil, screenObject: nil))
+        XCTAssertFalse(cached.matches(session: session, screenID: "phone", screenObject: NSObject()))
+        XCTAssertFalse(cached.matches(session: UUID(), screenID: nil, screenObject: nil))
+    }
+}
