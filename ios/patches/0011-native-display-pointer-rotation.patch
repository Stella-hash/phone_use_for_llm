+final class DeviceDisplayMappingTests: XCTestCase {
+    private let deviceID = "00000000-0000000000000001"
+
+    private func envelope() -> [String: Any] {
+        ["schema_version": 1, "source": "ios-native-display", "status": "ok", "device_id": deviceID,
+            "display": ["native_orientation": "rot0", "current_orientation": "rot270", "rotation_degrees": 270,
+                "native_width": 1179, "native_height": 2556, "display_width": 2556, "display_height": 1179]]
+    }
+
+    func testNativeEnvelopeAcceptsObservedRasterRoundingButNotAStaleCapture() throws {
+        let mapping = try DeviceDisplayMapping(result: envelope(), deviceID: deviceID)
+        XCTAssertEqual(mapping.rotationDegrees, 270)
+        try mapping.validate(captureSize: CGSize(width: 2556, height: 1180))
+        XCTAssertThrowsError(try mapping.validate(captureSize: CGSize(width: 1180, height: 2556)))
+        XCTAssertThrowsError(try mapping.validate(captureSize: CGSize(width: 1000, height: 462)))
+        XCTAssertThrowsError(try mapping.validate(captureSize: nil))
+    }
+
+    func testMalformedUnavailableAndForeignDisplayEvidenceIsRejected() {
+        for invalid in [
+            envelope().merging(["device_id": "another-phone"]) { _, new in new },
+            envelope().merging(["source": "ios-native-ax"]) { _, new in new },
+            envelope().merging(["schema_version": true]) { _, new in new },
+            envelope().merging(["status": "unavailable"]) { _, new in new },
+        ] { XCTAssertThrowsError(try DeviceDisplayMapping(result: invalid, deviceID: deviceID)) }
+        for change: [String: Any] in [
+            ["current_orientation": "landscape"], ["rotation_degrees": 90], ["native_width": true],
+            ["native_width": 1179.5], ["display_width": 1179], ["native_height": 0],
+        ] {
+            var value = envelope()
+            let display = value["display"] as! [String: Any]
+            value["display"] = display.merging(change) { _, new in new }
+            XCTAssertThrowsError(try DeviceDisplayMapping(result: value, deviceID: deviceID))
+        }
+    }
+
+    func testRelativeRotationUsesNativeOrientationRatherThanPhysicalPhonePose() throws {
+        var value = envelope()
+        var display = value["display"] as! [String: Any]
+        display["native_orientation"] = "rot90"
+        display["current_orientation"] = "rot0"
+        value["display"] = display
+        XCTAssertEqual(try DeviceDisplayMapping(result: value, deviceID: deviceID).rotationDegrees, 270)
+    }
+
+    func testUnavailableBeforeIdentityPreservesTheActualBoundedReason() {
+        let unavailable: [String: Any] = [
+            "schema_version": 1, "source": "ios-native-display", "status": "unavailable",
+            "reason": ["code": "service_unavailable", "message": "Display service missing " + String(repeating: "x", count: 500)],
+        ]
+        XCTAssertThrowsError(try DeviceDisplayMapping(result: unavailable, deviceID: deviceID)) { error in
+            let detail = String(describing: error)
+            XCTAssertTrue(detail.contains("service_unavailable"))
+            XCTAssertTrue(detail.contains("Display service missing"))
+            XCTAssertFalse(detail.contains("identity does not match"))
+            XCTAssertLessThan(detail.utf8.count, 450)
+        }
+    }
+
+    func testAbsentProviderPreservesUpstreamButConfiguredWrongCaptureCannotLaunch() throws {
+        XCTAssertNil(DeviceDisplayMapping.provider(screenID: "phone", environment: [:]))
+        let environment = [DeviceAccessibility.helperKey: "/must-not-be-run", "IPHONE_USE_DEVICE_ID": "configured"]
+        let provider = try XCTUnwrap(DeviceDisplayMapping.provider(screenID: "other", environment: environment))
+        XCTAssertThrowsError(try provider()) { error in
+            XCTAssertTrue(String(describing: error).contains("exact configured capture"))
+        }
+    }
+}
