diff --git a/Sources/iPhoneUse/Input/DeviceDisplayMapping.swift b/Sources/iPhoneUse/Input/DeviceDisplayMapping.swift
new file mode 100644
index 0000000..29be4d0
--- /dev/null
+++ b/Sources/iPhoneUse/Input/DeviceDisplayMapping.swift
@@ -0,0 +1,111 @@
+import CoreFoundation
+import Foundation
+
+/// The display's rotation relative to the native HID axes, observed through
+/// CoreDevice for the configured USB phone. Capture aspect alone cannot identify
+/// which of the two landscape rotations is active.
+struct DeviceDisplayMapping: Equatable {
+    let rotationDegrees: Int
+    let nativeWidth: Int
+    let nativeHeight: Int
+
+    var displaySize: CGSize {
+        rotationDegrees == 90 || rotationDegrees == 270
+            ? CGSize(width: nativeHeight, height: nativeWidth)
+            : CGSize(width: nativeWidth, height: nativeHeight)
+    }
+
+    init(rotationDegrees: Int, nativeWidth: Int, nativeHeight: Int) throws {
+        guard [0, 90, 180, 270].contains(rotationDegrees),
+            (1...16384).contains(nativeWidth), (1...16384).contains(nativeHeight)
+        else { throw DeviceError("Native display returned an invalid rotation or size") }
+        self.rotationDegrees = rotationDegrees
+        self.nativeWidth = nativeWidth
+        self.nativeHeight = nativeHeight
+    }
+
+    init(result: [String: Any], deviceID: String) throws {
+        guard Self.integer(result["schema_version"]) == 1,
+            result["source"] as? String == "ios-native-display"
+        else { throw DeviceError("Native display returned an invalid observation envelope") }
+        if result["status"] as? String == "unavailable" {
+            // Opening the selected service can fail before an identity is
+            // available. Preserve that diagnosis rather than calling it a
+            // wrong-device response; only successful reads may authorize input.
+            let reason = result["reason"] as? [String: Any]
+            let code = Self.bounded(reason?["code"] as? String ?? "unavailable", bytes: 80)
+            let message = Self.bounded(reason?["message"] as? String ?? "", bytes: 240)
+            throw DeviceError(
+                "Native display orientation unavailable (\(code)): \(message); no coordinate input was sent by this read")
+        }
+        guard result["status"] as? String == "ok" else {
+            throw DeviceError("Native display returned an invalid observation status")
+        }
+        guard result["device_id"] as? String == deviceID else {
+            throw DeviceError("Native display identity does not match the configured USB phone")
+        }
+        guard let display = result["display"] as? [String: Any] else {
+            throw DeviceError("Native display returned no orientation; no coordinate input was sent by this read")
+        }
+        let rotations = ["rot0": 0, "rot90": 90, "rot180": 180, "rot270": 270]
+        guard let nativeName = display["native_orientation"] as? String,
+            let currentName = display["current_orientation"] as? String,
+            let native = rotations[nativeName], let current = rotations[currentName],
+            let rotation = Self.integer(display["rotation_degrees"]), rotation == (current - native + 360) % 360,
+            let width = Self.integer(display["native_width"]), let height = Self.integer(display["native_height"])
+        else { throw DeviceError("Native display orientation is malformed; no coordinate input was sent by this read") }
+        try self.init(rotationDegrees: rotation, nativeWidth: width, nativeHeight: height)
+        guard Self.integer(display["display_width"]) == Int(displaySize.width),
+            Self.integer(display["display_height"]) == Int(displaySize.height)
+        else { throw DeviceError("Native display dimensions disagree with its orientation") }
+    }
+
+    private static func bounded(_ value: String, bytes: Int) -> String {
+        String(decoding: value.utf8.prefix(bytes), as: UTF8.self)
+    }
+
+    private static func integer(_ value: Any?) -> Int? {
+        guard let number = value as? NSNumber, CFGetTypeID(number) != CFBooleanGetTypeID(),
+            number.doubleValue.isFinite, number.doubleValue == number.doubleValue.rounded(),
+            (-16384...16384).contains(number.doubleValue)
+        else { return nil }
+        return number.intValue
+    }
+
+    func validate(captureSize: CGSize?) throws {
+        guard let captureSize, captureSize.width.isFinite, captureSize.height.isFinite,
+            captureSize.width > 0, captureSize.height > 0,
+            // USB capture rasterizes the observed 1179-pixel native width to
+            // 1180. This allowance is for raster rounding, not inferred rotation.
+            abs(captureSize.width - displaySize.width) <= 2,
+            abs(captureSize.height - displaySize.height) <= 2
+        else { throw DeviceError("Native display orientation does not match the current capture dimensions") }
+    }
+
+    /// Inverse of the phone's HID-to-display map. Coordinates remain normalized
+    /// to the visible capture everywhere above this absolute-report boundary.
+    func hidPoint(x: Double, y: Double) -> (x: Double, y: Double) {
+        switch rotationDegrees {
+        case 90: (y, 1 - x)
+        case 180: (1 - x, 1 - y)
+        case 270: (1 - y, x)
+        default: (x, y)
+        }
+    }
+
+    /// No helper configured means unchanged upstream behavior. A configured but
+    /// invalid provider fails explicitly, never silently falls back to portrait.
+    static func provider(
+        screenID: String?, environment: [String: String] = ProcessInfo.processInfo.environment
+    ) -> (() throws -> DeviceDisplayMapping)? {
+        guard environment[DeviceAccessibility.helperKey] != nil else { return nil }
+        return {
+            guard let screenID, let selected = environment["IPHONE_USE_DEVICE_ID"], screenID == selected else {
+                throw DeviceError("Native display requires the exact configured capture device")
+            }
+            let configuration = try DeviceClipboard.Configuration(environment: environment)
+            return try DeviceDisplayMapping(
+                result: DeviceAccessibility.readDisplay(environment: environment), deviceID: configuration.deviceID)
+        }
+    }
+}
