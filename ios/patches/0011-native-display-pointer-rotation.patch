+import Foundation
+import XCTest
+
+@testable import iPhoneUse
+
+/// An independent host-side map. Tests assert displayed landings and presses,
+/// rather than comparing the implementation's inverse with itself.
+private final class RotatingAbsoluteHost {
+    var rotation = 0
+    var reports: [(ReportID, [UInt8])] = []
+    var point = CGPoint.zero
+    var presses: [CGPoint] = []
+
+    func send(_ id: ReportID, _ bytes: [UInt8]) {
+        reports.append((id, bytes))
+        if id == .absolutePointer {
+            let hx = Double(Int(bytes[1]) | Int(bytes[2]) << 8) / 32767
+            let hy = Double(Int(bytes[3]) | Int(bytes[4]) << 8) / 32767
+            switch rotation {
+            case 90: point = CGPoint(x: 1 - hy, y: hx)
+            case 180: point = CGPoint(x: 1 - hx, y: 1 - hy)
+            case 270: point = CGPoint(x: hy, y: 1 - hx)
+            default: point = CGPoint(x: hx, y: hy)
+            }
+        } else if id == .relativeMouse, bytes[0] == 1 {
+            presses.append(point)
+        }
+    }
+
+    var captureSize: CGSize {
+        rotation == 90 || rotation == 270 ? CGSize(width: 2556, height: 1180) : CGSize(width: 1180, height: 2556)
+    }
+
+    func mapping() throws -> DeviceDisplayMapping {
+        try DeviceDisplayMapping(rotationDegrees: rotation, nativeWidth: 1179, nativeHeight: 2556)
+    }
+}
+
+final class DeviceInputDisplayMappingTests: XCTestCase {
+    func testAllQuarterTurnsLandAtAsymmetricVisibleTargets() throws {
+        for rotation in [0, 90, 180, 270] {
+            let phone = RotatingAbsoluteHost()
+            phone.rotation = rotation
+            let input = DeviceInput(
+                host: UUID(), session: UUID(), screenSize: { phone.captureSize }, heldDragProfile: .notConfigured,
+                displayMappingProvider: { try phone.mapping() }, sleep: { _ in }, reportSender: phone.send)
+            for (x, y) in [(0.144, 28.0 / 462), (0.23, 0.71), (0.86, 0.31)] {
+                try input.tap(x: x, y: y)
+                let pressed = try XCTUnwrap(phone.presses.last)
+                XCTAssertEqual(pressed.x, x, accuracy: 1.0 / 32767)
+                XCTAssertEqual(pressed.y, y, accuracy: 1.0 / 32767)
+                XCTAssertEqual(phone.reports.last?.1, [0, 0, 0, 0])
+            }
+        }
+    }
+
+    func testMappingChangeRefreshesAndPrimesEvenWhenRawTargetRepeats() throws {
+        let phone = RotatingAbsoluteHost()
+        var queries = 0
+        let input = DeviceInput(
+            host: UUID(), session: UUID(), screenSize: { phone.captureSize }, heldDragProfile: .notConfigured,
+            displayMappingProvider: { queries += 1; return try phone.mapping() },
+            sleep: { _ in }, reportSender: phone.send)
+        try input.move(x: 0.21, y: 0.63)
+        let oldRawTarget = phone.reports.last?.1
+        let before = phone.reports.count
+        phone.rotation = 270
+        try input.move(x: 0.63, y: 0.79)
+        let fresh = Array(phone.reports.dropFirst(before))
+        XCTAssertEqual(queries, 2)
+        XCTAssertEqual(fresh.map { $0.0 }, [.absolutePointer, .relativeMouse, .absolutePointer])
+        XCTAssertNotEqual(fresh.first?.1, oldRawTarget)
+        XCTAssertEqual(fresh.last?.1, oldRawTarget)
+        XCTAssertEqual(phone.point.x, 0.63, accuracy: 1.0 / 32767)
+        XCTAssertEqual(phone.point.y, 0.79, accuracy: 1.0 / 32767)
+        let next = phone.reports.count
+        try input.move(x: 0.4, y: 0.7)
+        XCTAssertEqual(queries, 3)
+        XCTAssertEqual(phone.reports.count - next, 1, "unchanged mapping does not prime every gesture")
+    }
+
+    func testUnavailableOrientationSendsNoInputAndRecoveryPrimesAgain() throws {
+        let phone = RotatingAbsoluteHost()
+        var unavailable = true
+        let input = DeviceInput(
+            host: UUID(), session: UUID(), screenSize: { phone.captureSize }, heldDragProfile: .notConfigured,
+            displayMappingProvider: {
+                if unavailable { throw DeviceError("display unavailable") }
+                return try phone.mapping()
+            }, sleep: { _ in }, reportSender: phone.send)
+        XCTAssertThrowsError(try input.tap(x: 0.2, y: 0.7))
+        XCTAssertTrue(phone.reports.isEmpty)
+        unavailable = false
+        try input.move(x: 0.2, y: 0.7)
+        let before = phone.reports.count
+        unavailable = true
+        XCTAssertThrowsError(try input.tap(x: 0.8, y: 0.3))
+        XCTAssertEqual(phone.reports.count, before)
+        unavailable = false
+        try input.move(x: 0.2, y: 0.7)
+        XCTAssertEqual(phone.reports.count - before, 3)
+        XCTAssertTrue(phone.presses.isEmpty)
+    }
+
+    func testCaptureMismatchAndAssociationLossDuringReadRejectBeforeInput() throws {
+        for invalidateAssociation in [false, true] {
+            let phone = RotatingAbsoluteHost()
+            var allowed = true
+            let input = DeviceInput(
+                host: UUID(), session: UUID(), screenSize: { phone.captureSize }, heldDragProfile: .notConfigured,
+                displayMappingProvider: {
+                    if invalidateAssociation { allowed = false }
+                    return try DeviceDisplayMapping(
+                        rotationDegrees: invalidateAssociation ? 0 : 270, nativeWidth: 1179, nativeHeight: 2556)
+                }, inputIsAllowed: { allowed }, sleep: { _ in }, reportSender: phone.send)
+            XCTAssertThrowsError(try input.tap(x: 0.2, y: 0.7))
+            XCTAssertTrue(phone.reports.isEmpty)
+        }
+    }
+
+    func testRotatedHeldMotionIsRefusedButAbsoluteTapRemainsAvailable() throws {
+        let phone = RotatingAbsoluteHost()
+        phone.rotation = 270
+        let input = DeviceInput(
+            host: UUID(), session: UUID(), screenSize: { phone.captureSize }, heldDragProfile: .notConfigured,
+            displayMappingProvider: { try phone.mapping() }, sleep: { _ in }, reportSender: phone.send)
+        XCTAssertThrowsError(try input.swipe(points: [(0.2, 0.3), (0.7, 0.8)], duration: 0.1))
+        XCTAssertTrue(phone.reports.isEmpty)
+        try input.tap(x: 0.2, y: 0.3)
+        XCTAssertEqual(phone.presses.count, 1)
+        XCTAssertEqual(phone.point.x, 0.2, accuracy: 1.0 / 32767)
+        XCTAssertEqual(phone.point.y, 0.3, accuracy: 1.0 / 32767)
+    }
+
+    func testConfiguredDragCancellationOnlyReleasesWithoutQueryOrAbsoluteReplay() throws {
+        let phone = RotatingAbsoluteHost()
+        var queries = 0
+        let input = DeviceInput(
+            host: UUID(), session: UUID(), screenSize: { phone.captureSize }, heldDragProfile: .notConfigured,
+            displayMappingProvider: { queries += 1; return try phone.mapping() },
+            sleep: { _ in }, reportSender: phone.send)
+        input.press(x: 0.2, y: 0.3)
+        try input.type("")
+        input.drag(x: 0.21, y: 0.31)
+        try input.type("")
+        let before = phone.reports.count
+        let reads = queries
+        XCTAssertEqual(reads, 1, "split drag continues the mapping observed before its press")
+        phone.rotation = 270
+        input.cancelPointer()
+        try input.type("")
+        let released = Array(phone.reports.dropFirst(before))
+        XCTAssertEqual(queries, reads)
+        XCTAssertEqual(released.map { $0.0 }, [.relativeMouse])
+        XCTAssertEqual(released.first?.1, [0, 0, 0, 0])
+        XCTAssertTrue(phone.reports.filter { $0.0 == .absolutePointer }.allSatisfy { $0.1[0] == 0 })
+    }
+
+    func testChangedCaptureDuringSplitReleaseOnlyReleasesAcceptedTouch() throws {
+        let phone = RotatingAbsoluteHost()
+        var queries = 0
+        let input = DeviceInput(
+            host: UUID(), session: UUID(), screenSize: { phone.captureSize }, heldDragProfile: .notConfigured,
+            displayMappingProvider: {
+                queries += 1
+                return try phone.mapping()
+            }, sleep: { _ in }, reportSender: phone.send)
+        input.press(x: 0.2, y: 0.3)
+        try input.type("")
+        XCTAssertEqual(phone.presses.count, 1)
+        let before = phone.reports.count
+        phone.rotation = 270
+        input.release(x: 0.8, y: 0.7)
+        try input.type("")
+        let released = Array(phone.reports.dropFirst(before))
+        XCTAssertEqual(released.map { $0.0 }, [.relativeMouse])
+        XCTAssertEqual(released.first?.1, [0, 0, 0, 0])
+        XCTAssertEqual(queries, 1)
+        try input.tap(x: 0.4, y: 0.6)
+        XCTAssertEqual(phone.presses.count, 2, "interrupted touch is not replayed")
+    }
+
+    func testReleaseDoesNotWaitForANewUSBReadAndNextGestureReadsAgain() throws {
+        let phone = RotatingAbsoluteHost()
+        var queries = 0
+        let input = DeviceInput(
+            host: UUID(), session: UUID(), screenSize: { phone.captureSize }, heldDragProfile: .notConfigured,
+            displayMappingProvider: {
+                queries += 1
+                if queries > 1 { throw DeviceError("display unavailable") }
+                return try phone.mapping()
+            }, sleep: { _ in }, reportSender: phone.send)
+        input.press(x: 0.2, y: 0.3)
+        try input.type("")
+        let before = phone.reports.count
+        input.release(x: 0.2, y: 0.3)
+        try input.type("")
+        XCTAssertEqual(queries, 1)
+        XCTAssertEqual(phone.reports.count - before, 1)
+        XCTAssertEqual(phone.reports.last?.1, [0, 0, 0, 0])
+        let released = phone.reports.count
+        XCTAssertThrowsError(try input.tap(x: 0.4, y: 0.6))
+        XCTAssertEqual(queries, 2)
+        XCTAssertEqual(phone.reports.count, released)
+    }
+
+    func testCancelDuringPrePressDisplayReadOrPositioningSuppressesTheUnsentPress() throws {
+        for cancelDuringRead in [true, false] {
+            let phone = RotatingAbsoluteHost()
+            let waiting = DispatchSemaphore(value: 0)
+            let resume = DispatchSemaphore(value: 0)
+            let input = DeviceInput(
+                host: UUID(), session: UUID(), screenSize: { phone.captureSize }, heldDragProfile: .notConfigured,
+                displayMappingProvider: {
+                    if cancelDuringRead {
+                        waiting.signal()
+                        guard resume.wait(timeout: .now() + 2) == .success else {
+                            throw DeviceError("test display read was not released")
+                        }
+                    }
+                    return try phone.mapping()
+                }, sleep: { seconds in
+                    if !cancelDuringRead, seconds == 0.06 {
+                        waiting.signal()
+                        XCTAssertTrue(resume.wait(timeout: .now() + 2) == .success)
+                    }
+                }, reportSender: phone.send)
+            input.press(x: 0.2, y: 0.3)
+            XCTAssertTrue(waiting.wait(timeout: .now() + 2) == .success)
+            input.cancelPointer()
+            resume.signal()
+            try input.type("")
+            XCTAssertTrue(phone.presses.isEmpty, "cancellation must suppress a later button-down")
+            if cancelDuringRead {
+                XCTAssertTrue(phone.reports.isEmpty, "cancelled read must not be followed by a late absolute move")
+            }
+        }
+    }
+
+    func testOrdinaryReleaseQueuedDuringDisplayReadDoesNotCancelItsOwnPress() throws {
+        let phone = RotatingAbsoluteHost()
+        let waiting = DispatchSemaphore(value: 0)
+        let resume = DispatchSemaphore(value: 0)
+        var queries = 0
+        let input = DeviceInput(
+            host: UUID(), session: UUID(), screenSize: { phone.captureSize }, heldDragProfile: .notConfigured,
+            displayMappingProvider: {
+                queries += 1
+                waiting.signal()
+                guard resume.wait(timeout: .now() + 2) == .success else {
+                    throw DeviceError("test display read was not released")
+                }
+                return try phone.mapping()
+            }, sleep: { _ in }, reportSender: phone.send)
+        input.press(x: 0.2, y: 0.3)
+        XCTAssertTrue(waiting.wait(timeout: .now() + 2) == .success)
+        input.release(x: 0.2, y: 0.3)
+        resume.signal()
+        try input.type("")
+        XCTAssertEqual(queries, 1)
+        XCTAssertEqual(phone.presses.count, 1)
+        XCTAssertEqual(phone.reports.last?.1, [0, 0, 0, 0])
+    }
+
+    func testNoProviderKeepsPortraitReportCoordinates() throws {
+        let phone = RotatingAbsoluteHost()
+        let input = DeviceInput(host: UUID(), session: UUID(), sleep: { _ in }, reportSender: phone.send)
+        try input.tap(x: 0.144, y: 0.061)
+        XCTAssertEqual(phone.presses.last?.x ?? -1, 0.144, accuracy: 1.0 / 32767)
+        XCTAssertEqual(phone.presses.last?.y ?? -1, 0.061, accuracy: 1.0 / 32767)
+    }
+}
