+    /// Inverse rotation for a relative vector. Unlike hidPoint, a displacement
+    /// has no origin translation. Counts keep their measured magnitudes.
+    func hidVector(dx: Int, dy: Int) -> (dx: Int, dy: Int) {
+        switch rotationDegrees {
+        case 90: (dy, -dx)
+        case 180: (-dx, -dy)
+        case 270: (-dy, dx)
+        default: (dx, dy)
+        }
+    }
