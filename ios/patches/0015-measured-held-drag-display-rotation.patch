+    /// Preserve the actual capture raster for exact measured-profile binding.
+    /// The observed quarter-turn chooses the axes; no aspect inference, scaling
+    /// or replacement of 1180 capture pixels with 1179 native pixels occurs.
+    func nativeCaptureSize(captureSize: CGSize?) throws -> CGSize {
