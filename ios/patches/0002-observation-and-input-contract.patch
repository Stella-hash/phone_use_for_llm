+def capture_uptime():
+    # Match Foundation's systemUptime. Python's monotonic origin is not required
+    # to match the app's clock (and some execution hosts offset it per process).
+    class Timebase(ctypes.Structure):
+        _fields_ = [("numer", ctypes.c_uint32), ("denom", ctypes.c_uint32)]
+
+    library = ctypes.CDLL(None)
+    library.mach_absolute_time.restype = ctypes.c_uint64
+    timebase = Timebase()
+    library.mach_timebase_info(ctypes.byref(timebase))
+    return library.mach_absolute_time() * timebase.numer / timebase.denom / 1_000_000_000
+
+
+def capture_reply(gray, sequence, received_at, source="capture-1"):
+    """Real decoded pixels plus metadata, without a platform image dependency."""
+    def chunk(kind, value):
+        return struct.pack(">I", len(value)) + kind + value + struct.pack(">I", zlib.crc32(kind + value))
+
+    pixels = (b"\0" + bytes([gray]) * 16) * 16
+    image = (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", 16, 16, 8, 0, 0, 0, 0))
+             + chunk(b"IDAT", zlib.compress(pixels)) + chunk(b"IEND", b""))
+    ocr = {"device": "phone-1", "width": 16, "height": 16, "screenHash": str(gray), "items": []}
+    return 200, image, {
+        "Content-Type": "image/png", "X-Device": "phone-1", "X-Image-Width": "16", "X-Image-Height": "16",
+        "X-Frame-Source": source, "X-Frame-Sequence": str(sequence), "X-Frame-Received-At": str(received_at),
+        "X-Screen-OCR": base64.b64encode(json.dumps(ocr).encode()).decode(),
+    }
+
