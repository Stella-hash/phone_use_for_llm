@@ -0,0 +1,187 @@
+import Foundation
+import XCTest
+
+@testable import iPhoneUse
+
+final class MCPObservationTests: XCTestCase {
+    private func sample(
+        _ signature: String, sequence: UInt64, at: TimeInterval, source: String = "capture-1"
+    ) -> MCPServer.ObservationFrame {
+        MCPServer.ObservationFrame(
+            image: Data(signature.utf8), device: "phone-1", width: "500", height: "1000", mimeType: "image/png",
+            identity: MCPServer.FrameIdentity(source: source, sequence: sequence, receivedAt: at),
+            signature: signature)
+    }
+
+    func testDelayedTransitionCannotFinishOnTwoEqualOldFrames() {
+        var clock: TimeInterval = 10
+        var sequence: UInt64 = 1
+        let result = MCPServer.observeAfterAction(
+            baseline: sample("old", sequence: sequence, at: 9.9), acknowledgedAt: 10, timeout: 1.5,
+            sleep: { clock += $0 }, now: { clock },
+            frame: { remaining in
+                XCTAssertGreaterThan(remaining, 0)
+                sequence += 1
+                return self.sample(clock < 10.55 ? "old" : "new", sequence: sequence, at: clock)
+            })
+        XCTAssertEqual(result.status, .changed)
+        XCTAssertGreaterThanOrEqual(result.elapsed, 0.8)
+        XCTAssertLessThan(result.elapsed, 1.5)
+        XCTAssertTrue(result.fresh)
+        XCTAssertTrue(result.stable)
+        XCTAssertEqual(result.changed, true)
+        XCTAssertEqual(result.frame?.image, Data("new".utf8))
+    }
+
+    func testFrozenBaselineIsUnobservedEvenIfPixelsKeepMatching() {
+        var clock: TimeInterval = 10
+        let baseline = sample("old", sequence: 1, at: 9.9)
+        let result = MCPServer.observeAfterAction(
+            baseline: baseline, acknowledgedAt: 10, timeout: 1.5,
+            sleep: { clock += $0 }, now: { clock }, frame: { _ in baseline })
+        XCTAssertEqual(result.status, .unobserved)
+        XCTAssertEqual(result.reason, "no_fresh_frame")
+        XCTAssertFalse(result.fresh)
+        XCTAssertFalse(result.stable)
+        XCTAssertNil(result.changed)
+        XCTAssertEqual(result.elapsed, 1.5, accuracy: 0.00001)
+    }
+
+    func testFreshUnchangedOutputUsesEntireWindowAndDoesNotClaimAppCompletion() throws {
+        var clock: TimeInterval = 10
+        var sequence: UInt64 = 1
+        let result = MCPServer.observeAfterAction(
+            baseline: sample("same", sequence: sequence, at: 9.9), acknowledgedAt: 10, timeout: 1.5,
+            sleep: { clock += $0 }, now: { clock },
+            frame: { _ in
+                sequence += 1
+                return self.sample("same", sequence: sequence, at: clock)
+            })
+        XCTAssertEqual(result.status, .stable)
+        XCTAssertTrue(result.fresh)
+        XCTAssertTrue(result.stable)
+        XCTAssertEqual(result.changed, false)
+        XCTAssertEqual(result.elapsed, 1.5, accuracy: 0.00001)
+        let content = MCPServer.observationContent(result, includeImage: true, diff: false)
+        let metadata = try XCTUnwrap(content["structuredContent"] as? [String: Any])
+        XCTAssertEqual(metadata["action_acknowledged"] as? Bool, true)
+        XCTAssertEqual(metadata["hid_delivery"] as? String, "unverified")
+        XCTAssertEqual(metadata["app_completion"] as? String, "unverified")
+        let blocks = try XCTUnwrap(content["content"] as? [[String: Any]])
+        XCTAssertEqual(blocks.first?["data"] as? String, result.frame?.image.base64EncodedString())
+        XCTAssertTrue(try XCTUnwrap(blocks.last?["text"] as? String).contains("\"status\":\"stable\""))
+    }
+
+    func testRepeatedSingleFreshFrameCannotEstablishStability() {
+        var clock: TimeInterval = 10
+        let fresh = sample("new", sequence: 2, at: 10.1)
+        let result = MCPServer.observeAfterAction(
+            baseline: sample("old", sequence: 1, at: 9.9), acknowledgedAt: 10, timeout: 1.5,
+            sleep: { clock += $0 }, now: { clock }, frame: { _ in fresh })
+        XCTAssertEqual(result.status, .timeout)
+        XCTAssertTrue(result.fresh)
+        XCTAssertEqual(result.changed, true)
+        XCTAssertFalse(result.stable)
+    }
+
+    func testContinuousAnimationTimesOutWithLatestObservedImage() {
+        var clock: TimeInterval = 10
+        var sequence: UInt64 = 1
+        let result = MCPServer.observeAfterAction(
+            baseline: sample("old", sequence: sequence, at: 9.9), acknowledgedAt: 10, timeout: 0.5,
+            sleep: { clock += $0 }, now: { clock },
+            frame: { _ in
+                sequence += 1
+                return self.sample("frame-\(sequence)", sequence: sequence, at: clock)
+            })
+        XCTAssertEqual(result.status, .timeout)
+        XCTAssertTrue(result.fresh)
+        XCTAssertFalse(result.stable)
+        XCTAssertEqual(result.frame?.image, Data("frame-\(sequence)".utf8))
+        XCTAssertEqual(result.elapsed, 0.5, accuracy: 0.00001)
+    }
+
+    func testMissingFramesRemainExplicitAndNoOpSleepStillTerminates() {
+        var delays: [TimeInterval] = []
+        let result = MCPServer.observeAfterAction(
+            baseline: nil, acknowledgedAt: 10, timeout: 1.5,
+            sleep: { delays.append($0) }, now: { 10 }, frame: { _ in nil })
+        XCTAssertEqual(result.status, .unobserved)
+        XCTAssertEqual(result.reason, "no_frame")
+        XCTAssertNil(result.frame)
+        XCTAssertEqual(delays.reduce(0, +), 1.5, accuracy: 0.00001)
+    }
+
+    func testMissingMetadataDoesNotPretendAnOldServerProvedFreshness() {
+        var legacy = sample("new", sequence: 2, at: 10.1)
+        legacy = MCPServer.ObservationFrame(
+            image: legacy.image, device: legacy.device, width: legacy.width, height: legacy.height,
+            mimeType: legacy.mimeType, identity: nil, signature: legacy.signature)
+        let result = MCPServer.observeAfterAction(
+            baseline: nil, acknowledgedAt: 10, timeout: 1.5,
+            sleep: { _ in }, now: { 10 }, frame: { _ in legacy })
+        XCTAssertEqual(result.status, .unobserved)
+        XCTAssertEqual(result.reason, "missing_frame_metadata")
+        XCTAssertFalse(result.fresh)
+        XCTAssertEqual(result.frame?.image, legacy.image)
+    }
+
+    func testMissingBaselineLeavesChangeUnknownDespiteFreshStableFrames() {
+        var clock: TimeInterval = 10
+        var sequence: UInt64 = 0
+        let result = MCPServer.observeAfterAction(
+            baseline: nil, acknowledgedAt: 10, timeout: 0.8,
+            sleep: { clock += $0 }, now: { clock },
+            frame: { _ in
+                sequence += 1
+                return self.sample("same", sequence: sequence, at: clock)
+            })
+        XCTAssertEqual(result.status, .stable)
+        XCTAssertNil(result.changed)
+        XCTAssertEqual(result.elapsed, 0.8, accuracy: 0.00001)
+    }
+
+    func testCaptureRestartAcceptsResetSequenceOnlyWithNewerTimestamp() {
+        var clock: TimeInterval = 10
+        var sequence: UInt64 = 0
+        let result = MCPServer.observeAfterAction(
+            baseline: sample("old", sequence: 1000, at: 9.9), acknowledgedAt: 10, timeout: 1.5,
+            sleep: { clock += $0 }, now: { clock },
+            frame: { _ in
+                sequence += 1
+                return self.sample("new", sequence: sequence, at: clock, source: "capture-2")
+            })
+        XCTAssertEqual(result.status, .changed)
+        XCTAssertEqual(result.frame?.identity?.source, "capture-2")
+        XCTAssertLessThan(result.frame?.identity?.sequence ?? 1000, 1000)
+        XCTAssertFalse(
+            MCPServer.FrameIdentity(source: "capture-2", sequence: 1, receivedAt: 9.8)
+                .isNewer(than: sample("old", sequence: 1000, at: 9.9).identity))
+    }
+
+    func testAFrameBeforeAcknowledgementCannotConfirmTheFinalAction() {
+        let result = MCPServer.observeAfterAction(
+            baseline: sample("old", sequence: 1, at: 8), acknowledgedAt: 10, timeout: 0.5,
+            sleep: { _ in }, now: { 10 }, frame: { _ in self.sample("new", sequence: 2, at: 9) })
+        XCTAssertEqual(result.status, .unobserved)
+        XCTAssertFalse(result.fresh)
+    }
+
+    func testTimeoutAndFrameMetadataRejectInvalidFiniteValues() throws {
+        for raw: Any in [true, "1", 0, 0.1, 5.01, Double.nan, Double.infinity, -Double.infinity] {
+            XCTAssertThrowsError(try MCPServer.observationTimeout(raw))
+        }
+        XCTAssertEqual(try MCPServer.observationTimeout(nil), 1.5)
+        XCTAssertEqual(try MCPServer.observationTimeout(0.2), 0.2)
+        XCTAssertEqual(try MCPServer.observationTimeout(5), 5)
+        for timestamp in ["nan", "inf", "-1", "missing"] {
+            let response = try XCTUnwrap(
+                HTTPURLResponse(
+                    url: URL(string: "http://127.0.0.1/screenshot")!, statusCode: 200, httpVersion: nil,
+                    headerFields: [
+                        "X-Frame-Source": "capture", "X-Frame-Sequence": "1", "X-Frame-Received-At": timestamp,
+                    ]))
+            XCTAssertNil(MCPServer.FrameIdentity.parse(response))
+        }
+    }
+}
